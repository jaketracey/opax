# Workers static-assets headers. Natively supported by Workers Assets (same
# format as Pages): parsed by the platform, never served as a file.
#
# This file governs ONLY responses the asset server produces. /api/* and
# anything the Worker returns get the same set from withSecurityHeaders() in
# src/index.ts — keep the two in step. Rationale: docs/HARDENING.md.

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(self), geolocation=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://tile.openstreetmap.org https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; font-src 'self'; connect-src 'self' wss://opax.com.au wss://staging.opax.com.au https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com; worker-src 'self'; manifest-src 'self'; frame-src https://www.googletagmanager.com; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'

# --- caching -----------------------------------------------------------------
# A request matching several rules inherits ALL their headers, and same-name
# values are JOINED. So the generic rules come first and a specific rule
# detaches with "! Cache-Control" before setting its own. Patterns allow one
# splat each, and a splat matches "/" too (/*.json covers /graph/money.json).
#
# The shell always revalidates; its ETag makes that a 304.
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Modules loaded by a bare or hand-versioned path: short TTL, then a day of
# stale-while-revalidate. A module every reference to which carries its content
# hash is listed immutable in the generated block at the end of this file.
/*.js
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

# Published JSON revalidates on every use. (/photos is scoped to
# .webp so /photos/people.json is left to the /*.json rule and not double-set.)
/*.json
  Cache-Control: public, max-age=0, must-revalidate
# The files that say who is who: whose face (the portrait map), which person id and
# seat (the roster), and the name indexes of the pay, votes, expenses and interests
# records. A correction must reach a returning reader on the next page view, not after
# a day of stale grace: ETag revalidation. The site's own loaders also fetch them with
# cache: "no-cache", because a copy cached under the old headers ignores these.
/photos/people.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/parliamentarians.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/pay.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/votes.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/expenses.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/interests/index.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
# Bill dates and progress should reflect each publication for returning readers.
/bills/*.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
# Donor-bearing report data revalidates on every use after a publication.
/reports/*.json
  ! Cache-Control
  Cache-Control: public, max-age=0, must-revalidate
/photos/*.webp
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
# JPEG twins of the portraits, read by the Worker to draw share images
# (satori cannot decode WebP). Written by `node og/build.mjs portraits`.
/photos/jpg/*.jpg
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400

/favicon.svg
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Self-hosted faces. Names are stable, so not "immutable": a month, with a
# year of stale grace, still means one fetch per visitor per month.
/fonts/*
  Cache-Control: public, max-age=2592000, stale-while-revalidate=31536000

# index.html references /app.js?v=<hash> and /style.css?v=<hash>, stamped by
# scripts/stamp_assets.mjs on every `npm run deploy`. A new release is a new
# URL, so these two can be immutable. NEVER `wrangler deploy` by hand — an
# unstamped deploy leaves returning visitors on the cached old bundle.
/app.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/style.css
  Cache-Control: public, max-age=31536000, immutable
/ui-controls.css
  Cache-Control: public, max-age=31536000, immutable
/ui-source.css
  Cache-Control: public, max-age=31536000, immutable
/ui-source.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable
/page-actions.css
  Cache-Control: public, max-age=31536000, immutable
/ui-workbench
  Cache-Control: public, max-age=0, must-revalidate
/ui-workbench.html
  Cache-Control: public, max-age=0, must-revalidate

# Shared three.js chunk written by graph/build.mjs: its name carries a content
# hash and the modules that import it are rebuilt with it, so it can be immutable.
/chunks/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# A release is immutable; the small manifest selects the current release.
/electorates/manifest.json
  ! Cache-Control
  Cache-Control: public, max-age=300, must-revalidate
/electorates/releases/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# Reviewed participant snapshot is frozen; a replacement needs a new namespace.
/mixed-speakers/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/community
  Cache-Control: public, max-age=0, must-revalidate
  ! Referrer-Policy
  Referrer-Policy: no-referrer
/community.html
  Cache-Control: public, max-age=0, must-revalidate
  ! Referrer-Policy
  Referrer-Policy: no-referrer

# /voice.js is import()ed by bare path from app.js the first time the chat's
# mic button is used, so it carries no stamp and keeps the generic /*.js policy.
/voice.css
  Cache-Control: public, max-age=31536000, immutable
/nav.css
  Cache-Control: public, max-age=31536000, immutable
/voice-assets/*
  ! Cache-Control
  Cache-Control: public, max-age=300, must-revalidate

/home.css
  Cache-Control: public, max-age=31536000, immutable

/home
  Cache-Control: public, max-age=0, must-revalidate
/home.html
  Cache-Control: public, max-age=0, must-revalidate
/home.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

/quick-search.js
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

