irk","vote":"no"},{"name":"Lyn Allison","party":"Australian Democrats","person_id":"tvfy_10009","person_slug":"lyn-allison","vote":"aye"},{"name":"Marise Payne","party":"Liberal","person_id":"tvfy_10509","person_slug":"marise-payne","vote":"no"},{"name":"Mark Bishop","party":"Labor","person_id":"tvfy_10048","person_slug":"mark-bishop","vote":"no"},{"name":"Mary Fisher","party":"Liberal","person_id":"tvfy_10227","person_slug":"mary-fisher","vote":"no"},{"name":"Mathias Cormann","party":"Liberal","person_id":"tvfy_10148","person_slug":"mathias-cormann","vote":"no"},{"name":"Michael Forshaw","party":"Labor","person_id":"tvfy_10235","person_slug":"michael-forshaw","vote":"no"},{"name":"Michael Ronaldson","party":"Liberal","person_id":"tvfy_10550","person_slug":"michael-ronaldson","vote":"no"},{"name":"Mitch Fifield","party":"Liberal","person_id":"tvfy_10224","person_slug":"mitch-fifield","vote":"no"},{"name":"Rachel Siewert","party":"Greens","person_id":"tvfy_10584","person_slug":"rachel-siewert","vote":"aye"},{"name":"Richard Colbeck","party":"Liberal","person_id":"tvfy_10131","person_slug":"richard-colbeck","vote":"no"},{"name":"Ron Boswell","party":"Nationals","person_id":"tvfy_10057","person_slug":"ron-boswell","vote":"no"},{"name":"Ruth Webber","party":"Labor","person_id":"tvfy_10662","person_slug":"ruth-webber","vote":"no"},{"name":"Sandy Macdonald","party":"Nationals","person_id":"tvfy_10402","person_slug":"sandy-macdonald","vote":"no"},{"name":"Stephen Parry","party":"PRES","person_id":"tvfy_10507","person_slug":"stephen-parry","vote":"no"},{"name":"Steve Fielding","party":"Family First","person_id":"tvfy_10221","person_slug":"steve-fielding","vote":"no"},{"name":"Steve Hutchins","party":"Labor","person_id":"tvfy_10323","person_slug":"steve-hutchins","vote":"no"},{"name":"Sue Boyce","party":"Liberal","person_id":"tvfy_10062","person_slug":"sue-boyce","vote":"no"},{"name":"Trish Crossin","party":"Labor","person_id":"tvfy_10161","person_slug":"trish-crossin","vote":"no"},{"name":"Ursula Stephens","party":"Labor","person_id":"tvfy_10609","person_slug":"ursula-stephens","vote":"no"}],"name":"Palestine","noes":47,"question":"Kerry Nettle I move: That the Senate— (a) acknowledges and sympathises with the Palestinian families whose homes were destroyed or seized, and family members killed or injured, 60 years ago at the inception of the State of Israel which the Palestinians call ‘Al Nakba’, the catastrophe; (b) remembers with shame the failure of the international community to prevent the bloody events that followed the unilateral declaration of independent statehood by the Israeli leaders and the many millions of victims who continue to suffer to this day; (c) acknowledges the unique relationship which exists between Australia and Palestine, a bond highlighted by our commitment to the rights and liberties of our citizens and encouragement of cultural diversity; (d) commends the Palestinian authority’s commitment to democracy, the rule of law and pluralism; (e) reiterates Australia’s commitment to: (i) Palestine’s right to exist and our on-going support to the peaceful establishment of a two-state solution to the Israeli-Palestinian issue, and (ii) the pursuit of peace and stability throughout the Middle East; and (f) on this, the 60th anniversary of Al Nakba, pledges our friendship, commitment and enduring support to the people of Palestine as we remember this dark chapter in history together. Question put.","result":"negative","slug":"division-federal-senate-1465","source_url":"https://theyvoteforyou.org.au/divisions/senate/2008-05-15/2"}
