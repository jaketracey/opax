y_10846","person_slug":"patrick-dodson","vote":"aye"},{"name":"Pauline Hanson","party":"One Nation","person_id":"tvfy_10280","person_slug":"pauline-hanson","vote":"no"},{"name":"Penny Wong","party":"Labor","person_id":"tvfy_10678","person_slug":"penny-wong","vote":"aye"},{"name":"Peter Whish-Wilson","party":"Greens","person_id":"tvfy_10780","person_slug":"peter-whish-wilson","vote":"aye"},{"name":"Rachel Siewert","party":"Greens","person_id":"tvfy_10584","person_slug":"rachel-siewert","vote":"aye"},{"name":"Richard Di Natale","party":"Greens","person_id":"tvfy_10755","person_slug":"richard-di-natale","vote":"aye"},{"name":"Rod Culleton","party":"One Nation","person_id":"tvfy_10850","person_slug":"rod-culleton","vote":"no"},{"name":"Sam Dastyari","party":"Labor","person_id":"tvfy_10819","person_slug":"sam-dastyari","vote":"aye"},{"name":"Sarah Hanson-Young","party":"Greens","person_id":"tvfy_10711","person_slug":"sarah-hanson-young","vote":"aye"},{"name":"Scott Ryan","party":"PRES","person_id":"tvfy_10715","person_slug":"scott-ryan","vote":"no"},{"name":"Simon Birmingham","party":"Liberal","person_id":"tvfy_10044","person_slug":"simon-birmingham","vote":"no"},{"name":"Skye Kakoschke-Moore","party":"Centre Alliance","person_id":"tvfy_10854","person_slug":"skye-kakoschke-moore","vote":"aye"},{"name":"Stephen Parry","party":"PRES","person_id":"tvfy_10507","person_slug":"stephen-parry","vote":"no"},{"name":"Stirling Griff","party":"Centre Alliance","person_id":"tvfy_10851","person_slug":"stirling-griff","vote":"aye"},{"name":"Sue Lines","party":"PRES","person_id":"tvfy_10782","person_slug":"sue-lines","vote":"aye"}],"name":"Documents - Day, Mr Bob, AO - Order for the Production of Documents","noes":30,"question":"The majority voted in favour of [motion](http://www.openaustralia.org.au/senate/?id=2016-11-09.194.2) that asked for certain documents be given to the Senate. The motion was introduced by Tasmanian Labor Senator [Anne Urquhart](https://theyvoteforyou.org.au/people/senate/tasmania/anne_urquhart). This type of motion is known as an [Order for the Production of Documents](http://www.aph.gov.au/About_Parliament/Senate/Powers_practice_n_procedures/Brief_Guides_to_Senate_Procedure/No_12) and is - > *one of the most significant powers available to a legislature to enable it to carry out its functions of scrutinising legislation and the performance of the executive arm of government* Read more in this [brief guide](http://www.aph.gov.au/About_Parliament/Senate/Powers_practice_n_procedures/Brief_Guides_to_Senate_Procedure/No_12). ### Motion text > *That there be laid on the table by the Attorney-General, by no later than 9.30 am on Wednesday, 9 November 2016, the legal advice provided to the Government in relation to the eligibility of [former Senator Day](https://theyvoteforyou.org.au/people/senate/sa/bob_day) to be elected as a senator for South Australia, as referred to in the Senate on Monday, 7 November 2016 by the Special Minister of State ([Senator Ryan](https://theyvoteforyou.org.au/people/senate/victoria/scott_ryan)) and the Minister for Finance ([Senator Cormann](https://theyvoteforyou.org.au/people/senate/wa/mathias_cormann)), and provided by David Jackson QC, and any related documents that have not already been laid on the table.*","result":"affirmative","slug":"division-federal-senate-4396","source_url":"https://theyvoteforyou.org.au/divisions/senate/2016-11-09/2"}
