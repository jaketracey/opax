fy_10224","person_slug":"mitch-fifield","vote":"no"},{"name":"Murray Watt","party":"Labor","person_id":"tvfy_10857","person_slug":"murray-watt","vote":"aye"},{"name":"Nick McKim","party":"Greens","person_id":"tvfy_10841","person_slug":"nick-mckim","vote":"aye"},{"name":"Nigel Scullion","party":"Country Liberal Party","person_id":"tvfy_10569","person_slug":"nigel-scullion","vote":"no"},{"name":"Patrick Dodson","party":"Labor","person_id":"tvfy_10846","person_slug":"patrick-dodson","vote":"aye"},{"name":"Pauline Hanson","party":"One Nation","person_id":"tvfy_10280","person_slug":"pauline-hanson","vote":"no"},{"name":"Peter Georgiou","party":"One Nation","person_id":"tvfy_10898","person_slug":"peter-georgiou","vote":"no"},{"name":"Rachel Siewert","party":"Greens","person_id":"tvfy_10584","person_slug":"rachel-siewert","vote":"aye"},{"name":"Rex Patrick","party":"Independent","person_id":"tvfy_10903","person_slug":"rex-patrick","vote":"aye"},{"name":"Richard Di Natale","party":"Greens","person_id":"tvfy_10755","person_slug":"richard-di-natale","vote":"aye"},{"name":"Sarah Hanson-Young","party":"Greens","person_id":"tvfy_10711","person_slug":"sarah-hanson-young","vote":"aye"},{"name":"Simon Birmingham","party":"Liberal","person_id":"tvfy_10044","person_slug":"simon-birmingham","vote":"no"},{"name":"Slade Brockman","party":"DPRES","person_id":"tvfy_10900","person_slug":"slade-brockman","vote":"no"},{"name":"Steve Martin","party":"Independent","person_id":"tvfy_10905","person_slug":"steve-martin","vote":"no"},{"name":"Stirling Griff","party":"Centre Alliance","person_id":"tvfy_10851","person_slug":"stirling-griff","vote":"aye"},{"name":"Sue Lines","party":"PRES","person_id":"tvfy_10782","person_slug":"sue-lines","vote":"aye"},{"name":"Tim Storer","party":"Independent","person_id":"tvfy_10909","person_slug":"tim-storer","vote":"aye"},{"name":"Zed Seselja","party":"Liberal","person_id":"tvfy_10822","person_slug":"zed-seselja","vote":"no"}],"name":"Migration Amendment (Skilling Australians Fund) Bill 2018, Migration (Skilling Australians Fund) Charges Bill 2017 - in Committee - Review","noes":32,"question":"The majority voted in favour of [amendments](https://www.openaustralia.org.au/senate/?gid=2018-05-08.9.1) introduced by South Australian Senator [Stirling Griff](https://theyvoteforyou.org.au/people/senate/sa/stirling_griff). This means they'll now be included in the bill. ### What do these amendments do? Senator Griff [explained that](https://www.openaustralia.org.au/senate/?gid=2018-05-08.9.1): > *we have proposed an amendment for a review of the legislation in 18 months, to look at any unintended consequences on employers paying the levy. Allowing the levy to operate for a year before reviewing its operation should provide better information through which to fine-tune the program.* ### Amendment text > *(1) Clause 2, page 2 (table item 1, column 1), omit \"3\", substitute \"4\".* > > *(2) Page 3 (after line 5), after clause 3, insert:* > >> *4 Review of operation of amendments* >> >> *(1) The Minister must cause an independent review of the operation of the amendments made by this Act.* >> >> *(2) The review must:* >> >>> *(a) start as soon as practicable after 18 months after Royal Assent; and* >>> >>> *(b) be completed within 6 months.* >> >> *(3) The Minister must cause a written report about the review to be prepared.* >> >> *(4) The Minister must cause a copy of the report to be tabled in each House of the Parliament within 15 sitting days of that House after the day on which the report is given to the Minister.* >> >> *(5) The report is not a legislative instrument.*","result":"affirmative","slug":"division-federal-senate-5194","source_url":"https://theyvoteforyou.org.au/divisions/senate/2018-05-08/1"}
