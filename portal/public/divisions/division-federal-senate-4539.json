y_10835","person_slug":"linda-reynolds","vote":"no"},{"name":"Lisa Singh","party":"Labor","person_id":"tvfy_10761","person_slug":"lisa-singh","vote":"no"},{"name":"Louise Pratt","party":"Labor","person_id":"tvfy_10714","person_slug":"louise-pratt","vote":"no"},{"name":"Malcolm Roberts","party":"One Nation","person_id":"tvfy_10856","person_slug":"malcolm-roberts","vote":"no"},{"name":"Marise Payne","party":"Liberal","person_id":"tvfy_10509","person_slug":"marise-payne","vote":"no"},{"name":"Michaelia Cash","party":"Liberal","person_id":"tvfy_10707","person_slug":"michaelia-cash","vote":"no"},{"name":"Murray Watt","party":"Labor","person_id":"tvfy_10857","person_slug":"murray-watt","vote":"no"},{"name":"Nick McKim","party":"Greens","person_id":"tvfy_10841","person_slug":"nick-mckim","vote":"aye"},{"name":"Nick Xenophon","party":"Centre Alliance","person_id":"tvfy_10717","person_slug":"nick-xenophon","vote":"aye"},{"name":"Patrick Dodson","party":"Labor","person_id":"tvfy_10846","person_slug":"patrick-dodson","vote":"no"},{"name":"Pauline Hanson","party":"One Nation","person_id":"tvfy_10280","person_slug":"pauline-hanson","vote":"no"},{"name":"Peter Whish-Wilson","party":"Greens","person_id":"tvfy_10780","person_slug":"peter-whish-wilson","vote":"aye"},{"name":"Rachel Siewert","party":"Greens","person_id":"tvfy_10584","person_slug":"rachel-siewert","vote":"aye"},{"name":"Richard Di Natale","party":"Greens","person_id":"tvfy_10755","person_slug":"richard-di-natale","vote":"aye"},{"name":"Sam Dastyari","party":"Labor","person_id":"tvfy_10819","person_slug":"sam-dastyari","vote":"no"},{"name":"Sarah Hanson-Young","party":"Greens","person_id":"tvfy_10711","person_slug":"sarah-hanson-young","vote":"aye"},{"name":"Scott Ludlam","party":"Greens","person_id":"tvfy_10713","person_slug":"scott-ludlam","vote":"aye"},{"name":"Skye Kakoschke-Moore","party":"Centre Alliance","person_id":"tvfy_10854","person_slug":"skye-kakoschke-moore","vote":"aye"},{"name":"Stirling Griff","party":"Centre Alliance","person_id":"tvfy_10851","person_slug":"stirling-griff","vote":"aye"},{"name":"Zed Seselja","party":"Liberal","person_id":"tvfy_10822","person_slug":"zed-seselja","vote":"no"}],"name":"Bills — Privacy Amendment (Notifiable Data Breaches) Bill 2016; Second Reading","noes":40,"question":"Penny Wong I rise to speak on the Privacy Amendment (Notifiable Data Breaches) Bill 2016on behalf of the opposition. The opposition will be supporting this legislation. We welcome this bill which has been much delayed in its introduction by this government. We support the bill because it is actually a Labor bill. It is nearly identical to a bill that passed the House with bipartisan support some four years ago, but which lapsed at the election in 2013. It has taken this government that long to re-introduce this bill. Really, it ought to have been one of the first things on the Attorney-General's agenda, but, as we know, he has been distracted with a few other things. Let me outline why this bill is important and why we thought fit to introduce it four years ago. As it stands, an individual's personal data can be breached by a government agency, a bank or an online store and there be no requirement that the individual be notified so that they can change their passwords or take other measures to protect themselves. A person might be told tomorrow that their data was hacked four years ago, and that organisation would face no consequences for its failure to notify them at the time. This is the situation that this government and this Attorney-General has let linger thanks to an inexplicable inertia on this important issue. Let us have a look, briefly, at the history. In 2013, Mr Dreyfus, the then Attorney-General, introduced the Privacy Amendment (Privacy Alerts) Bill. That bill, like this one, made it mandatory for regulated entities under the Privacy Act to alert consumers when their personal data had been breached, whether through accident or malice. The 2013 bill followed an extensive report by the Australian Law Reform Commission in 2008 which recommended that the Privacy Act be amended to provide as follows: An agency or organisation is required to notify the Privacy Commissioner and affected individuals when specified personal information has been, or is reasonabl","result":"negative","slug":"division-federal-senate-4539","source_url":"https://theyvoteforyou.org.au/divisions/senate/2017-02-13/3"}
