 "speeches": [
  {
   "slug": "speech-1197724",
   "speaker": "Pat Conaghan",
   "party": "Nationals",
   "state": "federal",
   "date": "2025-10-29",
   "stage_hint": null,
   "brief": "Argued that the Corporations (Review Fees) Amendment (Technical Amendments) Bill 2025 would retrospectively validate more than a decade of ASIC fees collected without a proper legal basis, and moved for Senate Economics Legislation Committee scrutiny before supporting the bill."
  },
  {
   "slug": "speech-1199162",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2025-11-27",
   "stage_hint": null,
   "brief": "Reported that the Corporations (Review Fees) Amendment (Technical Amendments) Bill 2025 had returned to the House for further consideration and would be considered later that day."
  },
  {
   "slug": "speech-1199429",
   "speaker": "Ed Husic",
   "party": "Labor",
   "state": "federal",
   "date": "2026-02-03",
   "stage_hint": null,
   "brief": "Argued that the Corporations (Review Fees) Amendment (Technical Amendments) Bill 2025 corrects an indexation error affecting ASIC fees collected between 1 July 2011 and 11 March 2025 without increasing charges, while criticising repeated bank misconduct and urging stronger accountability; the amendment was negatived and the bill was read a second time."
  },
  {
   "slug": "speech-1200911",
   "speaker": "Katy Gallagher",
   "party": "Labor",
   "state": "federal",
   "date": "2026-03-05",
   "stage_hint": null,
   "brief": "Moved that the Corporations (Review Fees) Amendment (Technical Amendments) Bill 2025 be considered from 12.15 pm, followed by government business until 1.30 pm and general business notice of motion no. 417; the question was agreed to."
  }
 ],
