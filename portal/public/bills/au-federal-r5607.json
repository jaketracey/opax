 "speeches": [
  {
   "slug": "speech-328523",
   "speaker": "Ian Macfarlane",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-02-23",
   "stage_hint": null,
   "brief": "The Offshore Petroleum and Greenhouse Gas Storage Amendment Bill 2016 corrects an administrative oversight where petroleum titles were renewed without the Minister for the Environment’s consent since 2008, retrospectively validating those decisions to maintain investor and community confidence."
  },
  {
   "slug": "speech-328524",
   "speaker": "Gary Gray",
   "party": "Labor",
   "state": "federal",
   "date": "2016-02-23",
   "stage_hint": null,
   "brief": "The Offshore Petroleum and Greenhouse Gas Storage Amendment Bill 2016 validates past joint authority decisions on petroleum title renewals and extensions that lacked the required written consent from the environment minister. The speaker apologised for the administrative oversight, which was known since 2011 but not addressed, and stated that no environmental or safety standards were compromised."
  },
  {
   "slug": "speech-328525",
   "speaker": "Keith Pitt",
   "party": "Nationals",
   "state": "federal",
   "date": "2016-02-23",
   "stage_hint": null,
   "brief": "The Offshore Petroleum and Greenhouse Gas Storage Amendment Bill 2016 validates petroleum title extensions and renewals made since 2008 without the Environment Minister's consent, as required under the EPBC Act, to eliminate legal risks for titleholders who acted in good faith."
  }
 ],
