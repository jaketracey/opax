 "speeches": [
  {
   "slug": "speech-272035",
   "speaker": "Wayne Swan",
   "party": "Labor",
   "state": "federal",
   "date": "2013-05-15",
   "stage_hint": null,
   "brief": "Moved the DisabilityCare Australia Fund Bill, proposing that increased Medicare levy revenue be paid into a dedicated fund managed by the Future Fund Board of Guardians and used to support DisabilityCare Australia and reimburse states and territories for eligible scheme costs."
  },
  {
   "slug": "speech-272259",
   "speaker": "David Bradbury",
   "party": "Labor",
   "state": "federal",
   "date": "2013-05-15",
   "stage_hint": null,
   "brief": "Summing up debate on the DisabilityCare Australia funding bills, confirmed the Medicare levy will rise from 1½ per cent to two per cent from 1 July 2014, with about $9.7 billion of the extra revenue allocated to states and territories over 10 years, and explained the Future Fund Board of Guardians will manage the new DisabilityCare Australia Fund covering 410,000 Australians with disability."
  },
