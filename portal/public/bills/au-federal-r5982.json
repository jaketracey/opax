 "divisions": [],
 "speeches": [
  {
   "slug": "speech-353910",
   "speaker": "Craig Laundy",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-09-13",
   "stage_hint": null,
   "brief": "The government introduced the Customs Amendment (Anti-Dumping Measures) Bill 2017 to close a loophole where foreign exporters could limit exports during duty reviews to obtain lower rates and resume dumping. The bill gives the Anti-Dumping Commission three specific methods to set export prices when exporters have made no or unrepresentative exports during a review period, protecting Australian manufacturers and jobs."
  },
  {
   "slug": "speech-354879",
   "speaker": "Shayne Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2017-10-17",
   "stage_hint": null,
   "brief": "The bill closes a loophole that allowed foreign exporters to avoid anti-dumping duties by temporarily reducing exports, then resuming injurious dumping. Labor supported the legislation, citing local manufacturers Capral Aluminium and G.James Glass & Aluminium as examples of businesses affected by dumping."
  }
 ],
