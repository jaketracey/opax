 "summary": {
  "version": 1,
  "basis": "em",
  "attribution": "Written by a model from the explanatory memorandum; not the record",
  "describes_version": "revised",
  "as_of": "2025-11-05",
  "sentences": [
   "The bill would create a scheme for using orphan works, whose copyright owners cannot be found, and clarify that copyright rules for educational instruction apply equally online.",
   "Users would need to conduct a reasonably diligent search, keep a record, and give notice; if the owner later appears, they could seek reasonable payment or negotiate terms.",
   "The bill would also simplify appointments for the Copyright Tribunal, update references to archives, and clarify Crown copyright duration."
  ],
  "changes": [
   "Introduces an Australian orphan works scheme that limits relief against users who meet search and notice conditions.",
   "Amends section 28 of the Copyright Act to confirm it covers online and hybrid educational instruction.",
   "Makes minor amendments to simplify Copyright Tribunal appointments, update archive references, and clarify Crown copyright duration."
  ],
  "affected": "Users of orphan works, including cultural and educational institutions, researchers, educators, students, and family historians, as well as copyright owners whose works may be orphaned.",
  "model": "deepseek/deepseek-v4-flash",
