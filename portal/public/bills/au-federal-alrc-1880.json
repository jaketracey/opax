   "brief": null
  },
  {
   "slug": "speech-803161",
   "speaker": "Jan McLucas",
   "party": "Labor",
   "state": "federal",
   "date": "2010-11-15",
   "stage_hint": null,
   "brief": "The speaker moved that the bills be taken together and allowed to proceed without formalities, and the motion was agreed to, resulting in the bills being read a first time."
  },
  {
   "slug": "speech-803162",
   "speaker": "Jan McLucas",
   "party": "Labor",
   "state": "federal",
   "date": "2010-11-15",
   "stage_hint": null,
   "brief": "The minister tabled the Australian Civilian Corps Bill 2010 to establish a register of up to 500 civilian specialists for deployment to countries affected by natural disasters or conflict, and the Australian National Preventive Health Agency Bill 2010 to create a statutory authority focused on preventive health, with $17.6 million allocated for establishment and additional funding for anti-obesity and anti-tobacco campaigns. The minister also introduced the Radiocommunications Amendment Bill 2010 to allow earlier reissue of spectrum licences and enable coexistence of class and spectrum licences, and the Social Security Legislation Amendment (Connecting People with Jobs) Bill 2010 to provide relocation assistance of up to $6,000 and a $2,500 employer wage subsidy for long-term unemployed job seekers, along with extended non-payment periods for those who leave jobs early."
  },
  {
   "slug": "speech-803248",
   "speaker": "Concetta Fierravanti-Wells",
   "party": "Liberal",
   "state": "federal",
   "date": "2010-11-16",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-803284",
   "speaker": "Sue Boyce",
   "party": "Liberal",
   "state": "federal",
   "date": "2010-11-16",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-803285",
   "speaker": "Judith Troeth",
   "party": "Liberal",
   "state": "federal",
   "date": "2010-11-16",
   "stage_hint": null,
   "brief": "The opposition proposed amendments to require at least one but no more than two industry representatives and one to two consumer or consumer health representatives on the Australian National Preventive Health Agency’s advisory council, with industry representative defined as someone with high-level expertise in food or beverage manufacturing, distribution or marketing. The Greens and government opposed the amendments, arguing mandated industry representation could undermine the agency’s work due to conflicts of interest, while the opposition argued industry involvement was essential for effective preventive health outcomes."
  },
  {
   "slug": "speech-803345",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2010-11-17",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-803346",
   "speaker": "Nicola Roxon",
   "party": "Labor",
   "state": "federal",
   "date": "2010-11-17",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-803382",
   "speaker": "Russell Trood",
   "party": "Liberal",
   "state": "federal",
   "date": "2010-11-17",
   "stage_hint": null,
   "brief": "The government opposed opposition amendments to prescribe industry and consumer health group seats on the advisory council, arguing it would require prescribing all seats. Senator Xenophon’s amendment requiring the CEO to publish all advice and recommendations within 12 months was adopted, despite government concerns it could temper frank advice; the bill also allocates $102 million for social marketing campaigns targeting obesity and smoking."
  },
  {
