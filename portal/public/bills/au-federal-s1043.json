 "speeches": [
  {
   "slug": "speech-337175",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2016-11-09",
   "stage_hint": null,
   "brief": "The Water Legislation Amendment (Sustainable Diversion Limit Adjustment) Bill 2016 extends the deadline for basin jurisdictions to notify a second package of sustainable diversion limit adjustment measures to 30 June 2017, and requires the Murray-Darling Basin Authority to present its determination by 15 December 2017, following the notification of 36 supply and efficiency measures on 5 May 2016."
  },
  {
   "slug": "speech-337176",
   "speaker": "Cathy McGowan",
   "party": "Independent",
   "state": "federal",
   "date": "2016-11-09",
   "stage_hint": null,
   "brief": "The speaker supported the Water Legislation Amendment Bill and highlighted the successful local resolution of Hume Dam management issues, including poor communication and flawed airspace rules, by convening a roundtable meeting that led to commitments to review the early warning system and convene a working group. They called for a review of the rules governing airspace allocation in the dam to balance irrigation, flood mitigation, and environmental protection."
  },
  {
   "slug": "speech-337177",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2016-11-09",
   "stage_hint": null,
   "brief": "The opposition will support the Water Legislation Amendment (Sustainable Diversion Limit Adjustment) Bill 2016, maintaining bipartisan agreement on the Murray-Darling Basin Plan. The speaker urged states to deliver projects meeting environmental benchmarks for 650 gigalitres of water, warning that environmental standards will not be lowered and that failure would lead to further buybacks or Commonwealth powers being activated."
  }
 ],
