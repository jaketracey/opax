 "speeches": [
  {
   "slug": "speech-342653",
   "speaker": "Michael Keenan",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-03-01",
   "stage_hint": null,
   "brief": "The government moved the Personal Property Securities Amendment (PPS Leases) Bill 2017 to reduce regulatory burdens on small and medium businesses, particularly the hire and rental industry, by changing the definition of a PPS lease so that only leases exceeding two years require registration, down from 12 months. The bill aims to relieve administrative costs and risks for businesses with high volumes of short-term leases, affecting an industry with $6.6 billion turnover and over 18,000 employees."
  },
  {
   "slug": "speech-344778",
   "speaker": "Craig Kelly",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-03-28",
   "stage_hint": null,
   "brief": "The 2017 bill fixes two flaws in the 2009 Personal Property Securities Act: it restores the effectiveness of retention-of-title (Romalpa) clauses for small suppliers and protects the property rights of businesses in the rental and hire industry, reversing a requirement that forced them to register such clauses to avoid losing goods to secured creditors or liquidators in insolvency."
  },
  {
   "slug": "speech-344854",
   "speaker": "Graham Perrett",
   "party": "Labor",
   "state": "federal",
   "date": "2017-03-29",
   "stage_hint": null,
   "brief": "The speaker argued that the coalition member for Hughes misrepresented the Personal Property Securities Amendment (PPS Leases) Bill 2017, which actually extends the minimum lease duration from more than one year to more than two years. The speaker also defended the original 2009 Personal Property Securities Act, introduced by Labor's Robert McClelland, as a reform that consolidated over 70 registers into one."
  }
 ],
