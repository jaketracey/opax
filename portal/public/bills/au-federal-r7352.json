 "divisions": [],
 "speeches": [
  {
   "slug": "speech-1195690",
   "speaker": "Daniel Mulino",
   "party": "Labor",
   "state": "federal",
   "date": "2025-07-30",
   "stage_hint": null,
   "brief": "Moved that the bill be read a second time, seeking $14.6 billion from the Consolidated Revenue Fund and total funding of $25.5 billion for non-ordinary annual government services in 2025-26. Reported funding for Defence, infrastructure, transport and finance, including the Inland Rail program, NBN fibre upgrades and support for the first-ever Hindu school in Australia."
  },
  {
   "slug": "speech-1196769",
   "speaker": "Ted O'Brien",
   "party": "Liberal",
   "state": "federal",
   "date": "2025-09-01",
   "stage_hint": null,
   "brief": "Supported the appropriation bills to ensure continuity of government services but argued that the government's economic management had weakened living standards, increased spending, debt and taxes, and failed to grow productivity; he called for fiscal rules to contain spending."
  },
  {
   "slug": "speech-1197225",
   "speaker": "Joanne Ryan",
   "party": "Labor",
   "state": "federal",
   "date": "2025-09-04",
   "stage_hint": null,
   "brief": "Declared that Appropriation Bill (No. 1) 2025-2026, Appropriation Bill (No. 2) 2025-2026 and Appropriation (Parliamentary Departments) Bill (No. 1) 2025-2026 stood referred to the Federation Chamber for further debate."
  },
  {
   "slug": "speech-1197274",
   "speaker": "Joanne Ryan",
   "party": "Labor",
   "state": "federal",
   "date": "2025-09-04",
   "stage_hint": null,
   "brief": "Returned Appropriation Bill (No. 1) 2025-2026, Appropriation Bill (No. 2) 2025-2026 and Appropriation (Parliamentary Departments) Bill (No. 1) 2025-2026 to the House for further consideration."
  },
  {
   "slug": "speech-1197400",
   "speaker": "Patrick Gorman",
   "party": "Labor",
   "state": "federal",
   "date": "2025-10-07",
   "stage_hint": null,
   "brief": "Moved to suspend standing and sessional orders to set expedited proceedings and portfolio timeframes for the appropriation bills, require questions to be put without debate at specified stages, and allow variations only on a motion moved by a Minister."
  }
