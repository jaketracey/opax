 "divisions": [],
 "speeches": [
  {
   "slug": "speech-287847",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-05-13",
   "stage_hint": null,
   "brief": "Introduced Appropriation Bill (No. 2) 2014 to 2015, seeking just over $8.4 billion from the Consolidated Revenue Fund, including about $3.2 billion for the Department of Communications to continue the National Broadband Network rollout and just under $2.5 billion in capital funding for the Department of Defence."
  },
  {
   "slug": "speech-288185",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-05-15",
   "stage_hint": null,
   "brief": "Moved to suspend standing orders so debate on the Appropriation Bill (No. 1) 2014-2015 would proceed as a cognate debate with other appropriation bills, with combined questions on their second reading, detail and third reading stages unless varied by a minister's motion."
  },
  {
   "slug": "speech-288849",
   "speaker": "Philip Ruddock",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-05-27",
   "stage_hint": null,
   "brief": "Declared that the appropriation bills for the 2014 to 2015 and 2013 to 2014 financial years stood referred to the Federation Chamber for further consideration from 1.30 pm that day."
  },
  {
   "slug": "speech-289133",
   "speaker": "Graham Perrett",
   "party": "Labor",
   "state": "federal",
   "date": "2014-05-27",
   "stage_hint": null,
   "brief": "Defended Labor's $14.7 billion Gonski investment benefiting the roughly 21,000 students across 45 schools in his Moreton electorate, cited reports of degree costs rising by as much as 33 per cent, and said Australia's net debt peaks at just one-seventh the level of comparable advanced economies while retaining a AAA credit rating shared by only eight countries."
  },
  {
   "slug": "speech-289501",
   "speaker": "Anthony Byrne",
   "party": "Labor",
   "state": "federal",
   "date": "2014-05-28",
   "stage_hint": null,
   "brief": "Argued the budget's reinstated fuel excise indexation, currently 38.143c a litre, would have reached 55c a litre had it continued since 2001, disproportionately hitting outer-suburban families, and said the Monash Health hospital network in his electorate stands to lose $122,536,072 in funding between 2014 and 2018."
  },
  {
   "slug": "speech-290676",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-06-04",
   "stage_hint": null,
   "brief": "Closed the appropriation bills debate detailing just under $88.4 billion in total spending including $28.3 billion for Defence and $4.3 billion for Immigration and Border Protection, noted it had been 167 days without an illegal boat arrival and nine detention centres closed, and confirmed $500,000 for CCTV cameras in Wagga Wagga under the Safer Streets Program."
  },
  {
   "slug": "speech-293614",
   "speaker": "Laurie Ferguson",
   "party": "Labor",
   "state": "federal",
   "date": "2014-06-25",
   "stage_hint": null,
   "brief": "Detailed the Human Rights Committee's eighth report, covering 18 bills and 51 legislative instruments, and highlighted the Australian Citizenship (Intercountry Adoption) Bill 2014, on which the committee sought more information about safeguards for children adopted under bilateral agreements outside the Hague Convention."
  }
 ],
