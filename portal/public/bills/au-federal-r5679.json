 "speeches": [
  {
   "slug": "speech-332936",
   "speaker": "Greg Hunt",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-09-01",
   "stage_hint": null,
   "brief": "The Statute Update Bill 2016 makes minor and technical amendments to Commonwealth laws, including replacing dollar penalties with penalty units in criminal offence provisions and updating references to aircraft registered under the Civil Aviation Regulations 1988."
  },
  {
   "slug": "speech-333871",
   "speaker": "Nola Marino",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-09-14",
   "stage_hint": null,
   "brief": "Three bills—Statute Law Revision (Spring 2016) Bill 2016, Statute Update Bill 2016, and Corporations Amendment (Auditor Registration) Bill 2016—were referred to the Federation Chamber for further consideration upon adjournment of debate."
  },
  {
   "slug": "speech-333874",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2016-09-14",
   "stage_hint": null,
   "brief": "The Statute Update Bill 2016 is a routine set of drafting amendments with little legal effect, not an urgent reform; Labor supports it but rejects the government’s portrayal of it as part of a 25-point battle plan or a policy onslaught."
  }
