 "speeches": [
  {
   "slug": "speech-398257",
   "speaker": "Chris Bowen",
   "party": "Labor",
   "state": "federal",
   "date": "2020-11-10",
   "stage_hint": null,
   "brief": "The Health Insurance Amendment (Administration) Bill 2020 removes the annual requirement to remake the Medicare Benefits Schedule as a redundant process. The opposition will support the bill but criticises it as minor administrative tinkering, noting record-high out-of-pocket costs and waiting lists, and no reform on private health insurance or broader health system issues."
  },
  {
   "slug": "speech-398258",
   "speaker": "Katrina Allen",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-11-10",
   "stage_hint": null,
   "brief": "The speaker argued that Australia's healthcare system does not require major reform, citing the country's strong COVID-19 response and record bulk-billing rates, and announced the Health Insurance Amendment (Administration) Bill 2020, which removes the annual sunset period for Medical Benefits Schedule regulations to reduce administrative work and ensure patient entitlements."
  },
