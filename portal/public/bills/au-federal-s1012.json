 "speeches": [
  {
   "slug": "speech-318796",
   "speaker": "Bob Baldwin",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-09-15",
   "stage_hint": null,
   "brief": "The member for Paterson supported the Aged Care Amendment (Independent Complaints Arrangements) Bill 2015, noting that Paterson has the fourth-highest number of residents over 70 in Australia, with 18,642 people aged over 70 making up 15.6 per cent of the electorate's population."
  },
  {
   "slug": "speech-318798",
   "speaker": "Kelly O'Dwyer",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-09-15",
   "stage_hint": null,
   "brief": "The Aged Care Amendment (Independent Complaints Arrangements) Bill 2015 transfers aged-care complaints handling from the Department of Social Services to the Aged Care Complaints Commissioner from 1 January 2016, implementing recommendations from the 2009 Walton review and the Productivity Commission's 2011 report."
  }
 ],
