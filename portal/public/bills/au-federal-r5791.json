 "speeches": [
  {
   "slug": "speech-340153",
   "speaker": "Ed Husic",
   "party": "Labor",
   "state": "federal",
   "date": "2017-02-07",
   "stage_hint": null,
   "brief": "The speaker raised concerns about the Treasury Laws Amendment Bill's employee share scheme changes, questioning whether the government properly consulted start-ups before introducing legislation, and highlighting potential problems with disclosure transparency, employee bargaining power, and inconsistencies with upcoming equity crowdfunding laws."
  },
  {
   "slug": "speech-340155",
   "speaker": "Craig Kelly",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-02-07",
   "stage_hint": null,
   "brief": "The speaker argued that reducing the corporate tax rate from 30% to 28% in New Zealand led to increased tax receipts, rising from $6.3 billion to $6.4 billion in the transition year and then by 24.9% in 2012, with further annual increases through 2016, countering claims that Australia's enterprise tax scheme is a $50 billion giveaway."
  },
  {
   "slug": "speech-341094",
   "speaker": "Kelly O'Dwyer",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-02-13",
   "stage_hint": null,
   "brief": "The bill amends terrorism insurance, employee share schemes, deductible gift recipient listings, disaster payment tax relief, and client money protections. Key measures include removing public disclosure requirements for employee share schemes of eligible unlisted start-ups (incorporated <10 years, turnover <$50M), adding six entities to DGR listings, providing ongoing tax relief for New Zealand Special Category Visa holders' disaster payments, and strengthening client money protections for over-the-counter derivatives."
  }
 ],
