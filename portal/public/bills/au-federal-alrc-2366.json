 "speeches": [
  {
   "slug": "speech-273343",
   "speaker": "Michael Keenan",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-05-28",
   "stage_hint": null,
   "brief": "Supported the Statute Law Revision Bill 2012, describing it as a noncontroversial measure that corrects drafting and clerical errors, repeals obsolete legislation and updates redundant provisions, including air passenger ticket levy acts discontinued in 2003."
  },
  {
   "slug": "speech-273344",
   "speaker": "Michelle Rowland",
   "party": "Labor",
   "state": "federal",
   "date": "2013-05-28",
   "stage_hint": null,
   "brief": "Supported the Statute Law Revision Bill 2013, arguing that correcting errors, redundant provisions, punctuation, references and drafting improves the accessibility and reliability of Commonwealth legislation, and highlighting plain-language guidance and a telecommunications law iPad app as examples of legal accessibility."
  },
  {
   "slug": "speech-273345",
   "speaker": "Shayne Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2013-05-28",
   "stage_hint": null,
   "brief": "Commended the Statute Law Revision Bill 2013 for correcting minor errors, repealing obsolete provisions and improving the accuracy, clarity and usability of Commonwealth legislation across areas including telecommunications, corporations law, aviation, native title, superannuation and transport."
  }
 ],
