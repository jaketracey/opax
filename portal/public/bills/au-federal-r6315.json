 "speeches": [
  {
   "slug": "speech-376649",
   "speaker": "Paul Fletcher",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-04-03",
   "stage_hint": null,
   "brief": "The bill provides a one-off energy assistance payment of $75 for singles and $62.50 per eligible couple member to all income support recipients and veterans residing in Australia on 2 April 2019, costing $365 million and automatically paid by June 2019."
  },
  {
   "slug": "speech-376652",
   "speaker": "Paul Fletcher",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-04-03",
   "stage_hint": null,
   "brief": "The Social Services Legislation Amendment (Energy Assistance Payment) Bill provides a one-off, tax-free energy assistance payment of $75 for singles and $62.50 per eligible couple member to pension, allowance and veteran payment recipients residing in Australia on 2 April 2019, costing $365 million and helping around five million Australians."
  }
