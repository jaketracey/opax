 "speeches": [
  {
   "slug": "speech-386168",
   "speaker": "David Littleproud",
   "party": "LNP",
   "state": "federal",
   "date": "2019-12-04",
   "stage_hint": null,
   "brief": "The Export Charges (Imposition-General) Amendment Bill 2019 was moved for a second reading as the first of three bills updating export charging legislation to align with the Export Control Bill 2019 and the repeal of the Export Control Act 1982 and the Export Charges (Collection) Act 2015. The bill amends the Export Charges (Imposition-General) Act 2015 to allow the Commonwealth to impose charges reflecting export control administration costs, with specific amounts set in regulations and the Minister for Agriculture required to ensure charges do not exceed likely costs."
  },
  {
   "slug": "speech-388039",
   "speaker": "Andrew Gee",
   "party": "Nationals",
   "state": "federal",
   "date": "2020-02-12",
   "stage_hint": null,
   "brief": "The Export Control Bill 2019 and associated bills consolidate and replace existing agricultural export legislation, streamlining rules, improving certification, and enabling faster government responses to market changes. The package also transitions arrangements smoothly and continues cost-recovery charges for administering the export control system."
  }
 ],
