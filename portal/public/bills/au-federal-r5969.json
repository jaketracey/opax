 "speeches": [
  {
   "slug": "speech-355043",
   "speaker": "Gai Brodtmann",
   "party": "Labor",
   "state": "federal",
   "date": "2017-10-17",
   "stage_hint": null,
   "brief": "Labor supported the Defence Legislation Amendment (Instrument Making) Bill 2017, which updates three 30-year-old legislative instruments—the Defence (Inquiry) Regulations 1985, Defence (Areas Control) Regulations 1989, and Defence (Public Areas) By-Laws 1987—due to sunset in April 2018, to keep them fit for purpose without significant operational changes."
  },
  {
   "slug": "speech-355045",
   "speaker": "Luke Hartsuyker",
   "party": "Nationals",
   "state": "federal",
   "date": "2017-10-17",
   "stage_hint": null,
   "brief": "The bill amends the Defence Act 1903 to allow instruments such as the Defence (Inquiry) Regulations 1985, Defence (Areas Control) Regulations 1989, and Defence (Public Areas) By-Laws 1987—scheduled to sunset in April 2018—to be remade with modern policy requirements, consolidated provisions, and improved consistency."
  }
 ],
