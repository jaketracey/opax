 "speeches": [
  {
   "slug": "speech-393997",
   "speaker": "Paul Fletcher",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-08-27",
   "stage_hint": null,
   "brief": "The Radiocommunications (Receiver Licence Tax) Amendment Bill 2020 allows the Australian Communications and Media Authority to require upfront payment of tax for specified classes of receiver licences, aligning with spectrum licence practices, as part of reforms that extend maximum licence terms to 20 years."
  },
  {
   "slug": "speech-398649",
   "speaker": "Michelle Rowland",
   "party": "Labor",
   "state": "federal",
   "date": "2020-11-11",
   "stage_hint": null,
   "brief": "The Labor opposition supported the Radiocommunications Legislation Amendment Bill 2020 to modernise spectrum management, but criticised the government for delivering the legislation over three years late and failing to implement all recommendations from the 2015 Spectrum Review, and for mishandling community television licensing."
  }
