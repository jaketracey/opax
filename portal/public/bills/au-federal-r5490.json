 "divisions": [],
 "speeches": [
  {
   "slug": "speech-315852",
   "speaker": "Sussan Ley",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-08-13",
   "stage_hint": null,
   "brief": "The bill amends the Australian Radiation Protection and Nuclear Safety Act to give ARPANSA greater powers for end-to-end risk management, compliance monitoring, and emergency direction-issuing, while maintaining quarterly and annual public reporting to parliament and online for accountability, with no financial impact or increased compliance burden."
  }
