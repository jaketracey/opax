 "speeches": [
  {
   "slug": "speech-828797",
   "speaker": "Anika Wells",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-22",
   "stage_hint": null,
   "brief": "The mover argued that the Inspector-General of Aged Care Bill will establish an independent body to monitor, review, and report on the Commonwealth's administration of the aged-care system, with coercive information-gathering powers. The bill aims to restore public trust by addressing systemic issues identified by the Royal Commission into Aged Care Quality and Safety, and includes annual progress reports on implementing the commission's recommendations."
  },
  {
   "slug": "speech-830042",
   "speaker": "Tim Ayres",
   "party": "Labor",
   "state": "federal",
   "date": "2023-05-10",
   "stage_hint": null,
   "brief": "The Inspector-General of Aged Care Bill 2023 and its consequential bill were introduced to establish an independent Inspector-General with coercive powers to monitor, review, and report on the Commonwealth’s administration and regulation of aged care, including annual progress reports on the Royal Commission’s recommendations."
  }
