 "speeches": [
  {
   "slug": "speech-384465",
   "speaker": "Clare O'Neil",
   "party": "Labor",
   "state": "federal",
   "date": "2019-11-25",
   "stage_hint": null,
   "brief": "The Labor spokesperson argued the government mishandled the Telecommunications (Interception and Access) Amendment Bill by failing to consult oversight bodies and small businesses, and breaking a promise to fix it within a year, harming Australia’s tech sector which could employ 800,000 by 2022. They noted Australia ranks second-last among OECD countries for tech sector size and called for better support to grow the digital economy."
  },
  {
   "slug": "speech-384467",
   "speaker": "Ed Husic",
   "party": "Labor",
   "state": "federal",
   "date": "2019-11-25",
   "stage_hint": null,
   "brief": "The government's sudden push for consultation on the encryption bill is not genuine, as it previously ignored 15,000 submissions, broke a deal with Labor, and rushed flawed laws that weaken national security and jeopardise Australia's compliance with the US CLOUD Act. The speaker also criticised the Home Affairs Minister for politicking and urged US lawmakers to reject Australia's law as non-compliant."
  },
  {
   "slug": "speech-384468",
   "speaker": "Steve Irons",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-11-25",
   "stage_hint": null,
   "brief": "The member argued for the timely passage of the bill to extend the review periods for the PJCIS and INSLM regarding the 2018 Assistance and Access Act, noting bipartisan PJCIS support and INSLM backing."
  }
 ],
