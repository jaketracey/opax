 "speeches": [
  {
   "slug": "speech-348093",
   "speaker": "David Gillespie",
   "party": "Nationals",
   "state": "federal",
   "date": "2017-06-01",
   "stage_hint": null,
   "brief": "The Industrial Chemicals (Consequential Amendments and Transitional Provisions) Bill 2017 was introduced as a companion to the Industrial Chemicals Bill 2017, to repeal the 1989 Act and related charges acts from 1 July 2018, transition existing authorisations and inventory listings to the new Australian Industrial Chemicals Introduction Scheme (AICIS), and allow a 12-month transition period for low-volume or low-concentration chemical introductions."
  },
  {
   "slug": "speech-354885",
   "speaker": "Tony Zappia",
   "party": "Labor",
   "state": "federal",
   "date": "2017-10-17",
   "stage_hint": null,
   "brief": "Labor will not oppose the Industrial Chemicals Bill 2017 but will move amendments to require annual post‑introduction reports for chemicals in the exempted introductions category and to close loopholes in the ban on using new animal test data for cosmetics."
  },
  {
   "slug": "speech-355036",
   "speaker": "David Gillespie",
   "party": "Nationals",
   "state": "federal",
   "date": "2017-10-17",
   "stage_hint": null,
   "brief": "The bills create a new Australian Industrial Chemicals Introduction Scheme, adopting a risk‑based regulatory approach that includes a ban on animal testing for cosmetics consistent with the European Union, while the speaker argued opposition amendments would create loopholes and place Australian industry at a disadvantage by blocking necessary animal test data for multi‑use chemicals."
  },
  {
   "slug": "speech-355066",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-10-17",
   "stage_hint": null,
   "brief": "Presented addenda to the explanatory memoranda for the Industrial Chemicals Bill 2017 and four related bills."
  }
 ],
