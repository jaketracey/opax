 "speeches": [
  {
   "slug": "speech-358828",
   "speaker": "Rebekha Sharkie",
   "party": "Centre Alliance",
   "state": "federal",
   "date": "2018-02-12",
   "stage_hint": null,
   "brief": "The Competition and Consumer Amendment (Free Range Eggs) Bill 2018 proposes to limit 'free range' labelling to eggs from hens stocked at no more than 1,500 birds per hectare that actually roam outdoors during daylight, and to require stocking density displayed as 'hens per hectare' on cartons. The current standard allows up to 10,000 hens per hectare, which the speaker argues misleads consumers and contrasts with international standards like the EU's 2,500 birds per hectare."
  }
 ],
