  },
  {
   "slug": "speech-799130",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2010-03-10",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-799131",
   "speaker": "Nick Minchin",
   "party": "Liberal",
   "state": "federal",
   "date": "2010-03-10",
   "stage_hint": null,
   "brief": "The coalition moved to suspend standing orders to delay the Telecommunications Legislation Amendment Bill until the government tables its response to the $25 million NBN Implementation Study, arguing the bill is intrinsically linked to the NBN and cannot be properly considered without it."
  },
  {
   "slug": "speech-799156",
   "speaker": "Ian Macdonald",
   "party": "Liberal",
   "state": "federal",
   "date": "2010-03-10",
   "stage_hint": null,
   "brief": "The opposition argued the bill would confiscate Telstra's property without compensation, harm its 1.4 million shareholders and rural customers, and called for it to be split so consumer protections could pass separately; the government defended the bill as necessary to address Telstra's anticompetitive integration, reform telecommunications regulation, and enable the $43 billion National Broadband Network, citing support from ACCC Chairman Graeme Samuel."
  },
  {
   "slug": "speech-799264",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2010-03-11",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-799265",
   "speaker": "Christopher Back",
   "party": "Liberal",
   "state": "federal",
   "date": "2010-03-11",
   "stage_hint": null,
   "brief": "The opposition argued the bill is an unjustified attack on Telstra, a company with 1.4 million shareholders, and that the government lacks a business plan or cost-benefit analysis for the $43 billion National Broadband Network. They opposed the legislation, claiming it would destroy shareholder value and increase sovereign risk."
  },
  {
   "slug": "speech-799276",
   "speaker": "Michael Ronaldson",
   "party": "Liberal",
   "state": "federal",
   "date": "2010-03-11",
   "stage_hint": null,
   "brief": "The bill is bad for Telstra shareholders, as shown by Telstra’s share price rising 7c, and the government has acted deceitfully by imposing legislation that was not promised at the election and that uses 1.4 million mum-and-dad investors."
  },
  {
   "slug": "speech-799408",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2010-03-15",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-799409",
   "speaker": "Michael Ronaldson",
   "party": "Liberal",
   "state": "federal",
   "date": "2010-03-15",
   "stage_hint": null,
   "brief": "The coalition argued the Telecommunications Legislation Amendment Bill 2009 is an attack on 1.4 million Telstra shareholders and 30,000 employees, accusing the government of blackmailing Telstra to prop up the $43 billion National Broadband Network without a business plan or cost-benefit analysis. They demanded the release of the NBN implementation study before any legislation is passed."
  }
 ],
