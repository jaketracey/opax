  {
   "slug": "speech-826357",
   "speaker": "Michaelia Cash",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-12-05",
   "stage_hint": null,
   "brief": "The speech announced the transfer of the Anti-Dumping Commission to the Department of Industry, changes to social security including a 35-year Australian working life residence requirement for overseas pensioners and a $7,500 annual child care rebate cap, and amendments to submarine cable protection legislation to align with UNCLOS and streamline permit processes."
  },
  {
   "slug": "speech-826815",
   "speaker": "Mitch Fifield",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-12-12",
   "stage_hint": null,
   "brief": "Moved to schedule non-controversial government bills for consideration from 12:45 pm, including amendments to the Australian Civilian Corps, Import Processing Charges, Grape and Wine Authority, Offshore Petroleum, Rural Research and Development, and Customs Anti-Dumping Commission. Also moved to set general business order for the day, prioritising Senator Moore's motion on pre-election commitments and government document orders."
  },
  {
   "slug": "speech-826852",
   "speaker": "Nick Xenophon",
   "party": "Independent",
   "state": "federal",
   "date": "2013-12-12",
   "stage_hint": null,
   "brief": "The speaker opposed transferring the Anti-Dumping Commission to the department, citing the Brumby review’s concerns about investigative powers and integrity standards, and asked how department staff would meet the same thresholds as customs officers. He also reiterated support for reversing the onus of proof in dumping cases."
  }
