 "speeches": [
  {
   "slug": "speech-384976",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2019-11-27",
   "stage_hint": null,
   "brief": "The speaker argued the Treasury Laws Amendment (Combating Illegal Phoenixing) Bill 2019 does not go far enough to address phoenixing, which costs the Australian economy $2.9–$5.1 billion annually, and announced Labor will introduce amendments to implement director identification numbers and a five-year review. The speech cited cases of Tara Teo and Ian Campbell of JUMP! Swim Schools, and noted Professor Helen Anderson’s view that the bill alone will not solve the problem."
  },
  {
   "slug": "speech-387104",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2020-02-05",
   "stage_hint": null,
   "brief": "The speaker welcomed the government's acceptance of their amendments to the Treasury Laws Amendment (Combating Illegal Phoenixing) Bill 2019, but expressed scepticism that the bill's measures would be sufficient. They highlighted the importance of director identification numbers to track recidivist directors who defraud creditors and the Australian Tax Office, and urged the government to expedite related legislation."
  }
