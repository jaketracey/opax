 "speeches": [
  {
   "slug": "speech-828653",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-21",
   "stage_hint": null,
   "brief": "Bills on financial accountability, financial services compensation, health, national security, education and vocational training were referred to the Federation Chamber for further consideration. The speaker also remarked that they hoped their next speech would be more interesting."
  },
  {
   "slug": "speech-828657",
   "speaker": "Julian Leeser",
   "party": "Liberal",
   "state": "federal",
   "date": "2023-03-21",
   "stage_hint": null,
   "brief": "The bill implements Richardson review recommendations, including extending the Inspector-General of Intelligence and Security’s complaint-driven investigative powers to the Defence Intelligence Organisation and the Office of National Intelligence, reducing duplication with other oversight bodies, and requiring a cooling-off period for IGIS appointments. The coalition supports the bill."
  },
  {
   "slug": "speech-828728",
   "speaker": "Gordon Reid",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-21",
   "stage_hint": null,
   "brief": "The Inspector-General of Intelligence and Security and Other Legislation Amendment (Modernisation) Bill 2022 was debated, implementing recommendations 172 and 174 from the Comprehensive Review of the Legal Framework of the National Intelligence Community to strengthen IGIS independence and oversight, including preventing heads or deputy heads of intelligence agencies from immediately becoming IGIS and allowing IGIS to handle employment grievances for Office of National Intelligence staff."
  }
 ],
