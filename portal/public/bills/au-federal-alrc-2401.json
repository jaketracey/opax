  {
   "slug": "speech-824345",
   "speaker": "Anne McEwen",
   "party": "Labor",
   "state": "federal",
   "date": "2013-06-17",
   "stage_hint": null,
   "brief": "Two parliamentary committee reports were presented: one on the Therapeutic Goods Amendment (2013 Measures No. 1) Bill 2013 and one on the Private Health Insurance Legislation Amendment (Base Premium) Bill 2013, with both reports ordered to be printed."
  },
  {
   "slug": "speech-825297",
   "speaker": "Concetta Fierravanti-Wells",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-06-27",
   "stage_hint": null,
   "brief": "The coalition argued that Labor’s changes to private health insurance broke repeated promises to maintain the rebate, and will increase premiums by up to 27.5 percent and push people onto public hospitals. The coalition moved an amendment to oppose the lifetime health cover component of the first bill and did not oppose the base premium bill."
  },
  {
   "slug": "speech-825298",
   "speaker": "John Hogg",
   "party": "PRES",
   "state": "federal",
   "date": "2013-06-27",
   "stage_hint": null,
   "brief": "The remaining stages of the Private Health Insurance Amendment (Lifetime Health Cover Loading and Other Measures) Bill 2012 and the Private Health Insurance Legislation Amendment (Base Premium) Bill 2013 were agreed to, and both bills were read a third time and passed."
  }
 ],
