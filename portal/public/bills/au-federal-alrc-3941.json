  {
   "slug": "speech-791955",
   "speaker": "Jenny Macklin",
   "party": "Labor",
   "state": "federal",
   "date": "2009-03-17",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-792117",
   "speaker": "Jan McLucas",
   "party": "Labor",
   "state": "federal",
   "date": "2009-03-18",
   "stage_hint": null,
   "brief": "The speaker moved that the bills proceed without formalities, be taken together and read a first time; the motion was agreed to and the bills were read a first time."
  },
  {
   "slug": "speech-792118",
   "speaker": "Jan McLucas",
   "party": "Labor",
   "state": "federal",
   "date": "2009-03-18",
   "stage_hint": null,
   "brief": "The government introduced two bills: the first changes the Commonwealth Seniors Health Card income test to include gross superannuation and salary‑sacrificed superannuation, with thresholds of $50,000 for singles and $80,000 for couples; the second doubles the liquid assets waiting period thresholds to $5,000 for singles and $10,000 for couples and excludes life insurance surrender values, effective for two years from April 2009."
  },
  {
   "slug": "speech-792290",
   "speaker": "Nigel Scullion",
   "party": "Country Liberal Party",
   "state": "federal",
   "date": "2009-03-19",
   "stage_hint": null,
   "brief": "The bill would remove the Commonwealth Seniors Health Card from 22,000 seniors, increasing their prescription costs by 605% and eliminating other concessions, while the government had not released the Harmer review on income support for older Australians."
  },
  {
   "slug": "speech-792324",
   "speaker": "Nigel Scullion",
   "party": "Country Liberal Party",
   "state": "federal",
   "date": "2009-03-19",
   "stage_hint": null,
   "brief": "The bill amends eligibility for the Commonwealth Seniors Health Card by including superannuation income and salary‑sacrificed amounts in the income test, which opponents said would remove the card from around 22,000 seniors and break election promises, while supporters argued it closes loopholes and ensures fairness."
  },
  {
   "slug": "speech-792325",
   "speaker": "Rachel Siewert",
   "party": "Greens",
   "state": "federal",
   "date": "2009-03-19",
   "stage_hint": null,
   "brief": "The Greens moved amendments to raise the seniors health card income thresholds to $60,000 for singles and $85,000 for couples, and to grandfather existing cardholders so they would not lose the card. The amendments were rejected."
  }
 ],
