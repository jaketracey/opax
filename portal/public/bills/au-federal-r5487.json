 "speeches": [
  {
   "slug": "speech-312191",
   "speaker": "Josh Frydenberg",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-06-04",
   "stage_hint": null,
   "brief": "The Excise Tariff Amendment (Ethanol and Biodiesel) Bill 2015 implements 2014-15 budget measures replacing the Cleaner Fuels Grant Scheme and Ethanol Production Grants Scheme with reduced excise rates for domestically-produced biodiesel (reaching 50% of full fuel duty) and fuel ethanol (reaching 33%), while imported biodiesel and ethanol will be taxed at the full rate."
  },
  {
   "slug": "speech-312912",
   "speaker": "Gary Gray",
   "party": "Labor",
   "state": "federal",
   "date": "2015-06-16",
   "stage_hint": null,
   "brief": "The Excise Tariff Amendment (Ethanol and Biodiesel) Bill 2015 and the accompanying Energy Grants and Other Legislation Amendment (Ethanol and Biodiesel) Bill 2015 were supported as a move to phase in reduced excise rates over 15 years—50% of the full rate for biodiesel and 33% for ethanol—while abolishing the Cleaner Fuels Grants Scheme and Ethanol Production Grants Scheme, creating a comparative advantage for domestic producers; the biodiesel industry was cited as contributing $64 million and over 400 full-time equivalent jobs, mostly in regional Australia."
  },
  {
   "slug": "speech-313064",
   "speaker": "George Christensen",
   "party": "Nationals",
   "state": "federal",
   "date": "2015-06-16",
   "stage_hint": null,
   "brief": "The government will reduce excise on domestically manufactured biodiesel and ethanol to zero for one year from next month, with rates rising incrementally to 33% of petrol excise for ethanol and 50% of diesel excise for biodiesel by July 2020. The bills also remove grants for biodiesel and renewable fuels, while the member argued the new excise pathway provides industry certainty and supports a long-term plan, noting the Nationals' call for a 10% ethanol mandate nationally in 2015."
  },
  {
   "slug": "speech-313066",
   "speaker": "Karen Andrews",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-06-16",
   "stage_hint": null,
   "brief": "The bills implement the 2014-15 budget measures to remove existing grant schemes for biofuels and apply a reduced but gradually increasing excise rate, with ethanol reaching 33% of the petrol excise by 2020 and biodiesel reaching 50% of the diesel excise by 2030, providing a 50% discount on the energy-based excise for each category."
  }
 ],
