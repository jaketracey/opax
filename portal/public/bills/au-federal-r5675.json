 "speeches": [
  {
   "slug": "speech-333212",
   "speaker": "Andrew Leigh",
   "party": "Labor",
   "state": "federal",
   "date": "2016-09-12",
   "stage_hint": null,
   "brief": "The opposition supported the Registration of Deaths Abroad Amendment Bill 2016, which validates the appointment of the ACT registrar-general as Registrar of Deaths Abroad and simplifies registration processes, but criticised the government for delaying the bill by calling an early election."
  },
  {
   "slug": "speech-333213",
   "speaker": "Craig Kelly",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-09-12",
   "stage_hint": null,
   "brief": "The Registration of Deaths Abroad Amendment Bill 2016 corrects an anomaly that left applicants unable to register deaths of family members overseas because the ACT Registrar-General was not employed under the Commonwealth Public Service Act. In 2014–15, 1,282 Australians died overseas, with the most deaths recorded in Thailand, the Philippines and Indonesia, while 9.7 million Australians took short-term overseas trips in 2015."
  },
  {
   "slug": "speech-333214",
   "speaker": "Michael Keenan",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-09-12",
   "stage_hint": null,
   "brief": "The Registration of Deaths Abroad Amendment Bill 2016 amends the Registration of Deaths Abroad Act 1984 to correct an anomaly that left some applicants unable to register overseas deaths of family members. It provides the Registrar of Deaths Abroad with clear discretion when a state or territory will not register a death, and continues the Minister for Foreign Affairs' authority to appoint registrars."
  }
 ],
