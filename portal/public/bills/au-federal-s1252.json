 "speeches": [
  {
   "slug": "speech-400520",
   "speaker": "Ben Morton",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-12-08",
   "stage_hint": null,
   "brief": "The Transport Security Amendment (Testing and Training) Bill 2020 clarifies the ability of aviation security inspectors to conduct system tests beyond screening points, including at air cargo and catering facilities, and establishes a framework for national competency standards for aviation and maritime screening personnel, responding to a 2016 Inspector of Transport Security inquiry."
  },
  {
   "slug": "speech-400917",
   "speaker": "Andrew Giles",
   "party": "Labor",
   "state": "federal",
   "date": "2020-12-10",
   "stage_hint": null,
   "brief": "Labor supported the Transport Security Amendment (Testing and Training) Bill 2020, which expands aviation security testing to areas like air cargo and catering and introduces national competency standards for screening personnel. A second reading amendment was moved criticising the Coalition government's original bill as error-ridden and delayed over a year, citing broader border security failures such as the Ruby Princess and the lack of a national quarantine approach."
  },
  {
   "slug": "speech-400923",
   "speaker": "Vince Connelly",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-12-10",
   "stage_hint": null,
   "brief": "The Transport Security Amendment (Testing and Training) Bill 2020 gives aviation security inspectors explicit powers to test security systems at airports and updates training and qualification requirements for screening officers, supported by an additional $2.3 billion in national security investment since 2014."
  },
  {
   "slug": "speech-400924",
   "speaker": "Trevor Evans",
   "party": "LNP",
   "state": "federal",
   "date": "2020-12-10",
   "stage_hint": null,
   "brief": "The Transport Security Amendment (Testing and Training) Bill 2020 amends the Aviation Transport Security Act 2004 and the Maritime Transport and Offshore Facilities Security Act 2003 to improve screening effectiveness at airports and seaports, incorporating minor amendments from the Senate Standing Committee for the Scrutiny of Bills."
  }
 ],
