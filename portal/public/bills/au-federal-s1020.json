 "speeches": [
  {
   "slug": "speech-323534",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-11-23",
   "stage_hint": null,
   "brief": "The Crimes Legislation Amendment (Harming Australians) Bill 2015 was introduced to allow retrospective prosecution in Australia of murder and manslaughter of Australian citizens or residents committed overseas before 2002, with safeguards including dual criminality, the lowest applicable penalty, and Attorney-General consent. The bill was prompted by the case of Anthea Bradshaw-Hall, murdered in Brunei 21 years ago, and was co-sponsored by the Attorney-General and Senator Nick Xenophon."
  },
  {
   "slug": "speech-323535",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2015-11-23",
   "stage_hint": null,
   "brief": "The Crimes Legislation Amendment (Harming Australians) Bill 2015 extends the retrospective application of murder and manslaughter offences for Australians killed overseas, with safeguards to ensure fair prosecutions. Labor supported the bill, which arose from advocacy by the family of Anthea Bradshaw-Hall."
  },
  {
   "slug": "speech-323537",
   "speaker": "Karen Andrews",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-11-23",
   "stage_hint": null,
   "brief": "The speaker supported the Crimes Legislation Amendment (Harming Australians) Bill 2015, arguing that direct involvement in terrorist activities severs the bond of allegiance and justifies loss of citizenship for dual nationals. The speaker also defended Australia’s refugee and humanitarian record, citing 163,017 new citizens in 2013-14, 13,500 refugees resettled last year, an increase to 18,750 places by 2018-19, and 12,000 extra refugees from Syria and Iraq."
  }
 ],
