 "divisions": [],
 "speeches": [
  {
   "slug": "speech-347049",
   "speaker": "Josh Frydenberg",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-05-25",
   "stage_hint": null,
   "brief": "The Statute Update (Winter 2017) Bill 2017 was moved for second reading, making minor and technical corrections to 17 principal acts, updating cross-references in six acts, and repealing 19 spent provisions and four redundant acts to improve the accuracy and clarity of the Commonwealth statute book."
  },
  {
   "slug": "speech-351780",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2017-08-16",
   "stage_hint": null,
   "brief": "The Statute Update (Winter 2017) Bill 2017 performs routine technical corrections and repeals obsolete provisions, not substantive deregulation. Previous government claims of $100,000 and $50,000 annual savings from similar bills were not independently verified, as the Australian National Audit Office and the Joint Committee of Public Accounts and Audit had recommended."
  },
  {
   "slug": "speech-352047",
   "speaker": "Shayne Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2017-08-16",
   "stage_hint": null,
   "brief": "The government's repeal days exaggerated minor regulatory savings—$1.8 million total, with one item saving only $3,000—and the NBN rollout was called an absolute disgrace."
  },
  {
   "slug": "speech-352048",
   "speaker": "Andrew Hastie",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-08-16",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-352050",
   "speaker": "Julian Hill",
   "party": "Labor",
   "state": "federal",
   "date": "2017-08-16",
   "stage_hint": null,
   "brief": "The speaker supported the Statute Update (Winter 2017) Bill 2017 as uncontroversial but argued the government should not count it towards deregulation targets, and called for independent verification of the government's claimed $4.5 billion in deregulation savings."
  }
