 "summary": {
  "version": 3,
  "basis": "em",
  "attribution": "Written by a model from the explanatory memorandum; not the record",
  "describes_version": "original",
  "as_of": "2023-05-09",
  "sentences": [
   "The bill would authorise 2023-24 Commonwealth expenditure for services outside ordinary annual government operations, including capital funding and payments to other levels of government.",
   "It would provide scheduled appropriations for intergovernmental assistance, new administered outcomes, assets and liabilities, equity injections and corporate entities, alongside separate ordinary services funding.",
   "The legislation would commence on 1 July 2023 or Royal Assent, whichever is later, and separately set limits on specified federal financial relations payments."
  ],
  "changes": [
   "The Finance Minister could allocate up to $600 million for urgent expenditure meeting the advance provisions.",
   "General purpose financial assistance would have a $5,000 million annual debit limit.",
   "National partnership payments would have a $35,000 million annual debit limit.",
   "Responsible ministers could determine conditions, amounts and timing for specified intergovernmental payments.",
   "The appropriation legislation would repeal at the start of 1 July 2026."
  ],
  "affected": "Commonwealth entities, funded companies, state and territory governments and local councils are affected.",
  "model": "GPT-6.1 (Codex)",
  "generated_at": "2026-11-10T09:14:09.933769+00:00"
 },
 "divisions": [],
 "speeches": [
  {
   "slug": "speech-829848",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2023-05-09",
   "stage_hint": null,
   "brief": "Appropriation Bill (No. 2) 2023-2024 seeks approval for $28 billion in spending, including nearly $12 billion for Defence to implement the Defence Strategic Review, close to $9 billion for climate and energy programs, and $4 billion for infrastructure projects. The bill also reduces the Advance to the Finance Minister provision to $600 million, returning it to conventional levels as COVID-19 emergency measures are wound down."
  }
