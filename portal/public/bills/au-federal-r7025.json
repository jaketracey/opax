  {
   "slug": "speech-829848",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2023-05-09",
   "stage_hint": null,
   "brief": "Appropriation Bill (No. 2) 2023-2024 seeks approval for $28 billion in spending, including nearly $12 billion for Defence to implement the Defence Strategic Review, close to $9 billion for climate and energy programs, and $4 billion for infrastructure projects. The bill also reduces the Advance to the Finance Minister provision to $600 million, returning it to conventional levels as COVID-19 emergency measures are wound down."
  }
