  {
   "slug": "speech-784801",
   "speaker": "Julia Gillard",
   "party": "Labor",
   "state": "federal",
   "date": "2008-05-14",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-784975",
   "speaker": "Nick Sherry",
   "party": "Labor",
   "state": "federal",
   "date": "2008-05-15",
   "stage_hint": null,
   "brief": "The speaker moved to have multiple bills proceed without formalities, be taken together, and read a first time, with a subsequent motion to list them separately on the Notice Paper. The motion was agreed to and the bills were read a first time."
  },
  {
   "slug": "speech-784976",
   "speaker": "Nick Sherry",
   "party": "Labor",
   "state": "federal",
   "date": "2008-05-15",
   "stage_hint": null,
   "brief": "The Higher Education Support Amendment Bill 2008 removes the Higher Education Workplace Relations Requirements and National Governance Protocols as conditions for Commonwealth Grant Scheme funding, freeing universities from red tape and supporting the abolition of Australian Workplace Agreements. The Veterans' Entitlements Legislation Amendment Bill 2008 extends income support supplement to war widows and widowers under qualifying age (benefiting about 1,400 people), extends the disability pension bereavement payment to single special rate or extreme disablement adjustment recipients, and extends automatic grant of war widow/widower/orphan pension to certain cases."
  },
  {
   "slug": "speech-786770",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2008-08-27",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-786771",
   "speaker": "Brett Mason",
   "party": "Liberal",
   "state": "federal",
   "date": "2008-08-27",
   "stage_hint": null,
   "brief": "The opposition will not oppose the bill but will move an amendment to retain the national governance protocols as a condition of increased university funding, and will oppose the entire bill if the amendment fails. The speaker argued these protocols ensure accountability for the nearly $9 billion in annual taxpayer funding to higher education."
  },
  {
   "slug": "speech-786773",
   "speaker": "John Hogg",
   "party": "PRES",
   "state": "federal",
   "date": "2008-08-27",
   "stage_hint": null,
   "brief": "The speaker argued for the removal of the Higher Education Workplace Relations Requirements and National Governance Protocols as conditions for university funding, stating they were punitive and ideologically driven rather than about accountability. The speaker supported the bill and opposed the opposition's amendments to retain these requirements."
  },
  {
   "slug": "speech-787166",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2008-09-02",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-787167",
   "speaker": "Christine Milne",
   "party": "Greens",
   "state": "federal",
   "date": "2008-09-02",
   "stage_hint": null,
   "brief": "The opposition argued that removing the National Governance Protocols would undermine accountability for $9 billion in public university funding, and that the government's retention of broader sanction powers under section 54-1 made its objection to a mandatory 7.5% penalty inconsistent."
  },
  {
   "slug": "speech-787394",
   "speaker": "Brett Mason",
   "party": "Liberal",
   "state": "federal",
   "date": "2008-09-04",
   "stage_hint": null,
   "brief": "The speaker argued that universities should continue to comply with the National Governance Protocols as a condition of funding, asserting that all universities were compliant and that the protocols protect $9 billion in public expenditure. He moved amendments to restore the requirement for compliance with the protocols."
  },
  {
   "slug": "speech-787395",
   "speaker": "Kim Carr",
   "party": "Labor",
   "state": "federal",
   "date": "2008-09-04",
   "stage_hint": null,
   "brief": null
  }
