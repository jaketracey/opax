 "speeches": [
  {
   "slug": "speech-410939",
   "speaker": "Catherine King",
   "party": "Labor",
   "state": "federal",
   "date": "2021-08-09",
   "stage_hint": null,
   "brief": "The speaker argued that the government systematically rorts taxpayer funds through programs like the Urban Congestion Fund ($4.7 billion) and car park rorts, and called for the Public Governance, Performance and Accountability Amendment (Waiver of Debt and Act of Grace Payments) Bill 2019 to require ministers to report within 30 days any decisions benefiting their own electorates or against departmental advice, with the Minister for Finance tabling reports within five sitting days."
  }
