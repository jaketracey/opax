 "speeches": [
  {
   "slug": "speech-419739",
   "speaker": "Shayne Kenneth Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2022-03-30",
   "stage_hint": null,
   "brief": "The Labor Party supports the Veterans' Affairs Legislation Amendment (Enhanced Family Support) Bill 2022, which expands eligibility for family support packages, harmonises the MRCA, DRCA and VA Acts, and implements recommendations from a veteran suicide inquiry and the Productivity Commission, effective 1 July; the speaker criticised the government for delaying the bill until just before an election."
  },
  {
   "slug": "speech-419741",
   "speaker": "Andrew Gee",
   "party": "Nationals",
   "state": "federal",
   "date": "2022-03-30",
   "stage_hint": null,
   "brief": "The Veterans' Affairs Legislation Amendment (Enhanced Family Support) Bill 2022 expands eligibility and increases financial assistance for veteran families, providing up to $12,500 over two years for at-risk families, additional payments per child, and up to $27,835 per year for widowed partners, in response to the 2017 Senate inquiry into veteran suicide and the 2019 Productivity Commission report."
  }
 ],
