  {
   "slug": "speech-786034",
   "speaker": "Nick Sherry",
   "party": "Labor",
   "state": "federal",
   "date": "2008-06-19",
   "stage_hint": null,
   "brief": "The speaker moved the second reading of three appropriation bills for 2008–2009, seeking $171 million for parliamentary departments, $60.9 billion for ordinary annual services, and $12.7 billion for other appropriations, and noted the first-time preparation of Explanatory Memoranda and new transparency tables under Operation Sunlight."
  },
  {
   "slug": "speech-786184",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2008-06-23",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-786185",
   "speaker": "Claire Moore",
   "party": "Labor",
   "state": "federal",
   "date": "2008-06-23",
   "stage_hint": null,
   "brief": "The speaker announced the Rudd government's first budget includes $15 million over three years for CanTeen youth cancer networks, $15 million over three years for independent clinical trials, $50 million over three years for a Comprehensive Cancer Centre at Royal Prince Alfred Hospital, $15 million over five years for two prostate cancer research centres, $15 million over two years for a children's cancer centre at Adelaide's Women's and Children's Hospital, $15 million for the Olivia Newton-John Cancer Centre at Austin Hospital, $5.1 million over three years for the National Centre for Gynaecological Cancers, $12 million over four years for the McGrath Foundation to employ breast cancer nurses, $31 million over four years for external breast prosthesis reimbursements, and $87.4 million over three years to expand the National Bowel Cancer Screening Program."
  },
  {
   "slug": "speech-786596",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2008-06-26",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-786597",
   "speaker": "Julian McGauran",
   "party": "Nationals",
   "state": "federal",
   "date": "2008-06-26",
   "stage_hint": null,
   "brief": "A senator argued for a disallowance motion to end Medicare funding for second-trimester abortions, claiming late-term abortions involve viable babies and methods such as partial birth abortion performed by Dr David Grundmann. The senator also criticised the 2008 Labor budget for increasing inflation, pushing 500,000 people out of private health cover, cutting $436 million from regional programs, and harming rural Australia."
  },
  {
   "slug": "speech-786604",
   "speaker": "Kerry O'Brien",
   "party": "Labor",
   "state": "federal",
   "date": "2008-06-26",
   "stage_hint": null,
   "brief": "The Rudd Labor Government's first budget included a $55 billion Working Families Support Package, $40 billion in new infrastructure, education and health funds, and $2.3 billion for climate change, while arguing it would reduce inflationary spending and deliver on election commitments. The speaker also criticised the previous government for neglect and urged the opposition to stop blocking budget measures."
  }
