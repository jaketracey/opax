 "speeches": [
  {
   "slug": "speech-312232",
   "speaker": "Josh Frydenberg",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-06-04",
   "stage_hint": null,
   "brief": "The Tax and Superannuation Laws Amendment (Medicare Levy and Medicare Levy Surcharge) Bill 2015 increases Medicare levy low-income thresholds for 2014-15 and future years, with singles exempt below $20,896, single seniors and pensioners below $33,044, families below $35,261 plus $3,238 per child, and senior couples below $46,000 (unchanged). The threshold for senior couples was not raised as it remains sufficient."
  }
 ],
