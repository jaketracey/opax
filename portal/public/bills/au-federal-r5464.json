 "speeches": [
  {
   "slug": "speech-310803",
   "speaker": "Michael Keenan",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-05-27",
   "stage_hint": null,
   "brief": "The Crimes Legislation Amendment (Penalty Unit) Bill 2015 increases the Commonwealth penalty unit from $170 to $180, effective 31 July 2015, with indexation every three years based on the CPI starting 1 July 2018, to maintain the deterrent effect of financial penalties for all Commonwealth offences."
  },
  {
   "slug": "speech-312716",
   "speaker": "Graham Perrett",
   "party": "Labor",
   "state": "federal",
   "date": "2015-06-15",
   "stage_hint": null,
   "brief": "The speaker argued in favour of the Crimes Legislation Amendment (Penalty Unit) Bill 2015, which increases the Commonwealth penalty unit from $170 to $180 effective 31 July 2015 and introduces automatic indexation every three years according to the CPI, with the first adjustment on 1 July 2018. Labor supported the bill as a non-controversial measure to keep financial penalties in line with inflation and maintain their deterrent effect."
  },
  {
   "slug": "speech-312717",
   "speaker": "Michael Keenan",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-06-15",
   "stage_hint": null,
   "brief": "The bill increases the Commonwealth penalty unit from $170 to $180 and introduces automatic indexation every three years based on the consumer price index, starting in 2018, to keep penalties in line with inflation."
  }
 ],
