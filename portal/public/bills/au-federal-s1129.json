 "speeches": [
  {
   "slug": "speech-368472",
   "speaker": "Adam Bandt",
   "party": "Greens",
   "state": "federal",
   "date": "2018-09-10",
   "stage_hint": null,
   "brief": "The Animal Export Legislation Amendment (Ending Long-Haul Live Sheep Exports) Bill 2018, which passed the Senate co-sponsored by Senators Rhiannon, Hinch and Storer, would restrict the live sheep trade during certain months of the year; the speaker urged the House to debate and pass the bill immediately, warning that failure to vote for the opposition amendment would allow the government to delay it indefinitely."
  }
