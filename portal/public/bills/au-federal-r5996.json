 "speeches": [
  {
   "slug": "speech-355371",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-10-19",
   "stage_hint": null,
   "brief": "The bill replaces the former exploration development incentive with a $100 million junior minerals exploration incentive over four years from 2017-18, providing refundable tax offsets to investors in small exploration companies to address a 70% decline in greenfields exploration expenditure and the lack of a world-class mineral discovery in over 20 years."
  },
  {
   "slug": "speech-359198",
   "speaker": "Craig Kelly",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-02-13",
   "stage_hint": null,
   "brief": "The speaker argued that the Treasury Laws Amendment (Junior Minerals Exploration Incentive) Bill 2017 supports job growth, citing 400,000 new jobs in the past year (300,000 full-time) and record coal exports of $56.5 billion in 2017. They criticised Labor's anti-coal rhetoric and the National Australia Bank’s refusal to finance new thermal coal projects, urging support for the mining sector as essential for funding schools, hospitals and other services."
  }
