 "speeches": [
  {
   "slug": "speech-376607",
   "speaker": "Linda Burney",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": "The speaker announced Labor's opposition to the national rollout of the cashless debit card, but supported extending existing trials in Ceduna, East Kimberley, and Goldfields until June 2020 to avoid disruption. Labor will move an amendment allowing people to leave the card if they demonstrate responsible financial management, and criticised the government for relying on the flawed ORIMA evaluation."
  },
  {
   "slug": "speech-376610",
   "speaker": "Steve Irons",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": "The bill extends the cashless debit card program in Ceduna, East Kimberley, and Goldfields, and income management in Cape York, for one year until 30 June 2020, citing reductions in alcohol, drug, and gambling abuse. The member for Grey was thanked for his support of the Ceduna trial site."
  },
  {
   "slug": "speech-376964",
   "speaker": "Emma McBride",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-04",
   "stage_hint": null,
   "brief": "The speaker argued that the cashless debit card rollout is unfair and lacks evidence, and supported Labor’s amendments—accepted by the government—to allow participants to opt out, calling for community‑controlled, evidence‑based approaches."
  }
 ],
