 "speeches": [
  {
   "slug": "speech-311075",
   "speaker": "Bruce Billson",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-05-28",
   "stage_hint": null,
   "brief": "The speaker introduced the Judiciary Amendment Bill 2015 to consolidate the Australian Government Solicitor (AGS) into the Attorney-General’s Department, a reform announced in the 2014-15 Mid-Year Economic and Fiscal Outlook to reduce the number of government bodies by 251 since the last election. AGS will retain its name and independent brand within the department, and the secretary will conduct a review of legal services to identify efficiencies."
  },
  {
   "slug": "speech-311077",
   "speaker": "Bruce Billson",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-05-28",
   "stage_hint": null,
   "brief": "The Judiciary Amendment Bill 2015 supports consolidating the Australian Government Solicitor into the Attorney-General’s Department, with the AGS retaining its name and independent identity rather than being abolished. The government argues this will create a stronger, unified department providing high-quality strategic legal advice to the Attorney-General and the government."
  }
 ],
