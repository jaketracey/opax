 "speeches": [
  {
   "slug": "speech-411337",
   "speaker": "Ben Morton",
   "party": "Liberal",
   "state": "federal",
   "date": "2021-08-12",
   "stage_hint": null,
   "brief": "The Electoral Legislation Amendment (Electoral Offences and Preventing Multiple Voting) Bill 2021 introduces a 'designated elector' category to prevent multiple voting, requiring suspected repeat voters to cast declaration votes, and increases the penalty for interference with political liberty from six months imprisonment or 10 penalty units to three years imprisonment or 100 penalty units."
  },
  {
   "slug": "speech-411837",
   "speaker": "Andrew Giles",
   "party": "Labor",
   "state": "federal",
   "date": "2021-08-25",
   "stage_hint": null,
   "brief": "Labor supported the three electoral bills, but moved an amendment calling for more resources to address the Northern Territory's 85% enrolment rate, while also backing the shortened prepoll period to 12 days, a higher party membership threshold of 1,500, and new measures against multiple voting and electoral violence."
  }
 ],
