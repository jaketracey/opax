 "speeches": [
  {
   "slug": "speech-308256",
   "speaker": "Andrew Nikolic",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-03-19",
   "stage_hint": null,
   "brief": "The Limitation of Liability for Maritime Claims Amendment Bill 2015 aims to keep international shipping economically viable by increasing liability limits for shipowners and salvors. The speaker highlighted $203 million in federal funding for an enhanced Tasmanian Freight Equalisation Scheme from 2016, including $700 per container and a 15% loading for King Island and Furneaux Group shippers, and argued that Labor’s 2012 Coastal Trading Act caused a 63% freight rate increase at Bell Bay Aluminium, threatening its viability and jobs."
  },
  {
   "slug": "speech-308262",
   "speaker": "Andrew Nikolic",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-03-19",
   "stage_hint": null,
   "brief": "The speaker defended the claim that Labor's 2012 Coastal Shipping Act caused a 63% increase in freight rates for Bell Bay Aluminium, citing the company's own submissions to the Productivity Commission."
  }
 ],
