   "brief": null
  },
  {
   "slug": "speech-801371",
   "speaker": "Kim Carr",
   "party": "Labor",
   "state": "federal",
   "date": "2010-06-22",
   "stage_hint": null,
   "brief": "Introduced multiple bills together and moved to have them listed separately on the Notice Paper after debate adjournment. The bills proceeded without formalities and were read a first time."
  },
  {
   "slug": "speech-801372",
   "speaker": "Kim Carr",
   "party": "Labor",
   "state": "federal",
   "date": "2010-06-22",
   "stage_hint": null,
   "brief": "The speaker tabled a revised explanatory memorandum for the Corporations Amendment (Corporate Reporting Reform) Bill 2010 and moved that several bills be read a second time, including appropriation bills totalling $222.1 million for parliamentary departments, $71.9 billion for ordinary annual services, and $9.54 billion for other services. The speaker also introduced bills to reform corporate reporting for companies limited by guarantee, enhance APRA's prudential powers, establish a Continence Aids Payment Scheme, amend GST administration, and reform governance of Norfolk Island."
  },
  {
   "slug": "speech-801674",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2010-06-24",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-801675",
   "speaker": "Steve Fielding",
   "party": "Family First",
   "state": "federal",
   "date": "2010-06-24",
   "stage_hint": null,
   "brief": "The appropriation bills were condemned for funding a $30 million-plus advertising campaign for the mining tax (RSPT) and for a budget built on accounting tricks, with the speaker citing a $57.1 billion deficit and scrapped mining projects. The speaker supported Senator Fielding's amendment to stop such political advertising and argued the Labor government was unfit to govern."
  },
  {
   "slug": "speech-801676",
   "speaker": "Steve Fielding",
   "party": "Family First",
   "state": "federal",
   "date": "2010-06-24",
   "stage_hint": null,
   "brief": "The speaker moved amendments to prohibit spending from the appropriation bill on any advertising or public information campaign for the resources super profit tax announced on 2 May 2010, and to reduce the Treasury portfolio vote by $30.61 million for tax reform communication. He argued this would hold the Labor government to its commitment and prevent taxpayer money from funding party policy or election campaigning."
  },
  {
   "slug": "speech-801677",
   "speaker": "Mark Arbib",
   "party": "Labor",
   "state": "federal",
   "date": "2010-06-24",
   "stage_hint": null,
   "brief": null
  }
