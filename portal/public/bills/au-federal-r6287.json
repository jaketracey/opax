 "speeches": [
  {
   "slug": "speech-376655",
   "speaker": "Madeleine King",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-03",
   "stage_hint": null,
   "brief": "The Labor shadow minister argued in support of the Australian Business Securitisation Fund Bill 2019, which establishes a $2 billion fund to increase SME access to finance through securitisation, while criticising the government for raising the instant asset write-off to $30,000 after already debating a $25,000 increase, calling it \"policy on the run.\" They also highlighted ongoing SME challenges including housing affordability, financial literacy gaps, and connectivity, and announced Labor's commitment to an NBN service guarantee if elected."
  },
  {
   "slug": "speech-376663",
   "speaker": "Stuart Robert",
   "party": "LNP",
   "state": "federal",
   "date": "2019-04-03",
   "stage_hint": null,
   "brief": "The $2 billion Australian Business Securitisation Fund Bill 2019 will enhance SME access to debt finance by improving small lenders' access to the securitisation market, targeting the 80% of SME loans currently held by major banks. The fund will invest in securitisations backed by business loans under $5 million, with reviews after two and five years to assess effectiveness."
  }
 ],
