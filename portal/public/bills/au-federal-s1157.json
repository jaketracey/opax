  },
  {
   "slug": "speech-376435",
   "speaker": "Ken Wyatt",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-02-21",
   "stage_hint": null,
   "brief": "The Aboriginal Land Rights (Northern Territory) Amendment (Land Scheduling) Bill 2018 adds approximately 3,105 hectares of land from a successful native title application in Central Australia to schedule 1 of the Act, granting it as Aboriginal land, and delivers on an agreement involving Ammaroo Station, the pastoralist, and native title holders, supported by an additional $1 million for the Aboriginal Land Commissioner."
  },
  {
   "slug": "speech-376436",
   "speaker": "Luke Gosling",
   "party": "Labor",
   "state": "federal",
   "date": "2019-02-21",
   "stage_hint": null,
   "brief": "The speaker announced Labor's support for the Aboriginal Land Rights (Northern Territory) Amendment (Land Scheduling) Bill 2018, which adds approximately 193 square kilometres near Ammaroo Station to be granted as Aboriginal land, and acknowledged the member for Lingiari's advocacy for the bill."
  },
  {
   "slug": "speech-376438",
   "speaker": "Ken Wyatt",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-02-21",
   "stage_hint": null,
   "brief": "The bill adds land from a successful native title application in Central Australia to schedule 1 of the Aboriginal Land Rights (Northern Territory) Act, consistent with the Amaroo Indigenous Land Use Agreement, to enable a native title settlement agreed between traditional owners and local stakeholders. The coalition government is investing in the Aboriginal Land Commissioner, land councils and Territory stakeholders to resolve outstanding land claims and support land tenure reforms."
  }
 ],
