  {
   "slug": "speech-823180",
   "speaker": "Joe Ludwig",
   "party": "Labor",
   "state": "federal",
   "date": "2013-05-14",
   "stage_hint": null,
   "brief": "The Superannuation Legislation Amendment (Reform of Self Managed Superannuation Funds Supervisory Levy Arrangements) Bill 2013 increases the maximum SMSF supervisory levy from $200 to $300 per year, with an actual levy of $259 from 2013-14, and changes collection timing so the levy is paid in the same financial year, phased in over two years, to fully recover the ATO's regulatory costs for the growing SMSF sector (478,000 funds as of June 2012, up 27% since 2008)."
  },
  {
   "slug": "speech-823480",
   "speaker": "Mathias Cormann",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-05-16",
   "stage_hint": null,
   "brief": "The Coalition criticised the Superannuation Legislation Amendment (Reform of Self Managed Superannuation Funds Supervisory Levy Arrangements) Bill 2013 as an Orwellian Labor cash grab and blamed Treasurer Wayne Swan's fiscal mismanagement, but nonetheless chose not to oppose the bill."
  }
 ],
