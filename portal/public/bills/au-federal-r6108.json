 "divisions": [],
 "speeches": [
  {
   "slug": "speech-361939",
   "speaker": "David Coleman",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-05-08",
   "stage_hint": null,
   "brief": "The bill seeks approval for $13 billion in appropriations, including $5 billion for NBN Co., $3 billion for Defence equipment and facilities, and $2.4 billion for infrastructure projects such as Western Sydney Airport, Inland Rail, and WestConnex stage 2."
  },
  {
   "slug": "speech-361940",
   "speaker": "David Coleman",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-05-08",
   "stage_hint": null,
   "brief": "The Appropriation (Parliamentary Departments) Bill (No. 1) 2018-2019 was moved for a second reading, seeking just under $250 million for four parliamentary departments, including $193 million for the Department of Parliamentary Services with $2.9 million allocated to establish a Cyber Security Operations Centre for Australian Parliament House."
  },
  {
   "slug": "speech-362517",
   "speaker": "Nola Marino",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-05-21",
   "stage_hint": null,
   "brief": "The speaker announced that unless otherwise ordered, five appropriation bills would be referred to the Federation Chamber for further consideration at the adjournment of the House."
  },
  {
   "slug": "speech-362672",
   "speaker": "Trevor Evans",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-05-21",
   "stage_hint": null,
   "brief": "The budget delivers tax relief for over 75,000 people in Brisbane, a record $75 billion national infrastructure pipeline with over $20 billion for Queensland projects including the Brisbane Metro, and $1.3 billion for a National Health and Medical Industry Growth Plan, while contrasting Labor’s commitment to retaining a 49 per cent top marginal tax rate."
  },
  {
   "slug": "speech-363002",
   "speaker": "Jason Falinski",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-05-22",
   "stage_hint": null,
   "brief": "The speaker argued that the coalition government has delivered smaller government and greater equality of opportunity, citing over 21 community grants secured for Mackellar, including $10,000 for The Burdekin Association's youth hub, funding for the Davidson Rural Fire Brigade station upgrade, new computer equipment for the Tibetan Community in Australia, and a new vehicle for Easylink."
  },
  {
   "slug": "speech-363913",
   "speaker": "David Coleman",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-05-30",
   "stage_hint": null,
   "brief": "The speaker announced total appropriations of just under $108.5 billion for the 2018-19 financial year and just under $8 billion in supplementary appropriations, including $6.5 billion for the Department of the Environment and Energy—$6 billion for purchasing New South Wales and Victorian government shares in Snowy Hydro Limited and under $435 million for the Reef 2050 Long Term Sustainability Plan."
  }
 ],
