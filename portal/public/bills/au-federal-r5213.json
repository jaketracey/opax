 "summary": null,
 "divisions": [],
 "speeches": [
  {
   "slug": "speech-287393",
   "speaker": "Warren Truss",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-03-27",
   "stage_hint": null,
   "brief": "Introduced a bill allowing Western Australia to repay early the $1.6 million outstanding balance of a 1961 Commonwealth loan for the Kalgoorlie-Perth railway standardisation, which was not otherwise due until 2041."
  },
  {
   "slug": "speech-289429",
   "speaker": "Steve Irons",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-05-28",
   "stage_hint": null,
   "brief": "Defended the Railway Agreement bill allowing Western Australia to repay its $1.6 million outstanding rail loan early, noting the original 1961 standardisation project cut Kalgoorlie-Perth freight times from 31 to 13 hours, and highlighted the 2014 budget's $3.6 billion total rail investment, while the Commonwealth forgoes up to $300,000 in interest by allowing early repayment."
  },
  {
   "slug": "speech-289437",
   "speaker": "Alannah MacTiernan",
   "party": "Labor",
   "state": "federal",
   "date": "2014-05-28",
   "stage_hint": null,
   "brief": "Confirmed Labor's support for the Railway Agreement (Western Australia) Amendment Bill 2014, noting railways were central to Western Australia's decision to join the Commonwealth."
  },
  {
   "slug": "speech-289445",
   "speaker": "Tim Watts",
   "party": "Labor",
   "state": "federal",
   "date": "2014-05-28",
   "stage_hint": null,
   "brief": "Explained that the bill fixes an administrative loophole in a 1961 federal loan for the Perth-Kalgoorlie standard gauge railway, which under current law could not be fully repaid until 2041, by letting Western Australia repay early."
  },
  {
   "slug": "speech-289448",
   "speaker": "Craig Kelly",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-05-28",
   "stage_hint": null,
   "brief": "Argued that shifting freight from road to rail would worsen air pollution, citing Parliamentary Library figures that diesel locomotives emit 20 times more particulate matter per litre than modern truck engines, and said Liverpool's air already exceeds World Health Organization standards, recording 21.1 micrograms per cubic metre of PM10 against a 20 microgram standard."
  },
  {
   "slug": "speech-289449",
   "speaker": "Warren Truss",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-05-28",
   "stage_hint": null,
   "brief": "Supported the bill and opposed Labor's amendment, said states have committed or recommitted to over $25 billion in public transport projects since the coalition took office, citing examples including the $8.3 billion North West Rail Link in New South Wales and an $8 billion to $11 billion Melbourne rail link."
  }
 ],
