 "speeches": [
  {
   "slug": "speech-345194",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-03-30",
   "stage_hint": null,
   "brief": "The ASIC Supervisory Cost Recovery Levy (Consequential Amendments) Bill 2017 introduces an industry funding model for ASIC, requiring annual publication of regulatory costs and empowering ASIC to take administrative action against entities that fail to pay levies or penalties within a year. The bill also abolishes the existing market supervision cost recovery regime from 1 July 2017."
  }
