 "speeches": [
  {
   "slug": "speech-345191",
   "speaker": "Angus Taylor",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-03-30",
   "stage_hint": null,
   "brief": "The bill amends legislation in the Prime Minister and Cabinet and Indigenous Affairs portfolios, including allowing the Commonwealth to waive consent for Indigenous organisations to dispose of land interests, streamlining reporting for Indigenous Business Australia, repealing two redundant acts, and amending the Royal Commissions Act 1902 to allow commissions to require written statements and increase penalties for non-compliance."
  },
  {
   "slug": "speech-350605",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2017-08-08",
   "stage_hint": null,
   "brief": "Labor supported the bill, which allows consenting authorities to waive consent for disposal of up to 4,500 Indigenous-held assets, and increases royal commission penalties to two years imprisonment or $25,200, but argued that the second reading speech and consultation were inadequate for protecting public investment. The speaker also criticised the $25 million Hanger royal commission as worthless and renewed calls for a royal commission into banks."
  },
  {
   "slug": "speech-350606",
   "speaker": "Angus Taylor",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-08-08",
   "stage_hint": null,
   "brief": "The bill amends several acts to reduce red tape for Indigenous land management, streamline reporting requirements, repeal redundant legislation, align Auditor-General annual reporting with parliament, and amend the Royal Commissions Act. Key changes include allowing the Commonwealth to waive consent over certain Indigenous land assets and removing the requirement to table Indigenous Business Australia corporate plans."
  }
 ],
