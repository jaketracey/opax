 "speeches": [
  {
   "slug": "speech-826997",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2023-02-07",
   "stage_hint": null,
   "brief": "Several bills were referred to the Federation Chamber for further consideration, including amendments to private health insurance, therapeutic goods, and export control legislation."
  },
  {
   "slug": "speech-826999",
   "speaker": "Julian Leeser",
   "party": "Liberal",
   "state": "federal",
   "date": "2023-02-07",
   "stage_hint": null,
   "brief": "The Coalition argued for three bills to modernise the Prostheses List, which sets minimum insurers’ payments for surgical implants, and allocated $22 million over four years to lower medical device costs and improve private health insurance affordability. The speaker criticised the Albanese Labor government for lacking transparency by leaving key details like eligibility criteria and cost recovery specifications to unsighted subordinate legislation."
  },
  {
   "slug": "speech-827066",
   "speaker": "Mike Freelander",
   "party": "Labor",
   "state": "federal",
   "date": "2023-02-07",
   "stage_hint": null,
   "brief": "The package of three bills modernises the Private Health Insurance Prostheses List to improve transparency and reduce costs for implantable medical devices, with hip replacements costing over $4,000 in Australia compared to under $2,000 in the UK and New Zealand. The reforms aim to lower private health insurance premiums by reducing device costs and updating cost recovery arrangements."
  }
 ],
