 "speeches": [
  {
   "slug": "speech-1205694",
   "speaker": "Kevin Hogan",
   "party": "Nationals",
   "state": "federal",
   "date": "2026-08-19",
   "stage_hint": null,
   "brief": "Speaking on the Treasury Laws Amendment (Strengthening Accountability for Tax Adviser Misconduct and Other Measures) Bill 2026, the Nationals speaker said the Coalition would not oppose the bill in the House but wants it referred to the Senate Economics Legislation Committee, warning new capital gains tax rules on foreign investment, offset by a discount for renewable projects only, could threaten the viability of major projects like the $6 billion Karratha ammonia urea plant and a proposed oil refinery. He supported other schedules including strengthened Tax Practitioners Board penalties of up to $18 million and merger law and philanthropy provisions."
  },
  {
   "slug": "speech-1205813",
   "speaker": "Tom French",
   "party": "Labor",
   "state": "federal",
   "date": "2026-08-20",
   "stage_hint": null,
   "brief": "Introducing the Treasury Laws Amendment (Strengthening Accountability for Tax Adviser Misconduct and Other Measures) Bill 2026, the speaker said it strengthens the Tax Practitioners Board's enforcement powers following the PwC leaks scandal, doubling the maximum ban period for serious misconduct from five to ten years, and clarifies foreign resident capital gains tax rules for assets connected to Australian land and resources, including a $50 million notification threshold. The bill also reforms the merger regime so unnotified transactions become voidable rather than automatically void, extends deductible gift recipient status to several charities, and originally proposed a 50 per cent capital gains tax discount for foreign renewable energy investors until 2030."
  }
 ],
