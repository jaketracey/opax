  {
   "slug": "speech-823507",
   "speaker": "Penny Wong",
   "party": "Labor",
   "state": "federal",
   "date": "2013-05-16",
   "stage_hint": null,
   "brief": "The Court Security Bill 2013 and companion bill replace the outdated 1971 Public Order Act, granting federal courts and tribunals new powers for security officers—including screening, search, and limited use of force—with safeguards such as licensing, training, and Commonwealth Ombudsman oversight."
  },
  {
   "slug": "speech-824733",
   "speaker": "Gary Humphries",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-06-20",
   "stage_hint": null,
   "brief": "The coalition supported the Court Security Bill 2013 and associated bill, which expand security powers for Commonwealth courts and tribunals, including the Family Court of Western Australia and the Administrative Appeals Tribunal, to address modern security concerns raised by federal court heads."
  }
 ],
