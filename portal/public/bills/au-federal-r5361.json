 "speeches": [
  {
   "slug": "speech-299704",
   "speaker": "Josh Frydenberg",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-10-22",
   "stage_hint": null,
   "brief": "Moved the second reading of the Amending Acts 1970 to 1979 Repeal Bill 2014, which repeals 656 spent amending and repeal acts from that decade for a compliance cost saving of $100,000, building on an earlier bill that repealed more than 1,000 amending acts from 1901 to 1969."
  },
  {
   "slug": "speech-300910",
   "speaker": "Josh Frydenberg",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-10-29",
   "stage_hint": null,
   "brief": "Moved to suspend standing orders so debate, amendments and votes on the Omnibus Repeal Day (Spring 2014) Bill 2014, the Amending Acts 1970 to 1979 Repeal Bill 2014 and the Statute Law Revision Bill (No. 2) 2014 could be managed together, saying deregulation and cutting red tape were a priority for the government."
  },
  {
   "slug": "speech-300939",
   "speaker": "Shayne Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2014-10-29",
   "stage_hint": null,
   "brief": "Criticised the three repeal bills for delivering only $1.855 million in total savings, the largest single item being $1.16 million from aged care notification changes, contrasted this with Labor's Seamless National Economy reforms estimated to save $4 billion a year, and raised concerns that changes to the Stronger Futures in the Northern Territory Act would remove a requirement for independent review of alcohol management laws."
  },
  {
   "slug": "speech-300963",
   "speaker": "Lisa Chesters",
   "party": "Labor",
   "state": "federal",
   "date": "2014-10-29",
   "stage_hint": null,
   "brief": "Argued that the Omnibus Repeal Day bill and related statute law revision bills are being used to sneak through the resumption of fuel excise indexation without proper debate, noting the increase and the start of prepolling for the Victorian state election will both occur in 12 days."
  },
  {
   "slug": "speech-301172",
   "speaker": "Josh Frydenberg",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-10-29",
   "stage_hint": null,
   "brief": "Argued that the government's repeal day bills would deliver $2.1 billion in compliance savings and abolish bodies including the Fishing Industry Policy Council, and criticised Labor for introducing 21000 additional regulations while doing nothing to streamline schemes such as Comcare or the Do Not Call Register."
  }
 ],
