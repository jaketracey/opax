 "speeches": [
  {
   "slug": "speech-352750",
   "speaker": "Chris Bowen",
   "party": "Labor",
   "state": "federal",
   "date": "2017-09-05",
   "stage_hint": null,
   "brief": "The opposition supported the International Monetary Agreements Amendment (New Arrangements to Borrow) Bill 2017, which renews Australia’s lending commitment to the IMF under the New Arrangements to Borrow (NAB) for five years from 17 November 2017 to 16 November 2022, with a maximum commitment of SDR 2.22 billion (approximately A$4.05 billion). The speaker argued the bill is timely and pressing, facilitating expeditious passage, and noted it has no direct budget impact but represents a contingent liability."
