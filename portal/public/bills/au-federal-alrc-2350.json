 "speeches": [
  {
   "slug": "speech-270238",
   "speaker": "David Bradbury",
   "party": "Labor",
   "state": "federal",
   "date": "2013-03-13",
   "stage_hint": null,
   "brief": "Introduced the Financial Framework Legislation Amendment Bill (No. 2), amending five acts to authorise Commonwealth participation in companies following the High Court's Williams v Commonwealth decision, and to allow deferred tax asset relief for the Commonwealth Superannuation Corporation over a May 2012 transfer of military superannuation assets."
  },
  {
   "slug": "speech-822295",
   "speaker": "David Bradbury",
   "party": "Labor",
   "state": "federal",
   "date": "2013-03-13",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-271361",
   "speaker": "Joel Fitzgibbon",
   "party": "Labor",
   "state": "federal",
   "date": "2013-03-20",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-271578",
   "speaker": "Andrew Robb",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-03-20",
   "stage_hint": null,
   "brief": "Argued that the bill makes necessary, non-controversial amendments across five acts and three portfolios, including authorising Commonwealth participation in companies, addressing overpayments, and transferring tax losses to the ARIA Investments Trust. Supported the bill but criticised rushed legislative changes and uncertainty for investment."
  },
  {
   "slug": "speech-271579",
   "speaker": "David Bradbury",
   "party": "Labor",
   "state": "federal",
   "date": "2013-03-20",
   "stage_hint": null,
   "brief": "Explained that the bill amends five acts across three portfolios, authorises Commonwealth participation in companies, establishes a framework for certain technical overpayments, and provides deferred tax asset relief for the Commonwealth Superannuation Corporation. Commended the bill to the House."
  },
  {
   "slug": "speech-822823",
