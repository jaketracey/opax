   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-773448",
   "speaker": "Chris Ellison",
   "party": "Liberal",
   "state": "federal",
   "date": "2006-06-21",
   "stage_hint": null,
   "brief": "The speaker moved to introduce several appropriation bills for 2005-2006 and 2006-2007, seeking a total of approximately $53.3 billion for ordinary annual services, $9.2 billion for other services, and $3.6 billion in supplementary additional estimates."
  },
  {
   "slug": "speech-773643",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2006-06-22",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-773644",
   "speaker": "Andrew Murray",
   "party": "Australian Democrats",
   "state": "federal",
   "date": "2006-06-22",
   "stage_hint": null,
   "brief": "The speaker argued for improved accountability in appropriation bills, noting that the Finance Minister can increase spending by up to $20 million per departmental item and $175 million in total without disallowable oversight, and proposed amendments for better reporting of Advance Ministerial Funds and controls on government advertising. The speech also detailed specific funding allocations, including $53 billion in Appropriation Bill No.1, $9.215 billion in Bill No.2, $500 million to the Murray-Darling Basin Commission, and $310.4 million for Cyclone Larry relief."
  },
  {
   "slug": "speech-773645",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2006-06-22",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-773646",
   "speaker": "Andrew Murray",
   "party": "Australian Democrats",
   "state": "federal",
   "date": "2006-06-22",
   "stage_hint": null,
   "brief": "Senators Murray and Stephens moved amendments requiring that any finance minister determination under the appropriation bills be tabled in Parliament within three sitting days with a statement of reasons, including purpose, objects and expected outcomes, arguing this would improve transparency and accountability for spending decisions. They also moved an amendment requiring that any advertising or public information project costing $100,000 or more receive Auditor-General certification that it conforms with existing Audit and JCPAA guidelines, arguing that government advertising had been used for blatantly political purposes and was a corrupt abuse of taxpayers' funds. The government opposed both amendments, arguing the first was unnecessary due to existing tabling requirements and the second was inappropriate for appropriation legislation, and both were negatived."
  }
