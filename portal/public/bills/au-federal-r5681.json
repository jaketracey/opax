 "speeches": [
  {
   "slug": "speech-334855",
   "speaker": "Andrew Leigh",
   "party": "Labor",
   "state": "federal",
   "date": "2016-10-12",
   "stage_hint": null,
   "brief": "Labor supported the International Tax Agreements Amendment Bill 2016, which ratifies the Australia-Germany tax treaty, but moved an amendment criticising the government for failing to close tax loopholes and increase transparency. The opposition argued the government backed down on thin capitalisation reforms, raised the tax transparency threshold from $100 million to $200 million, and has not established a beneficial ownership registry."
  },
  {
   "slug": "speech-335048",
   "speaker": "Tony Smith",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-10-12",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-335050",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-10-12",
   "stage_hint": null,
   "brief": "The speaker moved to suspend standing orders to immediately restore the International Tax Agreements Amendment Bill 2016 and resume proceedings for its second reading."
  },
  {
   "slug": "speech-335051",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-10-12",
   "stage_hint": null,
   "brief": "An inadvertent House error was acknowledged, with the speaker noting both sides support the International Tax Agreements Amendment Bill 2016 and moving to suspend standing orders to restore the bill and resume its second reading."
  },
  {
   "slug": "speech-335185",
   "speaker": "Chris Bowen",
   "party": "Labor",
   "state": "federal",
   "date": "2016-10-13",
   "stage_hint": null,
   "brief": "The minister was absent when the International Tax Agreements Amendment Bill passed, affecting dividend taxation; the speaker asked what the change to the tax treatment of effective dividends will be."
  }
 ],
