  {
   "slug": "speech-822426",
   "speaker": "Mark Furner",
   "party": "Labor",
   "state": "federal",
   "date": "2013-03-13",
   "stage_hint": null,
   "brief": "Three bills—the Australian Capital Territory (Self-Government) Amendment Bill 2013, the Higher Education Support Amendment (Further Streamlining and Other Measures) Bill 2013, and the Royal Commissions Amendment Bill 2013—were introduced together, with a motion to proceed without formalities and be read a first time agreed to."
  },
  {
   "slug": "speech-823052",
   "speaker": "Fiona Nash",
   "party": "Nationals",
   "state": "federal",
   "date": "2013-03-21",
   "stage_hint": null,
   "brief": "The coalition supported the bill, which introduced recommendations from a 2011 review of VET FEE-HELP to reduce administrative complexity and increase provider numbers. The Greens supported the bill but opposed shifting VET costs to students via income-contingent loans and the commercialisation of the VET sector."
  }
