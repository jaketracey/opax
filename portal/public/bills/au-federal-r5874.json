 "speeches": [
  {
   "slug": "speech-349777",
   "speaker": "Jenny Macklin",
   "party": "Labor",
   "state": "federal",
   "date": "2017-06-20",
   "stage_hint": null,
   "brief": "Labor will support the Social Services Legislation Amendment (Queensland Commission Income Management Regime) Bill 2017, which extends income management in Aurukun, Coen, Hope Vale, Mossman Gorge and Doomadgee for two years, citing local community support for the measure. The speech also criticised the rushed legislative process and called for an updated independent evaluation of the Cape York welfare reform."
  },
  {
   "slug": "speech-349780",
   "speaker": "Paul Fletcher",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-06-20",
   "stage_hint": null,
   "brief": "The bill extends the income management element of Cape York Welfare Reform for two years until 30 June 2019, covering the communities of Aurukun, Coen, Hope Vale, Mossman Gorge and Doomadgee, where 196 people are currently on income management. The extension aligns with the broader income management program's end date and was agreed with the Queensland government and the Cape York Partnership."
  }
 ],
