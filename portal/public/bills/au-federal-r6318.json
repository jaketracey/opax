 "divisions": [],
 "speeches": [
  {
   "slug": "speech-376572",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": "The Supply (Parliamentary Departments) Bill (No. 1) 2019-2020 seeks just over $101 million in interim appropriations for the Department of the Senate, Department of the House of Representatives, Department of Parliamentary Services, and Parliamentary Budget Office to fund operations until the end of November 2019. The bill must be passed to ensure continuity of parliament’s operations from 1 July 2019."
  },
  {
   "slug": "speech-376573",
   "speaker": "Matt Thistlethwaite",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": "The coalition proposed supply bills for 2019-20, which Labor will not block. The speaker argued the government cut $715 million from Medicare, $5 billion from education, and gave $80 billion in tax cuts to high-income earners, while debt reached $534.2 billion, and Labor's Fair Go Action Plan includes making multinationals pay fair tax and restoring penalty rates."
  }
