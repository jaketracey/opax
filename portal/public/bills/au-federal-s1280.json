 "speeches": [
  {
   "slug": "speech-400795",
   "speaker": "Trevor Evans",
   "party": "LNP",
   "state": "federal",
   "date": "2020-12-09",
   "stage_hint": null,
   "brief": "The government introduced the Electoral Amendment (Territory Representation) Bill 2020 to preserve two seats for the Northern Territory in the House of Representatives at the next election, overriding an Electoral Commissioner's determination that would have reduced it to one seat. The bill adopts a harmonic mean method for allocating seats to territories, lowering the quota needed for a second seat to 1.3333 and a third to 2.4, and treats both the Northern Territory and the Australian Capital Territory equally to avoid constitutional risks."
  },
  {
   "slug": "speech-400797",
   "speaker": "James Stevens",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-12-09",
   "stage_hint": null,
   "brief": "The speaker argued that reducing the Northern Territory’s House of Representatives representation from two members to one would be outrageous and endorsed the bill’s formula change to prevent that outcome, while affirming the principle of one vote, one value."
  },
  {
   "slug": "speech-400799",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2020-12-09",
   "stage_hint": null,
   "brief": "The speaker argued that the Electoral Amendment (Territory Representation) Bill 2020 is necessary to ensure fair representation for Northern Territory Australians, who risk being marginalised under a strict one-vote-one-value system. He named the member for Solomon, the member for Lingiari, and Malarndirri McCarthy as bipartisan supporters, and stated that Tasmania’s five seats set a precedent for protecting regional voices."
  },
  {
   "slug": "speech-400800",
   "speaker": "Trevor Evans",
   "party": "LNP",
   "state": "federal",
   "date": "2020-12-09",
   "stage_hint": null,
   "brief": "The bill introduces a harmonic mean calculation for allocating seats to the territories, making it easier to round up quotas for additional House of Representatives seats, and removes the margin of error provisions to modernise the Electoral Act."
  }
 ],
