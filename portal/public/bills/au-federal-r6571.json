 "speeches": [
  {
   "slug": "speech-394003",
   "speaker": "Sussan Ley",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-08-27",
   "stage_hint": null,
   "brief": "The Recycling and Waste Reduction Charges (Customs) Bill 2020 imposes customs duties as part of the waste export ban charging package, with charge amounts and liable parties to be set by regulation."
  },
  {
   "slug": "speech-397086",
   "speaker": "Susan Templeman",
   "party": "Labor",
   "state": "federal",
   "date": "2020-10-26",
   "stage_hint": null,
   "brief": "The member for Blue Mountains supported the Recycling and Waste Reduction Charges (Customs) Bill 2020, citing that only 12% of plastic is recycled in Australia and noting that local students had campaigned against plastic bags, while criticising the government for seven years of inaction on waste and climate change. The member moved that the debate be adjourned."
  },
  {
   "slug": "speech-397397",
   "speaker": "Dan Tehan",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-10-28",
   "stage_hint": null,
   "brief": "The speaker moved to rescind the third readings of five recycling and waste reduction bills and to immediately call them on again, with a Minister moving each third reading and the question put without debate."
  }
