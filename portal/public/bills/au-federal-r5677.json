 "speeches": [
  {
   "slug": "speech-333219",
   "speaker": "Joel Fitzgibbon",
   "party": "Labor",
   "state": "federal",
   "date": "2016-09-12",
   "stage_hint": null,
   "brief": "Opposition supported the Primary Industries Levies and Charges Collection Amendment Bill 2016, which would allow research and development corporations to maintain levy payer registers, but raised ongoing concerns about inadequate safeguards preventing levy payer data from being shared with representative organisations like the Cattle Council for political purposes. The speaker also criticised the Minister for Agriculture and Water Resources for failing to deliver on pre-2013 election promises, including on the grass-fed cattle levy."
  },
  {
   "slug": "speech-333220",
   "speaker": "Tony Pasin",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-09-12",
   "stage_hint": null,
   "brief": "The Primary Industries Levies and Charges Collection Amendment Bill 2016 allows the Department of Agriculture and Water Resources to share levy payer information with rural research and development corporations for creating registers, improving consultation and R&D outcomes. The bill was endorsed by the Cattle Council of Australia and the Sheepmeat Council of Australia."
  },
  {
   "slug": "speech-333221",
   "speaker": "Luke Hartsuyker",
   "party": "Nationals",
   "state": "federal",
   "date": "2016-09-12",
   "stage_hint": null,
   "brief": "The Primary Industries Levies and Charges Collection Amendment Bill 2016 enables rural research and development corporations to establish levy payer registers, allowing them to directly identify and consult with levy payers and allocate voting entitlements accurately. The bill extends levy payer information distribution to 13 additional RDCs, with each register requiring industry consultation and ministerial approval."
  }
 ],
