 "speeches": [
  {
   "slug": "speech-375095",
   "speaker": "Karen Andrews",
   "party": "LNP",
   "state": "federal",
   "date": "2019-02-14",
   "stage_hint": null,
   "brief": "The Treatment Benefits (Special Access) (Consequential Amendments and Transitional Provisions) Bill 2019 amends related acts to allow civilian surgical and medical team members to receive medical treatment and pharmaceutical supplements under the Treatment Benefits (Special Access) Act 2019, and ensures they transition smoothly from the Safety, Rehabilitation and Compensation Act 1988 while exempting them from income tax on travel expenses and pharmaceutical benefits."
  },
  {
   "slug": "speech-375935",
   "speaker": "Amanda Rishworth",
   "party": "Labor",
   "state": "federal",
   "date": "2019-02-20",
   "stage_hint": null,
   "brief": "The speaker argued for the Treatment Benefits (Special Access) Bill 2019, which extends gold card health coverage to approximately 240 doctors, 210 nurses, and other civilian medical staff who served in Vietnam from 1964 to 1972, and urged the government to reject the Productivity Commission's recommendation to dismantle the Department of Veterans' Affairs."
  },
  {
   "slug": "speech-376162",
   "speaker": "Nicolle Flint",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-02-20",
   "stage_hint": null,
   "brief": "The Treatment Benefits (Special Access) Bill 2019 and related bill extend Department of Veterans' Affairs gold card health benefits to surviving civilian surgical and medical team members who served in Vietnam alongside the ADF, benefiting about 200 people from 1 July 2019. The speaker highlighted the service of nurses like Helen Taplin and Betty Lockwood, and noted the legislation provides recognition and medical treatment for any condition, including mental health support."
  }
 ],
