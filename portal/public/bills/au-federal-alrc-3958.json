  },
  {
   "slug": "speech-793364",
   "speaker": "John Faulkner",
   "party": "Labor",
   "state": "federal",
   "date": "2009-06-15",
   "stage_hint": null,
   "brief": "The speaker moved that the bills proceed without formalities, be taken together and read a first time, with a plan to later list them separately on the Notice Paper."
  },
  {
   "slug": "speech-793365",
   "speaker": "John Faulkner",
   "party": "Labor",
   "state": "federal",
   "date": "2009-06-15",
   "stage_hint": null,
   "brief": "The speech announced the OzCar facility for car dealer financing, with a Commonwealth Guarantee covering around $550 million in securities, and introduced bills to strengthen journalists' privilege, streamline family tax benefit delivery, improve childcare administration and compliance, regulate life insurance non-operating holding companies, harmonise injunctions in prudential legislation, and amend fuel quality standards."
  },
  {
   "slug": "speech-794715",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-08-18",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-794716",
   "speaker": "Mathias Cormann",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-08-18",
   "stage_hint": null,
   "brief": "The speaker argued that the Rudd government’s proposed health insurance rebate changes broke a pre-election promise and will increase pressure on public hospitals. They cited figures including 11 million privately insured Australians, a prior drop in membership from 63% to 30% under earlier Labor governments, and an expected 492,000 fewer privately insured due to the 2009 budget measures."
  },
  {
   "slug": "speech-795376",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-09-09",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795377",
   "speaker": "Mathias Cormann",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-09-09",
   "stage_hint": null,
   "brief": "The Coalition argued the bill breaks a clear election promise to retain the private health insurance rebate, and will push up premiums, drive people out of private cover, and increase pressure on public hospitals. The Greens supported means-testing the rebate as a small step but opposed the surcharge increase, while Family First opposed the bill, calling the thresholds unfair for families with children."
  },
  {
   "slug": "speech-799129",
   "speaker": "Kerry O'Brien",
   "party": "Labor",
   "state": "federal",
   "date": "2010-03-10",
   "stage_hint": null,
   "brief": "The government admitted it incorrectly attributed the pairing of Senator Xenophon during the vote on the Fairer Private Health Insurance Incentives Bill 2009 to the coalition, when it should have reduced the government's vote; the error did not change the tied outcome, and the government apologised."
  }
 ],
