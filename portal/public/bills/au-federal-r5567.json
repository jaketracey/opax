 "speeches": [
  {
   "slug": "speech-324040",
   "speaker": "Chris Bowen",
   "party": "Labor",
   "state": "federal",
   "date": "2015-11-25",
   "stage_hint": null,
   "brief": "The opposition supported the Tax Laws Amendment (Gifts) Bill 2015, granting deductible gift recipient status to the International Jewish Relief Fund Limited and the National Apology Foundation. The National Apology Foundation, founded by former Prime Minister Kevin Rudd with a $100,000 donation from Rudd and Therese Rein, aims to perpetuate the spirit of the 2008 apology to the Stolen Generations and monitor progress on closing the gap in Indigenous disadvantage, where progress has been patchy—for example, life expectancy for Indigenous Australians remains 10 years less than for non-Indigenous Australians."
  },
  {
   "slug": "speech-324041",
   "speaker": "Andrew Leigh",
   "party": "Labor",
   "state": "federal",
   "date": "2015-11-25",
   "stage_hint": null,
   "brief": "The Tax Laws Amendment (Gifts) Bill 2015 grants deductible gift recipient status to International Jewish Relief Limited and the National Apology Foundation Ltd, with bipartisan support. The speaker also argued against scrapping the Australian Charities and Not-for-profits Commission, citing its 25% annual staff turnover and strong sector support, and urged the government to abandon that proposal."
  },
  {
   "slug": "speech-324042",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-11-25",
   "stage_hint": null,
   "brief": "The Tax Laws Amendment (Gifts) Bill 2015 adds the National Apology Foundation Ltd and International Jewish Relief Limited to the deductible gift recipient listings from 1 January 2015, allowing taxpayers to claim income tax deductions for gifts to these organisations."
  }
 ],
