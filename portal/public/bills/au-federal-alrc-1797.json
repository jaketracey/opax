  {
   "slug": "speech-798829",
   "speaker": "Penny Wong",
   "party": "Labor",
   "state": "federal",
   "date": "2010-02-24",
   "stage_hint": null,
   "brief": "The speaker introduced bills and moved for them to be taken together and read a first time without formalities, which was agreed to."
  },
  {
   "slug": "speech-798830",
   "speaker": "Penny Wong",
   "party": "Labor",
   "state": "federal",
   "date": "2010-02-24",
   "stage_hint": null,
   "brief": "The government introduced additional appropriations of over $2 billion for programs including the Solar Homes and Communities Plan, Home Insulation Program, H1N1 pandemic response, and Christmas Island immigration detention, along with bills creating a federal torture offence, extending death penalty abolition to all states, amending income management and land grants in the Northern Territory, and broadening diagnostic imaging accreditation from 1 July 2010."
  },
  {
   "slug": "speech-799835",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2010-03-18",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-799836",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2010-03-18",
   "stage_hint": null,
   "brief": "The speaker criticised the government's fiscal management, arguing that the $2 billion in additional appropriations—including $510.8 million for the Solar Homes and Communities Plan, $290.1 million for the Home Insulation Program, and $34.1 million for expanding Christmas Island detention capacity—reflected reckless spending, and that the Operation Sunlight clawback mechanism lacked transparency and would not deliver genuine savings."
  }
