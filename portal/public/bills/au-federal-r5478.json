 "speeches": [
  {
   "slug": "speech-311897",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2015-06-03",
   "stage_hint": null,
   "brief": "The Export Charges (Imposition-Excise) Bill 2015 imposes charges only when considered a duty of excise, with amounts and exemptions to be set in delegated legislation, not by the bill itself."
  },
  {
   "slug": "speech-311898",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2015-06-03",
   "stage_hint": null,
   "brief": "The Export Charges (Collection) Bill 2015 was moved for second reading, providing authority to collect charges under related imposition bills, with regulations for payment timelines, agent liability, late fees, and mechanisms for nonpayment including service refusal or export approval revocation, to sustainably fund export services for Australia's agricultural sector."
  },
  {
   "slug": "speech-313234",
   "speaker": "Joel Fitzgibbon",
   "party": "Labor",
   "state": "federal",
   "date": "2015-06-17",
   "stage_hint": null,
   "brief": "The opposition supported four export charges bills that recover certification and inspection costs from exporting companies rather than taxpayers. The speaker criticised the government for having no agriculture policy after two years, opposed discriminatory foreign investment rules that set lower thresholds for Asian investors compared to American and Canadian investors, and argued the government's approach to foreign investment in agricultural land was populist and would deter needed capital."
  },
  {
   "slug": "speech-313236",
   "speaker": "Tony Zappia",
   "party": "Labor",
   "state": "federal",
   "date": "2015-06-17",
   "stage_hint": null,
   "brief": "Labor supported the Export Charges bills, arguing for fair cost recovery in primary production fees and warning that excessive charges could become a barrier to exports, while also calling for stronger biosecurity oversight on food imports and noting the $40 billion export industry and potential for a South Australian food hub."
  }
 ],
