 "divisions": [],
 "speeches": [
  {
   "slug": "speech-395421",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-10-06",
   "stage_hint": null,
   "brief": "Appropriation Bill (No. 2) 2020-2021 seeks approval for $14.9 billion from the Consolidated Revenue Fund, including nearly $8.5 billion for Defence, $2.5 billion for Agriculture, Water and the Environment, and $1.4 billion for Infrastructure, Transport, Regional Development and Communications, with a revised $6 billion advance to the finance minister."
  },
  {
   "slug": "speech-396401",
   "speaker": "Bert van Manen",
   "party": "LNP",
   "state": "federal",
   "date": "2020-10-20",
   "stage_hint": null,
   "brief": "The Appropriation Bill (No. 1) 2020-21, Appropriation Bill (No. 2) 2020-2021, and Appropriation (Parliamentary Departments) Bill (No. 1) 2020-21 were referred to the Federation Chamber for further consideration."
  },
  {
   "slug": "speech-396633",
   "speaker": "Ian Goodenough",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-10-21",
   "stage_hint": null,
   "brief": "The speaker supported the appropriation bills, which allocate $36.8 billion, $14.9 billion, and $141.7 million for parliamentary functions, and detailed COVID-19 response measures including $101 billion for JobKeeper, $17.8 billion in tax relief, and $245 million for an Edith Cowan University campus."
  },
  {
   "slug": "speech-396639",
   "speaker": "Justine Elliot",
   "party": "Labor",
   "state": "federal",
   "date": "2020-10-21",
   "stage_hint": null,
   "brief": "The MP argued the Morrison government's budget fails regional Australia, citing a $1 trillion debt, 33,000 local JobKeeper recipients and 14,000 JobSeeker recipients on the North Coast, $1.7 billion in aged-care cuts, and a $33 million Southern Cross University funding shortfall. They also criticised the lack of a federal integrity commission and state Liberal-National decisions on koala protection and shark mitigation."
  },
  {
   "slug": "speech-396650",
   "speaker": "Ken O'Dowd",
   "party": "LNP",
   "state": "federal",
   "date": "2020-10-21",
   "stage_hint": null,
   "brief": "The member for Flynn supported the 2020-2021 appropriation bills, highlighting $20 million for the John Petersen Bridge, upgrades to the Springsure-Tambo road, the Dawson Highway, and the Philip Street four-lane project in Gladstone. He also announced federal funding for the Cooranga, Bardwell, and Paranui weirs, and argued for an inland rail line from Gladstone to Toowoomba, citing the resource industry's $290 billion annual contribution and the need for water infrastructure to boost agriculture from $60 billion to $100 billion."
  },
  {
   "slug": "speech-397627",
   "speaker": "Chris Bowen",
   "party": "Labor",
   "state": "federal",
   "date": "2020-10-28",
   "stage_hint": null,
   "brief": "The speaker argued that the government's claimed \"landmark PBS New Medicines Funding Guarantee\" has no actual budget allocation, while the PBS faces $250 million in cuts annually. They stated that only 45 of 110 medicines recommended by the PBAC since July 2019 have been listed, leaving 70 expert-recommended medicines unlisted."
  }
 ],
