 "speeches": [
  {
   "slug": "speech-276716",
   "speaker": "John Cobb",
   "party": "Nationals",
   "state": "federal",
   "date": "2013-06-19",
   "stage_hint": null,
   "brief": "Supported the Sugar Research and Development Services bills as a reform backed by most of the industry, under which Sugar Research Australia would replace separate research bodies and receive a 70c per tonne levy paid equally by growers and mills, while raising concerns about consultation, regional research, conflicts of interest and the legislation's rushed 1 July 2013 commencement."
  },
  {
   "slug": "speech-276718",
   "speaker": "George Christensen",
   "party": "Nationals",
   "state": "federal",
   "date": "2013-06-19",
   "stage_hint": null,
   "brief": "Supported the Sugar Research and Development Services bills, saying they would consolidate research functions in Sugar Research Australia, reduce duplication and secure funding through a 70c per tonne levy, while urging swift passage to provide certainty for research staff and the industry's future."
  },
