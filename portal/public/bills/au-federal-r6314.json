 "speeches": [
  {
   "slug": "speech-376579",
   "speaker": "Cathy O'Toole",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": "The speaker supported the Treasury Laws Amendment (North Queensland Flood Recovery) Bill 2019 but condemned the LNP government's disaster recovery criteria, citing cases like Cherrie Vitalli denied three times and small business owner Warren Figg waiting six weeks for a grant, and noting that only $724,112 of $27.2 million in relief had been delivered to Townsville businesses."
  },
  {
   "slug": "speech-376580",
   "speaker": "Stuart Robert",
   "party": "LNP",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": "The bill makes qualifying disaster payments, recovery grants, and on-farm grants to flood-affected Queensland primary producers, small businesses, and non-profit organisations non-assessable for tax; treats storm-damage payments to Fassifern Valley primary producers as exempt income; and provides a special appropriation for a reduced‑interest loan scheme for eligible primary producers."
  }
 ],
