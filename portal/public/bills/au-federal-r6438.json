 "speeches": [
  {
   "slug": "speech-384985",
   "speaker": "Jim Chalmers",
   "party": "Labor",
   "state": "federal",
   "date": "2019-11-27",
   "stage_hint": null,
   "brief": "The speaker supported the bills but argued they are insufficient, noting that home ownership has dropped to its lowest level since the 1960s, house prices in major cities have risen over 15% in five years, household debt is at a record 200% of income, and over one million low-income households face housing stress. They also criticised the government for lacking a comprehensive plan, citing stagnant wages as a deliberate policy design and warning that low interest rates risk inflating asset prices without improving affordability."
  },
  {
   "slug": "speech-384988",
   "speaker": "Adam Bandt",
   "party": "Greens",
   "state": "federal",
   "date": "2019-11-27",
   "stage_hint": null,
   "brief": "Young people face housing unaffordability because house prices have risen from six times a graduate's income decades ago to over 12 times now, while wages are low and government tax subsidies treat housing as an investment rather than a basic right; no Australian city is affordable to rent on Newstart."
  }
 ],
