 "speeches": [
  {
   "slug": "speech-339075",
   "speaker": "Melissa Price",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-11-29",
   "stage_hint": null,
   "brief": "The speaker supported the Income Tax Rates Amendment (Working Holiday Maker Reform) Bill 2016 (No. 2), which sets a 15% tax rate for working holiday makers, and criticised Labor for supporting a 10.5% rate that would allow backpackers to pay less tax than Australian workers. The bill also includes a $10 million global youth campaign to attract backpackers to Australia."
  },
  {
   "slug": "speech-339077",
   "speaker": "Rebekha Sharkie",
   "party": "Centre Alliance",
   "state": "federal",
   "date": "2016-11-29",
   "stage_hint": null,
   "brief": "The speaker supported the bill and announced a two-year seasonal workers incentives trial from July next year, allowing up to 6,000 job seekers to do seasonal work without losing Newstart or youth allowance, with incentives for employment providers and a $300 living-away-from-home allowance; they also criticised political delays on the backpacker tax for harming farmers."
  },
  {
   "slug": "speech-339078",
   "speaker": "Warren Snowdon",
   "party": "Labor",
   "state": "federal",
   "date": "2016-11-29",
   "stage_hint": null,
   "brief": "The speaker argued that the backpacker labour shortage is solely due to uncertainty created by the government's 2015 budget tax, introduced by Treasurer Hockey, noting that backpackers currently pay zero tax. They also criticised the National Party as a \"bunyip aristocracy\" for failing to support workers and businesses."
  }
 ],
