 "speeches": [
  {
   "slug": "speech-278159",
   "speaker": "Joe Hockey",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": "Moved that the bill be read a second time, arguing that abolishing the carbon tax would reduce the consumer price index by around 0.7 percentage points in 2014-15, lower retail electricity and gas prices, and repeal scheduled personal income tax and low-income tax offset changes."
  },
  {
   "slug": "speech-825384",
   "speaker": "Joe Hockey",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-278597",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-18",
   "stage_hint": null,
   "brief": "Moved a debate management motion to conclude debate on the Clean Energy Legislation (Carbon Tax Repeal) Bill 2013 and related bills by Thursday this week, arguing the election gave the coalition a mandate with 90 seats to Labor's 55, Labor's worst result since 1903."
  },
  {
   "slug": "speech-278606",
   "speaker": "Bill Shorten",
   "party": "Labor",
   "state": "federal",
   "date": "2013-11-18",
   "stage_hint": null,
   "brief": "Argued against the government's carbon tax repeal bills, saying the decade from 2001 to 2010 was the warmest on record, that Direct Action would cost households an estimated $1,200 a year without a legislated cap on emissions, and noted that under Labor wind power generation trebled and 24,000 renewable energy jobs were created."
  },
  {
   "slug": "speech-825612",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-18",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-825613",
   "speaker": "Bill Shorten",
   "party": "Labor",
   "state": "federal",
   "date": "2013-11-18",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-825994",
   "speaker": "Mitch Fifield",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-12-02",
   "stage_hint": null,
   "brief": "The government moved to repeal the carbon tax effective 1 July 2014, claiming it would lower the Consumer Price Index by 0.7 percentage points, reduce average electricity prices by nine per cent and gas prices by seven per cent, and cut household costs by $550 in the first year. The bill also repeals the second round of personal income tax cuts scheduled for 1 July 2015, keeping the tax-free threshold at $18,200, the 32.5 per cent marginal rate, and the $445 low-income tax offset, legislating a $1.5 billion saving."
  }
 ],
