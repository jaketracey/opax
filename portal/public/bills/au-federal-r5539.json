 "speeches": [
  {
   "slug": "speech-320242",
   "speaker": "Jenny Macklin",
   "party": "Labor",
   "state": "federal",
   "date": "2015-10-14",
   "stage_hint": null,
   "brief": "The speaker supported the Social Services Legislation Amendment (Cost of Living Concession) Bill 2015, which excludes a $200 per year South Australian government payment to pensioners and concession card holders from being assessed as income under social security and veterans' affairs tests. The speaker welcomed the South Australian Labor government's payment, arguing it was needed because the federal Liberal government had cut money to pensioners."
  },
  {
   "slug": "speech-320245",
   "speaker": "Tony Zappia",
   "party": "Labor",
   "state": "federal",
   "date": "2015-10-14",
   "stage_hint": null,
   "brief": "The Labor MP argued the bill should pass to ensure the South Australian government’s $200 cost-of-living payment is not assessed as income, criticising the coalition government for cutting $1.3 billion from the National Partnership Agreement on Certain Concessions and noting no coalition members spoke on the bill."
  },
  {
   "slug": "speech-320246",
   "speaker": "Christian Porter",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-10-14",
   "stage_hint": null,
   "brief": "The bill excludes the South Australian government's cost-of-living concession payment from being assessed under the social security and veterans' affairs income test, a measure the speaker described as beneficial."
  }
 ],
