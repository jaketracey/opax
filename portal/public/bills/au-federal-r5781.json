 "speeches": [
  {
   "slug": "speech-339621",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2016-12-01",
   "stage_hint": null,
   "brief": "The bill amends 13 portfolio acts to cease four redundant statutory bodies, remove unnecessary regulation, and repeal 12 redundant acts, including removing annual permit applications for fisheries and export licences for meat by-products, and transferring the Statutory Fishing Rights Allocation Review Panel's functions to the Administrative Appeals Tribunal."
  },
  {
   "slug": "speech-339622",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2016-12-01",
   "stage_hint": null,
   "brief": "The bill amends the Primary Industries (Excise) Levy Act 1999 and the National Residue Survey (Excise) Levy Act 1998 to remove obsolete provisions allowing buyers to give sellers a certificate of intention to export honey, a practice no longer used by the industry. The changes, supported by the Australian Honey Bee Industry Council, do not alter levy or customs charges, and come as Australian honey producers exported nearly 4.5 million kilograms valued at over $45 million in 2015–16."
  },
  {
   "slug": "speech-341083",
   "speaker": "Joel Fitzgibbon",
   "party": "Labor",
   "state": "federal",
   "date": "2017-02-13",
   "stage_hint": null,
   "brief": "The speaker argued that the Agriculture and Water Resources Legislation Amendment Bill 2016 and the Excise Levies Legislation Amendment (Honey) Bill 2016 are largely housekeeping measures to reduce red tape, and raised concerns about the abolition of the APVMA advisory committee, water policy, transparency, research and development corporations, the Farm Household Allowance, drought policy, biosecurity, and environment and energy issues."
  },
  {
   "slug": "speech-341089",
   "speaker": "Meryl Swanson",
   "party": "Labor",
   "state": "federal",
   "date": "2017-02-13",
   "stage_hint": null,
   "brief": "Labor supported the agriculture and water bills as technical improvements but demanded the government deliver the promised additional 450 gigalitres of water for the environment under the Murray-Darling Basin Plan, calling it non-negotiable. The speaker proposed an amendment to ensure water security and criticized the Deputy Prime Minister for seeking to unravel the plan."
  }
 ],
