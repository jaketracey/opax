   "brief": null
  },
  {
   "slug": "speech-775210",
   "speaker": "Eric Abetz",
   "party": "Liberal",
   "state": "federal",
   "date": "2006-09-13",
   "stage_hint": null,
   "brief": "The bills were introduced together and passed a first reading without formalities, with a motion to list one separately on the Notice Paper after debate."
  },
  {
   "slug": "speech-775211",
   "speaker": "Eric Abetz",
   "party": "Liberal",
   "state": "federal",
   "date": "2006-09-13",
   "stage_hint": null,
   "brief": "The government introduced the Independent Contractors Bill 2006 to ensure genuine independent contractors are governed by commercial rather than industrial law, overriding state deeming provisions that treat contractors as employees. The bill preserves protections for textile outworkers and owner-drivers, introduces penalties for sham contracting, and creates a single federal unfair contracts jurisdiction, with an estimated 800,000 to 1.9 million Australians working as independent contractors."
  },
  {
   "slug": "speech-776999",
