 "speeches": [
  {
   "slug": "speech-827076",
   "speaker": "Dean Smith",
   "party": "Liberal",
   "state": "federal",
   "date": "2023-02-07",
   "stage_hint": null,
   "brief": "The bill grants or extends deductible gift recipient status to several organisations, including Melbourne Business School, the Jewish Education Foundation, and Australians for Indigenous Constitutional Recognition, while removing status for the Mt Eliza Graduate School. The opposition supported the bill but criticised the government's legislative mismanagement, the Greens supported it while calling for a fairer DGR process, and Senator Scarr highlighted a reported 478 antisemitic incidents in Australia over the past year."
  }
