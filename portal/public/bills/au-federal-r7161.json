  "as_of": "2024-03-20",
  "sentences": [
   "This bill is part of a package that would increase tobacco excise and customs duty rates and make the tax treatment of stick and non‑stick tobacco products the same.",
   "The package would amend the Excise Tariff Act 1921 and the Customs Tariff Act 1995 to raise duty rates for tobacco goods from 1 September 2023.",
   "The amendments would take effect from 1 September 2023, and the measure was announced in the 2023-24 Budget."
  ],
  "changes": [
   "Increase rates of duty for tobacco goods.",
   "Align the duty rates for stick and non‑stick tobacco products.",
   "Amend the Excise Tariff Act 1921 and the Customs Tariff Act 1995."
  ],
  "affected": "Tobacco goods importers and manufacturers, and the Australian Taxation Office and Department of Home Affairs.",
