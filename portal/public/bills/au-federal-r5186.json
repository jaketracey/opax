 "speeches": [
  {
   "slug": "speech-285985",
   "speaker": "Andrew Broad",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-03-19",
   "stage_hint": null,
   "brief": "Supported the Civil Aviation Amendment (CASA Board) Bill, which expands the Civil Aviation Safety Authority board from five to seven directors, currently none of whom have flying experience, at a cost of about $160,000 a year, and cited 36,900 Australians holding a current pilot's licence to argue for aviation expertise on the board."
  },
  {
   "slug": "speech-285988",
   "speaker": "Steve Irons",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-03-19",
   "stage_hint": null,
   "brief": "Supported the Civil Aviation Amendment (CASA Board) Bill's increase of CASA's board from five to seven members to add aviation experience, and criticised the previous government and CASA for handling Perth airport flight path changes without transparency, saying the then minister, the member for Grayndler, never met him in six years despite constituent noise complaints."
  },
  {
   "slug": "speech-285989",
   "speaker": "Dennis Jensen",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-03-19",
   "stage_hint": null,
   "brief": "Supported the Civil Aviation Amendment (CASA Board) Bill's increase of the CASA board from five to seven members to add aviation experience, citing a Senate inquiry finding on improperly attached engines on a Qantas jet serviced in Hong Kong, and warned that new maintenance approval requirements would impose costly management structures on general aviation operators, including the Royal Flying Doctor Service."
  },
  {
   "slug": "speech-285990",
   "speaker": "Warren Truss",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-03-19",
   "stage_hint": null,
   "brief": "Summed up debate on the Civil Aviation Amendment (CASA Board) Bill, saying it adds two members to the CASA board to bring aviation experience, noting an international safety regulatory review panel is due to report to government by the end of May 2014, and thanked the opposition for supporting the legislation."
  }
 ],
