 "speeches": [
  {
   "slug": "speech-361539",
   "speaker": "Angus Taylor",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-03-28",
   "stage_hint": null,
   "brief": "The government moved the Commerce (Trade Descriptions) Amendment Bill 2018 to align Australian border legislation with consumer law safe harbour defences for country of origin labelling, enabling importers to make origin claims without false trade description offences and allowing automatic updating of information standards in regulations."
  },
  {
   "slug": "speech-364413",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2018-06-18",
   "stage_hint": null,
   "brief": "Labor supported the Commerce (Trade Descriptions) Amendment Bill 2018, which extends safe-harbour defences under section 255 of the Competition and Consumer Act to trade description offences where goods genuinely originate from the claimed country. The opposition also urged splitting the government's tax cut bill to pass the 2018 tranche, criticised the 2024 tax cuts as costly and regressive, and credited former member for Perth Tim Hammond for his work on the bill."
  },
  {
   "slug": "speech-364414",
   "speaker": "Tim Wilson",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-06-18",
   "stage_hint": null,
   "brief": "The speaker argued that the Commerce (Trade Descriptions) Amendment Bill 2018 would reduce regulatory barriers and harmonise standards to promote free trade, benefiting Australian consumers—particularly families, students, single-income households, and pensioners—by lowering prices. The bill aligns the Commerce (Trade Descriptions) Act with the Competition and Consumer Act to provide a defence for importers and simplify enforcement by the Australian Border Force."
  },
  {
   "slug": "speech-364415",
   "speaker": "Angus Taylor",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-06-18",
   "stage_hint": null,
   "brief": "The bill amends the Commerce (Trade Descriptions) Act to allow Australian Border Force officers to consider Australian Consumer Law safe harbour defences when assessing country-of-origin claims, and to incorporate future information standards. It also prohibits misleading country-of-origin representations for both importers and domestic sellers."
  }
 ],
