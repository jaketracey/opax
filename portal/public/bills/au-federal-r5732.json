 "speeches": [
  {
   "slug": "speech-335112",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-10-13",
   "stage_hint": null,
   "brief": "The bill amends the Customs Act 1901 to implement changes from the fifth review of the World Customs Organization's harmonized system and to collect import duties on biofuels and biofuel blends under the China-Australia Free Trade Agreement."
  },
  {
   "slug": "speech-337088",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-11-08",
   "stage_hint": null,
   "brief": "The speaker summed up two bills implementing Australia's obligations from the World Customs Organization's fifth review of the Harmonized System, introducing about 150 amendments to the Customs Tariff Act 1995 and minor changes to the Customs Act 1901, including new tariff classifications for emerging technologies and provisions for collecting import duties on biofuels under the China-Australia Free Trade Agreement."
  }
 ],
