 "speeches": [
  {
   "slug": "speech-278236",
   "speaker": "Chris Bowen",
   "party": "Labor",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": "Raised a point of order accusing the Prime Minister of misleading the House by referring to the 2009 stimulus bill when the Leader of the Opposition had asked about the Commonwealth Inscribed Stock Amendment Bill, and sought leave to table Hansard to correct the record."
  },
  {
   "slug": "speech-278336",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-278338",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": "Moved to suspend standing orders so the Commonwealth Inscribed Stock Amendment Bill 2013 could proceed through all stages on 13 November 2013, with a managed debate and consideration in detail limited to 60 minutes. Argued that prompt passage was needed to address the debt ceiling and maintain confidence in markets and the economy."
  },
  {
   "slug": "speech-278341",
   "speaker": "The SPEAKER",
   "party": null,
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-278360",
   "speaker": "Craig Kelly",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": "Argued the coalition inherited no debt and $50 billion in savings on leaving office, while Labor progressively raised the debt limit to $300 billion, and said servicing Labor's debt now costs $10 billion a year in interest, describing the increase as an unfortunate but necessary clean-up."
  },
  {
   "slug": "speech-278363",
   "speaker": "Scott Buchholz",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": "Argued that the coalition left no debt or debt ceiling in 2007, and criticised Labor for repeatedly raising the ceiling from $75 billion to $300 billion while now opposing the government's request for a further increase."
  },
  {
   "slug": "speech-825409",
   "speaker": "Bill Shorten",
   "party": "Labor",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-825429",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-825459",
   "speaker": "Mitch Fifield",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": "The speaker moved to suspend standing orders to allow the Commonwealth Inscribed Stock Amendment Bill 2013 to be considered during the current sittings, with royal assent required by the end of November 2013 to increase the legislative limit on Commonwealth Government Securities."
  },
  {
   "slug": "speech-825558",
   "speaker": "Mitch Fifield",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-14",
   "stage_hint": null,
   "brief": "The speaker moved to waive standing order requirements for the Commonwealth Inscribed Stock Amendment Bill 2013 so it could be considered in the current sittings; the motion was agreed to."
  },
  {
   "slug": "speech-826321",
   "speaker": "Mitch Fifield",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-12-05",
   "stage_hint": null,
   "brief": "The speaker moved to schedule the Australian Capital Territory Water Management Legislation Amendment Bill 2013 for 12:45 pm and the Commonwealth Inscribed Stock Amendment Bill 2013 for debate until 2 pm, arguing the opposition supports the stock bill but needs more time for substantive discussion on debt ceiling changes, and criticised poor time management in the chamber."
  },
  {
   "slug": "speech-280935",
   "speaker": "Joe Hockey",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-12-09",
   "stage_hint": null,
   "brief": "Congratulated the member for Moore on his maiden speech, and moved to suspend standing orders so the House could immediately consider the Senate's requested and further amendments to the Commonwealth Inscribed Stock Amendment Bill 2013."
  },
  {
   "slug": "speech-280960",
   "speaker": "Steven Ciobo",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-12-09",
   "stage_hint": null,
   "brief": "Defended the Commonwealth Inscribed Stock Amendment Bill 2013, arguing Labor turned $45 billion of net assets into more than $400 billion of debt, and noted Labor promised a budget surplus on over 600 occasions before delivering a deficit of nearly $31 billion."
  },
  {
   "slug": "speech-280970",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2013-12-09",
   "stage_hint": null,
   "brief": "Opposed the bill, accusing the coalition of hypocrisy for lecturing Labor on obstruction after itself blocking savings measures like indexing the private health insurance rebate and opposing the Malaysia people transfer agreement in the previous parliament."
  },
  {
   "slug": "speech-826413",
   "speaker": "Bronwyn Bishop",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-12-09",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-826564",
   "speaker": "Stephen Parry",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-12-10",
   "stage_hint": null,
   "brief": "The House of Representatives agreed to the Senate's further amendments to the Commonwealth Inscribed Stock Amendment Bill 2013 and made the amendments requested by the Senate."
  }
 ],
