 "speeches": [
  {
   "slug": "speech-829307",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-28",
   "stage_hint": null,
   "brief": "The Health Insurance Amendment (Prescribed Dental Patients and Other Measures) Bill 2023, Customs Tariff Amendment (Incorporation of Proposals) Bill 2023, Special Recreational Vessels Amendment Bill 2023, Veterans' Affairs Legislation Amendment (Miscellaneous Measures) Bill 2023, and Treasury Laws Amendment (Refining and Improving Our Tax System) Bill 2023 were referred to the Federation Chamber for further consideration at the adjournment of the second reading debate."
  },
  {
   "slug": "speech-829312",
   "speaker": "David Littleproud",
   "party": "Nationals",
   "state": "federal",
   "date": "2023-03-28",
   "stage_hint": null,
   "brief": "The coalition supported the Special Recreational Vessels Amendment Bill 2023, which extends the Special Recreational Vessels Act 2019 by two years to 30 June 2025, allowing foreign superyachts to operate and charter in Australian waters. The speaker cited economic benefits including $2 billion and 5,360 jobs in Queensland by 2025, and projected that the Brisbane 2032 Olympics would attract 200 additional foreign vessels, generating $1.8 billion and 7,600 jobs nationally."
  },
  {
   "slug": "speech-829384",
   "speaker": "Bert Van Manen",
   "party": "Liberal",
   "state": "federal",
   "date": "2023-03-28",
   "stage_hint": null,
   "brief": "The bill extends the temporary licence scheme for foreign superyachts to 30 June 2025. Supporters argued it could contribute over $2 billion to Queensland’s economy and support 5,360 jobs, while opponents highlighted that superyacht owners include billionaires like Jeff Bezos and that the vessels produce high CO2 emissions and exploit workers."
  },
  {
   "slug": "speech-829538",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2023-03-29",
   "stage_hint": null,
   "brief": "The Special Recreational Vessels Amendment Bill 2023 extends the 2019 act to allow foreign-owned superyachts to charter in Australia, expected to generate 11,800 jobs and $1.64 billion in revenue, supporting tradespeople and small businesses."
  }
 ],
