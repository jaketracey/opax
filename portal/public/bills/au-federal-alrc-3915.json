   "brief": null
  },
  {
   "slug": "speech-787121",
   "speaker": "Tony Abbott",
   "party": "Liberal",
   "state": "federal",
   "date": "2008-09-02",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-787122",
   "speaker": "Jenny Macklin",
   "party": "Labor",
   "state": "federal",
   "date": "2008-09-02",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-787388",
   "speaker": "Kim Carr",
   "party": "Labor",
   "state": "federal",
   "date": "2008-09-04",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-787389",
   "speaker": "Kim Carr",
   "party": "Labor",
   "state": "federal",
   "date": "2008-09-04",
   "stage_hint": null,
   "brief": "The bill consolidates special measures for Aboriginal children in the Northern Territory, revokes previous permit changes allowing public access to communities, restricts R‑rated subscription television in prescribed areas where communities consent, and provides for an independent review of the emergency response later in 2008."
  },
  {
   "slug": "speech-787715",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2008-09-17",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-787716",
   "speaker": "Cory Bernardi",
   "party": "Liberal",
   "state": "federal",
   "date": "2008-09-17",
   "stage_hint": null,
   "brief": "The speaker argued that the government's bill weakens the Northern Territory emergency response by reinstating the permit system, allowing pay TV pornography in communities, and permitting the transport of porn through prescribed areas. He cited police figures showing 98 Indigenous people summonsed for bringing alcohol into prescribed areas versus five non-Indigenous, and called for a blanket ban on pornography and continuation of the permit system repeal."
  },
  {
   "slug": "speech-789966",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2008-11-27",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-789967",
   "speaker": "Trish Crossin",
   "party": "Labor",
   "state": "federal",
   "date": "2008-11-27",
   "stage_hint": null,
   "brief": "The speaker argued for the urgent restoration of the permit system in Northern Territory Indigenous communities, stating it was overwhelmingly supported by Indigenous people and land councils, and that the previous government's removal of the system was ideologically driven with no evidence linking permits to child abuse. The bill also includes measures to prohibit certain R18+ pay TV channels in prescribed areas if communities request, and minor amendments regarding roadhouse licensing and transport of prohibited items."
  },
  {
   "slug": "speech-790002",
   "speaker": "Marise Payne",
   "party": "Liberal",
   "state": "federal",
   "date": "2008-11-27",
   "stage_hint": null,
   "brief": "The speaker argued against reinstating the permit system for Aboriginal communities in the Northern Territory, claiming it would reduce scrutiny, harm women and children, and hinder economic development, and also opposed loosening restrictions on pornography. They cited an Access Economics report projecting $4.6 billion higher government revenue and $3.7 billion lower expenditure by 2029 if Indigenous disadvantage were eliminated."
  },
  {
   "slug": "speech-790003",
   "speaker": "Nigel Scullion",
   "party": "Country Liberal Party",
   "state": "federal",
   "date": "2008-11-27",
   "stage_hint": null,
   "brief": "The Senate debate on the NT Emergency Response Consolidation Bill saw the opposition, led by Senator Scullion, fail to block provisions allowing R18+ pay TV in prescribed communities or to abolish the permit system, but it did succeed in removing schedule 2 on transporting prohibited materials. The Greens' amendments to immediately reinstate the Racial Discrimination Act were defeated, with the government pledging to address the exemption next spring, and the bill ultimately passed as amended."
  },
  {
   "slug": "speech-790004",
   "speaker": "Chris Evans",
   "party": "Labor",
   "state": "federal",
   "date": "2008-11-27",
   "stage_hint": null,
   "brief": null
  }
 ],
