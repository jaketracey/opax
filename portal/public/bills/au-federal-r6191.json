 "divisions": [],
 "speeches": [
  {
   "slug": "speech-370142",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-09-20",
   "stage_hint": null,
   "brief": "The government opposed suspending standing orders, citing important business including the bipartisan passage of strawberry industry legislation, and listed several bills for introduction, such as the Higher Education Support Amendment (VET FEE-HELP Student Protection) Bill 2018 and the Treasury Laws Amendment (Making Sure Foreign Investors Pay Their Fair Share of Tax in Australia and Other Measures) Bill 2018."
  },
  {
   "slug": "speech-374658",
   "speaker": "Tim Wilson",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-02-12",
   "stage_hint": null,
   "brief": "The speaker argued that Labor’s policy to remove refundable franking credits would effectively impose a \"retirement tax\" on a million Australian retirees, stealing their overpaid tax. He noted the Economics Committee is conducting an inquiry into the issue, not opposition policy, and that affected retirees want comprehensive tax reform rather than targeted changes."
  },
  {
   "slug": "speech-375015",
   "speaker": "Andrew Hastie",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-02-13",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-375017",
   "speaker": "Bert van Manen",
   "party": "LNP",
   "state": "federal",
   "date": "2019-02-13",
   "stage_hint": null,
   "brief": "The three bills close tax loopholes for foreign investors, particularly stapled structures and double-gearing, which allowed them to pay under 15% tax or nothing on Australian business income while Australian entities pay up to 30%. The measures are expected to raise $400 million over the forward estimates and build on previous actions that have raised about $7 billion in liabilities from multinationals."
  }
 ],
