 "speeches": [
  {
   "slug": "speech-375919",
   "speaker": "Terri Butler",
   "party": "Labor",
   "state": "federal",
   "date": "2019-02-20",
   "stage_hint": null,
   "brief": "The speaker supported the Governor-General Amendment (Salary) Bill 2019, which raises the salary for the next Governor-General, David Hurley, from $425,000 to $495,000."
  },
  {
   "slug": "speech-375924",
   "speaker": "Damian Drum",
   "party": "Nationals",
   "state": "federal",
   "date": "2019-02-20",
   "stage_hint": null,
   "brief": "The Governor-General Amendment (Salary) Bill 2019 sets the annual salary for incoming Governor-General David Hurley in line with the Chief Justice of the High Court, with the salary fixed for his five-year term. The speaker praised Hurley's military and gubernatorial record and thanked outgoing Governor-General Sir Peter Cosgrove for his service."
  },
  {
   "slug": "speech-375925",
   "speaker": "Matt Keogh",
   "party": "Labor",
   "state": "federal",
   "date": "2019-02-20",
   "stage_hint": null,
   "brief": "The speaker supported the Governor-General Amendment (Salary) Bill 2019 to set the salary of incoming Governor-General David Hurley, but argued that the debate highlights the anachronism of constitutional monarchy and called for Australia to have its own head of state."
  },
  {
   "slug": "speech-375926",
   "speaker": "Tim Watts",
   "party": "Labor",
   "state": "federal",
   "date": "2019-02-20",
   "stage_hint": null,
   "brief": "The Governor-General Amendment (Salary) Bill 2019 was supported on the Whitlam-era principle that the office should not depend on the holder's private wealth. Australia's constitutional monarchy was condemned as an outdated, elitist institution that excludes First Australians and non-British migrants and discriminates by gender and religion, citing George Nadel and Daniel Deniehy's 'bunyip aristocracy' gibe in arguing for an Australian head of state."
  }
 ],
