   "date": "2010-06-16",
   "stage_hint": null,
   "brief": "The speaker moved that the bills be taken together, proceed without formalities, and be read a first time, with one to be listed separately on the Notice Paper after debate."
  },
  {
   "slug": "speech-800936",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2010-06-16",
   "stage_hint": null,
