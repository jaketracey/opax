  },
  {
   "slug": "speech-801030",
   "speaker": "Kerry O'Brien",
   "party": "Labor",
   "state": "federal",
   "date": "2010-06-17",
   "stage_hint": null,
   "brief": "The speaker presented the report of the Standing Committee on Finance and Public Administration on the Electoral and Referendum Amendment (Modernisation and Other Measures) Bill 2010 and moved that the Senate take note of the report."
  },
  {
   "slug": "speech-801604",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2010-06-24",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-801605",
   "speaker": "Mike Kelly",
   "party": "Labor",
   "state": "federal",
   "date": "2010-06-24",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-801739",
   "speaker": "Michael Ronaldson",
   "party": "Liberal",
   "state": "federal",
   "date": "2010-06-24",
   "stage_hint": null,
   "brief": "The speaker expressed disappointment that the government agreed to opposition amendments preserving the ability for political parties to attach advertising to postal vote applications and to receive postal votes before forwarding them to the Australian Electoral Commission, while supporting other provisions such as provisional enrolment from age 16 and easier postal vote applications."
  },
  {
   "slug": "speech-801740",
   "speaker": "Michael Ronaldson",
   "party": "Liberal",
   "state": "federal",
   "date": "2010-06-24",
   "stage_hint": null,
   "brief": "The opposition moved amendments to remove items 2 and 12 and Part 2 of Schedule 6 from the bill, arguing there was no evidence that current postal vote processes undermine governance or provide any party with an electoral advantage. The government accepted the amendments, and the items were removed."
  }
