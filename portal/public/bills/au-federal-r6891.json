 "speeches": [
  {
   "slug": "speech-421188",
   "speaker": "Ged Kearney",
   "party": "Labor",
   "state": "federal",
   "date": "2022-08-03",
   "stage_hint": null,
   "brief": "The bill amends the Narcotic Drugs (Licence Charges) Act to allow multiple separate charges for licence holders during a charging period and simplify charge calculations, supporting cost recovery for the medicinal cannabis regulatory scheme."
  },
  {
   "slug": "speech-422006",
   "speaker": "Sussan Penelope Ley",
   "party": "Liberal",
   "state": "federal",
   "date": "2022-09-06",
   "stage_hint": null,
   "brief": "The Narcotic Drugs (Licence Charges) Amendment Bill 2022 updates fees and charges to align with a simplified single-licence model for medicinal cannabis, implementing 26 recommendations from the independent McMillan review. The speech also criticised the Albanese government for ending free rapid antigen tests, cutting telehealth consultations, and other health policy decisions."
  },
  {
   "slug": "speech-422007",
   "speaker": "James Stevens",
   "party": "Liberal",
   "state": "federal",
   "date": "2022-09-06",
   "stage_hint": null,
   "brief": "The speaker supported the Narcotic Drugs (Licence Charges) Amendment Bill 2022, arguing it simplifies the regulatory framework for medicinal cannabis while maintaining oversight, and noted the industry's potential for domestic medical use, primary production, and export earnings, with proponents in South Australia."
  }
