 "speeches": [
  {
   "slug": "speech-395430",
   "speaker": "Dan Tehan",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-10-07",
   "stage_hint": null,
   "brief": "The Bankruptcy (Estate Charges) Amendment (Norfolk Island) Bill extends the 1997 Act to Norfolk Island, ensuring consistent estate charges and equal treatment for bankruptcies there as in the rest of Australia."
  },
  {
   "slug": "speech-400511",
   "speaker": "Jason Clare",
   "party": "Labor",
   "state": "federal",
   "date": "2020-12-08",
   "stage_hint": null,
   "brief": "Labor supported the Territories Legislation Amendment Bill 2020 and the Bankruptcy (Estate Charges) Amendment (Norfolk Island) Bill, arguing they ensure consistent Commonwealth support and law application for external territories. Labor moved a second reading amendment urging proper consultation with community stakeholders and the legal profession, including the Law Association of Norfolk Island and the Law Council of Australia."
  },
  {
   "slug": "speech-400513",
   "speaker": "Nola Marino",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-12-08",
   "stage_hint": null,
   "brief": "The speaker argued the Territories Legislation Amendment Bill and associated bankruptcy bill would align Norfolk Island and other territories with mainland Australia on governance, legal frameworks, and services. The speaker noted the bills extend national company and bankruptcy laws to Norfolk Island, improve privacy rights and review opportunities for residents, and ensure easier access to future government support packages."
  }
 ],
