 "speeches": [
  {
   "slug": "speech-365985",
   "speaker": "Angus Taylor",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-06-27",
   "stage_hint": null,
   "brief": "The bill amends the Customs Tariff Act 1995 to introduce a free rate of duty for Indonesian insecticides and herbicides under the ASEAN-Australia-New Zealand Free Trade Agreement, remove customs duty on clinical trial kits and placebos, and make a technical correction to the China-Australia Free Trade Agreement schedule."
  },
  {
   "slug": "speech-367325",
   "speaker": "Shayne Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2018-08-16",
   "stage_hint": null,
   "brief": "Labor supported the Customs Tariff Amendment (Incorporation of Proposals) Bill 2018, which removes customs duties on certain pesticides and herbicides from Indonesia and simplifies import rules for clinical trial materials, with a minimal financial impact of $3 million over forward estimates. The bill also implements Indonesia’s commitment to reduce tariffs on Australian sugar exports, benefiting Queensland sugarcane growers after Australian sugar exports to Indonesia fell from one million to 200,000 tonnes per year."
  },
  {
   "slug": "speech-367326",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-08-16",
   "stage_hint": null,
   "brief": "The Customs Tariff Amendment (Incorporation of Proposals) Bill 2018 introduces a free rate of duty for certain herbicides and pesticides from Indonesia under the Indonesia-Australia Closer Economic Partnership Agreement, creates a concessional item for eligible blinded clinical trial kits and placebos to remove customs duty and simplify imports, and removes a redundant item from schedule 12."
  }
 ],
