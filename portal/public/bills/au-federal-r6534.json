 "speeches": [
  {
   "slug": "speech-390630",
   "speaker": "Christian Porter",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-04-08",
   "stage_hint": null,
   "brief": "A motion was moved to suspend standing orders to rearrange the day's sitting, prioritising debate on the Coronavirus Economic Response Package (Payments and Benefits) Bill 2020, the Coronavirus Economic Response Package Omnibus (Measures No. 2) Bill 2020, and Appropriation Bills Nos 5 and 6 of 2019-2020. The motion, agreed with the Manager of Opposition Business, sets debate until 2 pm, cancels the Federation Chamber, and prescribes grouped voting on amendments."
  },
  {
   "slug": "speech-390666",
   "speaker": "Zali Steggall",
   "party": "Independent",
   "state": "federal",
   "date": "2020-04-08",
   "stage_hint": null,
   "brief": "The speech argued that the government's COVID-19 economic response packages, while welcome, have gaps that exclude casual employees, pay-as-you-go contractors, temporary visa holders, and self-funded retirees, and urged extensions of support to these groups, as well as greater oversight for commercial tenancies and childcare."
  }
 ],
