  {
   "slug": "speech-823512",
   "speaker": "Jacinta Collins",
   "party": "Labor",
   "state": "federal",
   "date": "2013-05-16",
   "stage_hint": null,
   "brief": "The speaker moved to call on the Environment Protection and Biodiversity Conservation Amendment Bill 2013 immediately and give it precedence over all other business until 4:30 pm that day; the motion was agreed to."
  },
  {
   "slug": "speech-823513",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2013-05-16",
   "stage_hint": null,
   "brief": "The senator supported the Environment Protection and Biodiversity Conservation Amendment Bill 2013 to protect aquifers from coal mining and coal seam gas, and criticised Tony Windsor for selling his farm to a coal miner at $5,000 per acre while opposing nearby mines."
  }
