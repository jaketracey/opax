 "speeches": [
  {
   "slug": "speech-323424",
   "speaker": "Andrew Broad",
   "party": "Nationals",
   "state": "federal",
   "date": "2015-11-23",
   "stage_hint": null,
   "brief": "The speaker argued against higher taxes and for more responsible spending, noting Australia's $30 billion deficit and $154 billion welfare bill, and opposed a change to car expense claims that would cost rural businesses around $500 in deductions."
  },
  {
   "slug": "speech-323426",
   "speaker": "Shayne Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2015-11-23",
   "stage_hint": null,
   "brief": "Labor supported the Tax and Superannuation Laws Amendment (2015 Measures No. 5) Bill 2015, which saves $1.4 billion over forward estimates by reforming work-related car expenses, zone tax offset, salary packaged entertainment benefits, and third-party reporting to the ATO. The speaker argued the government's \"spending problem\" narrative is false, citing high tax-to-GDP ratios and opposition to a regressive GST increase that would hurt low-income earners."
  },
  {
   "slug": "speech-323427",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-11-23",
   "stage_hint": null,
   "brief": "Supported the Tax and Superannuation Laws Amendment Bill 2015 for modernising tax collection and streamlining processes, and criticised the member for Fraser's amendment and Labor's failure to restrain expenditure growth."
  },
  {
   "slug": "speech-323428",
   "speaker": "Kelly O'Dwyer",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-11-23",
   "stage_hint": null,
   "brief": "The bill amends tax laws to modernise work-related car expense deductions (abolishing two outdated methods, introducing a single 66c per km rate, raising $845 million), tighten the zone tax offset by excluding fly-in fly-out workers ($325 million), cap uncapped entertainment benefits for not-for-profit employees at $5,000, and create a third-party reporting regime for specified transactions."
  }
 ],
