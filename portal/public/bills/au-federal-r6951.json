 "speeches": [
  {
   "slug": "speech-826997",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2023-02-07",
   "stage_hint": null,
   "brief": "Several bills were referred to the Federation Chamber for further consideration, including amendments to private health insurance, therapeutic goods, and export control legislation."
  },
  {
   "slug": "speech-827001",
   "speaker": "David Littleproud",
   "party": "Nationals",
   "state": "federal",
   "date": "2023-02-07",
   "stage_hint": null,
   "brief": "The coalition supported the Export Control Amendment (Streamlining Administrative Processes) Bill 2022, arguing it would cut red tape, improve information sharing for agricultural exports, and introduce penalties for unauthorised disclosures. The speaker also cited previous coalition achievements including $328.4 million for export red tape reduction, 11 free trade agreements, and criticised Labor for cutting $100 million from the Regional Accelerator Program."
  },
  {
   "slug": "speech-827237",
   "speaker": "Dan Repacholi",
   "party": "Labor",
   "state": "federal",
   "date": "2023-02-08",
   "stage_hint": null,
   "brief": "The Export Control Amendment (Streamlining Administrative Processes) Bill 2022 was debated and passed, with members arguing it will streamline information sharing, cut red tape, and support the goal of a $100 billion agriculture sector by 2030. Specific concerns were raised about the need for a fumigation plant in Cairns to support fruit and vegetable exports, and the bill was supported across the chamber."
  }
