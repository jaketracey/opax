   "brief": null
  },
  {
   "slug": "speech-792005",
   "speaker": "Mark Arbib",
   "party": "Labor",
   "state": "federal",
   "date": "2009-03-17",
   "stage_hint": null,
   "brief": "Two appropriation bills were introduced seeking a total of $2.2 billion (Bill No. 5) and $1.83 billion (Bill No. 6) for 2008‑2009, including $195 million for the East Kimberley Development Package, $1.189 billion in additional equity for the Australian Rail Track Corporation, $392 million for road projects (e.g., Bulahdelah Bypass, Western Ring Road, Northern Expressway), and $250 million for Murray‑Darling Basin water recovery."
  },
  {
   "slug": "speech-792331",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-03-19",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-792332",
   "speaker": "Helen Coonan",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-03-19",
   "stage_hint": null,
   "brief": "The coalition supported the appropriation bills despite criticising specific spending, including $13.95 million for a climate change advertising campaign, $101 million extra for a mismanaged solar panel rebate scheme, and $17.9 million for Pink Batts advertising, arguing the Rudd Labor government’s spending was reckless and increased the budget deficit."
  },
  {
   "slug": "speech-792341",
   "speaker": "Scott Ludlam",
   "party": "Greens",
   "state": "federal",
   "date": "2009-03-19",
   "stage_hint": null,
   "brief": "Tabled a letter from the Deputy Prime Minister to Senator Bob Brown; amendments and motions were agreed to, and bills were read a second time."
  },
