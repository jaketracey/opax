 "speeches": [
  {
   "slug": "speech-390587",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-03-23",
   "stage_hint": null,
   "brief": "The three supply bills—Supply Bill (No. 1) 2020‑2021 ($76.3 billion), Supply Bill (No. 2) 2020‑2021 ($6.7 billion), and Supply (Parliamentary Departments) Bill (No. 1) 2020‑2021 ($150 million)—were moved to fund government operations for the first seven months of 2020‑21, with the federal budget rescheduled to 6 October 2020 due to coronavirus uncertainty. The bills include advance to the finance minister provisions of $16 billion and $24 billion for urgent expenditure, subject to additional transparency measures."
  },
  {
   "slug": "speech-390589",
   "speaker": "Jim Chalmers",
   "party": "Labor",
   "state": "federal",
   "date": "2020-03-23",
   "stage_hint": null,
   "brief": "The speaker supported the supply bills, highlighting an unprecedented advance to the finance minister with new transparency measures requiring a press release for each use and opposition approval via Senator Gallagher for advances over $1 billion, and urged the government to release updated economic and budget forecasts to avoid a 10-month gap."
  },
  {
   "slug": "speech-390598",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-03-23",
   "stage_hint": null,
   "brief": "The speaker argued for the passage of three supply bills appropriating just under $83.2 billion for the first seven months of 2021, emphasising that the funding is interim and includes no new 2020-21 budget measures, only adjustments for COVID-19 and prior decisions."
  }
 ],
