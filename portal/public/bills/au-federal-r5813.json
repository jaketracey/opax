 "speeches": [
  {
   "slug": "speech-341772",
   "speaker": "Michael Keenan",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-02-16",
   "stage_hint": null,
   "brief": "The Crimes Amendment (Penalty Unit) Bill 2017 increases the Commonwealth penalty unit from $180 to $210 from 1 July 2017, and delays the first CPI adjustment until 1 July 2020. The change is expected to raise $80 million in additional revenue over four years."
  },
  {
   "slug": "speech-344755",
   "speaker": "Clare O'Neil",
   "party": "Labor",
   "state": "federal",
   "date": "2017-03-28",
   "stage_hint": null,
   "brief": "The speaker announced support for increasing the value of each Commonwealth penalty unit from $180 to $210, with indexation to CPI every three years and the first automatic increase delayed until 1 July 2020, applying to offences committed after commencement. The bill affects laws including the Corporations Act 2001, Fair Work Act 2009, Competition and Consumer Act 2010, National Consumer Credit Protection Act 2009, SPAM Act 2003, and Telecommunications Act 1997."
  },
  {
   "slug": "speech-344756",
   "speaker": "Julian Hill",
   "party": "Labor",
   "state": "federal",
   "date": "2017-03-28",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-344759",
   "speaker": "Jane Prentice",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-03-28",
   "stage_hint": null,
   "brief": "The Crimes Amendment (Penalty Unit) Bill 2017 increases the Commonwealth penalty unit from $180 to $210 from 1 July 2017, and delays the first automatic CPI adjustment until 1 July 2020, with indexation every three years thereafter, to strengthen financial penalties and deter crime."
  }
