  },
  {
   "slug": "speech-788401",
   "speaker": "Nicola Roxon",
   "party": "Labor",
   "state": "federal",
   "date": "2008-10-13",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-788402",
   "speaker": "Nicola Roxon",
   "party": "Labor",
   "state": "federal",
   "date": "2008-10-13",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-788569",
   "speaker": "Kim Carr",
   "party": "Labor",
   "state": "federal",
   "date": "2008-10-14",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-788570",
   "speaker": "Kim Carr",
   "party": "Labor",
   "state": "federal",
   "date": "2008-10-14",
   "stage_hint": null,
   "brief": "The bill increases the Medicare levy surcharge thresholds from $50,000 to $75,000 for individuals and from $100,000 to $150,000 for couples and families, with future indexation to wages growth. The speaker argued this delivers tax relief to 330,000 Australians and corrects a \"tax trap\" created by the previous government's failure to adjust the thresholds."
  },
  {
   "slug": "speech-788646",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2008-10-15",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-788647",
   "speaker": "Mathias Cormann",
   "party": "Liberal",
   "state": "federal",
   "date": "2008-10-15",
   "stage_hint": null,
   "brief": "The speaker argued that the Medicare levy surcharge thresholds should be raised to $75,000 for singles and $150,000 for families, with annual indexation, to restore the policy to its original intent of targeting high-income earners. The speaker stated that the change would provide tax relief to around 330,000 Australians and that the government had committed to ensuring no adverse impact on public hospitals."
  },
  {
   "slug": "speech-788648",
   "speaker": "Nick Xenophon",
   "party": "Independent",
   "state": "federal",
   "date": "2008-10-15",
   "stage_hint": null,
   "brief": "The speaker opposed Senator Xenophon's amendments to index the Medicare levy surcharge threshold to the CPI, arguing they would deny 100,000 Australians a tax cut and that the government's proposal to index the threshold to wages growth was more appropriate. The speaker also accused the opposition of an ideologically driven attack on private health and urged the Nationals to support the government's tax cut for 330,000 Australians."
  },
  {
   "slug": "speech-788678",
   "speaker": "Gary Humphries",
   "party": "Liberal",
   "state": "federal",
   "date": "2008-10-15",
   "stage_hint": null,
   "brief": "The speaker argued that the bill would worsen Queensland's hospital crisis by pushing more people into the public system, and criticised the government for failing to model the impact of 583,000 people leaving private health insurance, which would increase premiums and strain public hospitals."
  },
  {
   "slug": "speech-788721",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2008-10-16",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-788722",
   "speaker": "Nicola Roxon",
   "party": "Labor",
   "state": "federal",
   "date": "2008-10-16",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-788770",
   "speaker": "Russell Trood",
   "party": "Liberal",
   "state": "federal",
   "date": "2008-10-16",
   "stage_hint": null,
   "brief": "Amendments were moved to set the Medicare levy surcharge threshold at $70,000 for singles and $140,000 for couples, with indexation tied to AWOTE. The government stated 250,000 Australians would receive a tax cut and a rebate saving of $740.6 million, while critics argued the bill would force 492,000 people to leave private health insurance, costing $380 million in revenue and increasing premiums."
  },
  {
   "slug": "speech-788775",
   "speaker": "Carol Brown",
   "party": "Labor",
   "state": "federal",
   "date": "2008-10-16",
   "stage_hint": null,
   "brief": "The speaker argued that the government’s Medicare levy surcharge threshold changes would drive 500,000 people from private health insurance, removing $2.5 billion from the health system and inevitably increasing premiums, while failing to assess the impact on public hospitals. The speaker criticised the government for not ruling out premium hikes and claimed the policy was an ideological attack on private health."
  },
  {
   "slug": "speech-788776",
   "speaker": "Stephen Conroy",
   "party": "Labor",
   "state": "federal",
   "date": "2008-10-16",
   "stage_hint": null,
   "brief": null
  }
 ],
