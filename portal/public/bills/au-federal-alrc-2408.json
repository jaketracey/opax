  },
  {
   "slug": "speech-824349",
   "speaker": "Anne McEwen",
   "party": "Labor",
   "state": "federal",
   "date": "2013-06-17",
   "stage_hint": null,
   "brief": "Two reports were tabled: one on the Social Security Amendment (Supporting More Australians into Work) Bill 2013 and one on the Early Years Quality Fund Special Account Bill 2013, both ordered to be printed."
  },
  {
   "slug": "speech-825313",
   "speaker": "Mitch Fifield",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-06-28",
   "stage_hint": null,
   "brief": "The bill increases the income-free area for Newstart and other allowances from $62 to $100 per fortnight, extends the pensioner education supplement to single parents on Newstart, and provides a 12‑week extension of the pensioner concession card for single parents leaving parenting payment. The opposition and the Greens supported the bill but criticised it as insufficient, with the Greens calling for a $50‑per‑week increase to Newstart and additional support for single parents."
  }
