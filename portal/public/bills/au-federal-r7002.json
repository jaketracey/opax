 "speeches": [
  {
   "slug": "speech-828796",
   "speaker": "Matt Keogh",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-22",
   "stage_hint": null,
   "brief": "The Albanese Labor government introduced the Veterans' Affairs Legislation Amendment (Miscellaneous Measures) Bill 2023, which includes requiring an annual report from the Repatriation Medical Authority, replacing \"refuse\" with \"defer\" in claim processing language, and automating alignment of private vehicle allowance rates."
  },
  {
   "slug": "speech-829307",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-28",
   "stage_hint": null,
   "brief": "The Health Insurance Amendment (Prescribed Dental Patients and Other Measures) Bill 2023, Customs Tariff Amendment (Incorporation of Proposals) Bill 2023, Special Recreational Vessels Amendment Bill 2023, Veterans' Affairs Legislation Amendment (Miscellaneous Measures) Bill 2023, and Treasury Laws Amendment (Refining and Improving Our Tax System) Bill 2023 were referred to the Federation Chamber for further consideration at the adjournment of the second reading debate."
  },
  {
   "slug": "speech-829313",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2023-03-28",
   "stage_hint": null,
   "brief": "The Veterans' Affairs Legislation Amendment (Miscellaneous Measures) Bill 2023 makes minor technical amendments to four veterans' acts, including making the Repatriation Medical Authority's annual report compulsory; the coalition government invested $11.5 billion each year for around 340,000 veterans and families."
  }
 ],
