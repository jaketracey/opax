 "speeches": [
  {
   "slug": "speech-332935",
   "speaker": "Greg Hunt",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-09-01",
   "stage_hint": null,
   "brief": "The Statute Law Revision (Spring 2016) Bill 2016 corrects technical errors, modernises language, and repeals obsolete provisions in Commonwealth legislation, including amendments to the Public Lending Right Act 1985 and repeal of spent parts of the International Labour Organisation (Compliance with Conventions) Act 1992."
  },
  {
   "slug": "speech-333871",
   "speaker": "Nola Marino",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-09-14",
   "stage_hint": null,
   "brief": "Three bills—Statute Law Revision (Spring 2016) Bill 2016, Statute Update Bill 2016, and Corporations Amendment (Auditor Registration) Bill 2016—were referred to the Federation Chamber for further consideration upon adjournment of debate."
  },
  {
   "slug": "speech-333872",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2016-09-14",
   "stage_hint": null,
   "brief": "The bill makes technical corrections to Commonwealth laws, including fixing numbering errors and replacing obsolete references; Labor supports it but criticises the government for presenting routine legislation as part of a 25-point priority reform plan."
  },
  {
   "slug": "speech-334052",
   "speaker": "Graham Perrett",
   "party": "Labor",
   "state": "federal",
   "date": "2016-09-14",
   "stage_hint": null,
   "brief": "The Statute Law Revision (Spring 2016) Bill 2016 makes only minor corrections without changing the substance of the law, reflecting a lack of vision in the Turnbull-Joyce government. The government’s proposed plebiscite on same-sex marriage was criticised as harmful to LGBTQI Australians and as undermining representative democracy, while the government was noted to have lost 300 full-time jobs per day since the start of the year."
  }
 ],
