  {
   "slug": "speech-792590",
   "speaker": "Robert McClelland",
   "party": "Labor",
   "state": "federal",
   "date": "2009-05-14",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-793364",
   "speaker": "John Faulkner",
   "party": "Labor",
   "state": "federal",
   "date": "2009-06-15",
   "stage_hint": null,
   "brief": "The speaker moved that the bills proceed without formalities, be taken together and read a first time, with a plan to later list them separately on the Notice Paper."
  },
  {
   "slug": "speech-793365",
   "speaker": "John Faulkner",
   "party": "Labor",
   "state": "federal",
   "date": "2009-06-15",
   "stage_hint": null,
   "brief": "The speech announced the OzCar facility for car dealer financing, with a Commonwealth Guarantee covering around $550 million in securities, and introduced bills to strengthen journalists' privilege, streamline family tax benefit delivery, improve childcare administration and compliance, regulate life insurance non-operating holding companies, harmonise injunctions in prudential legislation, and amend fuel quality standards."
  },
  {
   "slug": "speech-795378",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-09-09",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795379",
   "speaker": "George Brandis",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-09-09",
   "stage_hint": null,
   "brief": "The opposition supported the Native Title Amendment Bill 2009, which gives the Federal Court central management of native title claims, allows both the court and tribunal to mediate, and aims for broader, quicker negotiated settlements. The speaker opposed the Greens' proposal to reverse the onus of proof for continuous connection to land."
  },
  {
   "slug": "speech-795590",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-09-14",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795591",
   "speaker": "Russell Trood",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-09-14",
   "stage_hint": null,
   "brief": "The speaker supported the Native Title Amendment Bill 2009 to give the Federal Court a central role in managing native title claims and mediation, aiming to speed up determinations, but expressed concerns about marginalising the National Native Title Tribunal, lack of consultation, and doubts that the procedural changes alone would significantly reduce the five-to-seven-year average resolution time."
  },
  {
   "slug": "speech-795620",
   "speaker": "David Johnston",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-09-14",
   "stage_hint": null,
   "brief": "The speaker argued that the Native Title Amendment Bill 2009 is a necessary step forward, though no panacea, and expressed scepticism about state governments' slow handling of claims and the cost-efficiency of representative bodies, while supporting greater Federal Court control and mediation to expedite the 511 pending cases."
  },
  {
   "slug": "speech-795621",
   "speaker": "Rachel Siewert",
   "party": "Greens",
   "state": "federal",
   "date": "2009-09-14",
   "stage_hint": null,
   "brief": "The Greens moved an amendment to reverse the onus of proof in native title claims, creating a presumption of continuity based on a proposal by Chief Justice Robert French. The amendment was opposed by both the government and opposition, and the government stated it would assess the impact of existing changes before considering further reforms."
  },
  {
   "slug": "speech-795622",
   "speaker": "Penny Wong",
   "party": "Labor",
   "state": "federal",
   "date": "2009-09-14",
   "stage_hint": null,
   "brief": null
  }
 ],
