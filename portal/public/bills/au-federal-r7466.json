 "divisions": [],
 "speeches": [
  {
   "slug": "speech-1202354",
   "speaker": "Michelle Rowland",
   "party": "Labor",
   "state": "federal",
   "date": "2026-04-01",
   "stage_hint": null,
   "brief": "Moved the second reading of a bill extending the sunset date of section 122.4 of the Criminal Code until 29 December 2026, maintaining the offence while parliament considers broader secrecy reforms proposed in the Secrecy Provisions Amendment (Repealing Offences) Bill."
  },
  {
   "slug": "speech-1202525",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2026-05-12",
   "stage_hint": null,
   "brief": "Referred the secrecy provisions bills and the Public and Educational Lending Rights bills to the Federation Chamber for further consideration after the relevant second-reading debates adjourn."
  },
  {
   "slug": "speech-1202526",
   "speaker": "Julian Leeser",
   "party": "Liberal",
   "state": "federal",
   "date": "2026-05-12",
   "stage_hint": null,
   "brief": "Argued that the coalition supports extending existing secrecy protections while seeking Senate scrutiny of the bills' scope, the undefined term 'improper', the absence of a sensitivity threshold, coverage of service providers, protections for former officials and the broader Attorney-General consent requirement for journalist prosecutions."
  },
  {
   "slug": "speech-1202722",
   "speaker": "Jo Briskey",
   "party": "Labor",
   "state": "federal",
   "date": "2026-05-13",
   "stage_hint": null,
   "brief": "Debated bills to reform Commonwealth secrecy offences, supporting proportionate criminal sanctions, protections for sensitive information and press-freedom safeguards while noting concerns about scrutiny and accountability; an amendment was moved, the immediate question remained unresolved, and the bill was returned for further consideration."
  },
  {
   "slug": "speech-1204248",
   "speaker": "Dean Smith",
   "party": "Liberal",
   "state": "federal",
   "date": "2026-06-29",
   "stage_hint": null,
   "brief": "Supported extending Criminal Code section 122.4 by six months to 29 December 2026, arguing this prevents a gap in criminal protections for Commonwealth-held sensitive information while broader secrecy reforms are scrutinised. The coalition opposed the companion repeal bill in its current form and urged stakeholder testing before substantive reforms are enacted."
  }
 ],
