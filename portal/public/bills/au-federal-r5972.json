 "speeches": [
  {
   "slug": "speech-355143",
   "speaker": "Andrew Leigh",
   "party": "Labor",
   "state": "federal",
   "date": "2017-10-18",
   "stage_hint": null,
   "brief": "The speaker supported the bill’s GST treatment of bitcoin and deductible gift recipient status for the Centre for Entrepreneurial Research and Innovation, but criticised the government for not tightening multinational tax loopholes, raising the tax transparency threshold from $100 million to $200 million, and cutting taxes for top earners while increasing taxes on middle Australia. They outlined Labor’s alternative proposals, including negative gearing reform, trust transparency, whistleblower protections, and mandatory disclosure of tax haven exposure."
  },
  {
   "slug": "speech-355144",
   "speaker": "Steven Ciobo",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-10-18",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-355328",
   "speaker": "Tim Watts",
   "party": "Labor",
   "state": "federal",
   "date": "2017-10-18",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (2017 Measures No. 6) Bill 2017 removes double taxation of digital currencies under GST by treating them like money, aligning Australia with the UK, US, and EU, and adds the Centre for Entrepreneurial Research and Innovation in Nedlands, Western Australia, to the deductible gift recipient list until 31 December 2021."
  }
 ],
