   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795484",
   "speaker": "Penny Wong",
   "party": "Labor",
   "state": "federal",
   "date": "2009-09-10",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795485",
   "speaker": "Penny Wong",
   "party": "Labor",
   "state": "federal",
   "date": "2009-09-10",
   "stage_hint": null,
   "brief": "The bill lowers the shareholder approval threshold for termination benefits from seven times total remuneration to one year’s base salary, extends coverage to key management personnel, broadens the definition of termination benefits, and increases penalties to $19,800 for individuals and $99,000 for corporations, while also barring directors and executives from voting on their own termination benefits."
  },
  {
   "slug": "speech-795991",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-09-17",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795992",
   "speaker": "Helen Coonan",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-09-17",
   "stage_hint": null,
   "brief": "The Coalition broadly supported the bill's objective of requiring shareholder approval for termination payments exceeding one year's base salary, but argued it would cause base pay to rise and had unintended consequences. The Coalition foreshadowed an amendment to change the threshold trigger from one year's base salary to one year's total salary."
  },
  {
   "slug": "speech-796003",
   "speaker": "David Bushby",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-09-17",
   "stage_hint": null,
   "brief": "The coalition senator argued that the government's bill on executive termination payments would create a \"squeezing the balloon\" effect, leading to increases in base salaries, golden hellos, and front-loaded payments, and that the threshold should be based on total remuneration rather than base salary. The senator also called for awaiting the Productivity Commission's final report and raised concerns about the bill's application to all companies, the definition of key terms, and the potential for higher overall remuneration costs."
  },
  {
   "slug": "speech-796629",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-10-29",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-796630",
   "speaker": "Chris Bowen",
   "party": "Labor",
   "state": "federal",
   "date": "2009-10-29",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-796805",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-11-16",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-796806",
   "speaker": "Nick Sherry",
   "party": "Labor",
   "state": "federal",
   "date": "2009-11-16",
   "stage_hint": null,
   "brief": "The Senate rejected an amendment by Senator Xenophon that would have required shareholder approval for virtually all termination benefits, including those below one year's base salary, with the government arguing it was unworkable and the opposition withdrawing support after legal advice highlighted unintended consequences. The Corporations Amendment (Improving Accountability on Termination Payments) Bill 2009 passed without the amendment."
  }
