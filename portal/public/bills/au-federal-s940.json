 "speeches": [
  {
   "slug": "speech-826474",
   "speaker": "Larissa Waters",
   "party": "Greens",
   "state": "federal",
   "date": "2013-12-09",
   "stage_hint": null,
   "brief": "Introduced the Landholders' Right to Refuse (Gas and Coal) Bill 2013, which would give Australian landholders the right to refuse gas and coal mining on their land without prior written authorisation."
  },
  {
   "slug": "speech-826475",
   "speaker": "Larissa Waters",
   "party": "Greens",
   "state": "federal",
   "date": "2013-12-09",
   "stage_hint": null,
   "brief": "The Landholders' Right to Refuse (Gas and Coal) Bill 2013 would give landholders the right to refuse gas and coal mining on food-producing land, requiring corporations to obtain written authorisation from all ownership interest holders before entry, with penalties and injunctions for unlawful entry. The bill applies to land that produced food in the previous 10 years, does not alter resource ownership, and leaves existing compulsory acquisition laws intact."
  }
 ],
