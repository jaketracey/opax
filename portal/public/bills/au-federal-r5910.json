 "speeches": [
  {
   "slug": "speech-349897",
   "speaker": "Chris Bowen",
   "party": "Labor",
   "state": "federal",
   "date": "2017-06-21",
   "stage_hint": null,
   "brief": "The Labor Party supports the Treasury Laws Amendment (2017 Measures No. 3) Bill 2017, which validates certain ASIC staff employment agreements and delegated powers made before 9 March 2017 to remedy legal uncertainty from a defect under the ASIC Act."
  },
  {
   "slug": "speech-349898",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2017-06-21",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (2017 Measures No. 3) Bill 2017 retrospectively validates invalid delegations of power to a small number of ASIC employees caused by a 1999 administrative error, removing legal risks without affecting current or former staff."
  }
 ],
