 "speeches": [
  {
   "slug": "speech-369868",
   "speaker": "David Coleman",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-09-19",
   "stage_hint": null,
   "brief": "The bill amends the Customs Act to give effect to free trade agreement product specific rules by direct reference to annexes, replacing lengthy regulations, and includes updates for AANZFTA, ChAFTA, and JAEPA to meet a 1 January 2019 deadline, with AANZFTA trade totalling A$120 billion in 2017."
  },
  {
   "slug": "speech-370855",
   "speaker": "Shayne Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2018-10-16",
   "stage_hint": null,
   "brief": "Labor supported the Customs Amendment (Product Specific Rule Modernisation) Bill 2018, which streamlines product-specific rules of origin for four free trade agreements (SAFTA, AANZFTA, JAEPA, ChAFTA) to allow updates without further legislative changes. The shadow minister also introduced the Fair Go for Australians in Trade Bill 2018, proposing measures to increase transparency, require independent national interest assessments, and ban clauses allowing foreign companies to sue the Australian government."
  },
  {
   "slug": "speech-370856",
   "speaker": "Andrew Broad",
   "party": "Nationals",
   "state": "federal",
   "date": "2018-10-16",
   "stage_hint": null,
   "brief": "The Customs Amendment (Product Specific Rule Modernisation) Bill 2018 makes technical changes to four free trade agreements—with ASEAN-New Zealand, Japan, China and Singapore—to automatically update product-specific rules of origin in domestic law, repealing over 2,500 pages of regulations. The member for Mallee argued the bill must pass in 2018 to meet treaty commitments, and emphasised that trade fosters peace and understanding, citing Australia’s post-war trade relationship with Japan as an example."
  }
 ],
