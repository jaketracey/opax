 "divisions": [],
 "speeches": [
  {
   "slug": "speech-1200101",
   "speaker": "Michelle Rowland",
   "party": "Labor",
   "state": "federal",
   "date": "2026-02-11",
   "stage_hint": null,
   "brief": "Moved the second reading of the Commonwealth Entities Legislation Amendment Bill 2026, proposing stronger appointment safeguards, accountability and integrity requirements for statutory office holders, including expanded termination and suspension powers and a limited general directions power for the Office of Parliamentary Counsel."
  },
  {
   "slug": "speech-1200461",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2026-03-03",
   "stage_hint": null,
   "brief": "Referred Appropriation Bills No.3 and No.4 2025-2026 and the Appropriation (Parliamentary Departments) Bill No.2 2025-2026 to the Federation Chamber immediately, with two other bills to follow the adjournment of their second-reading debates."
  },
  {
   "slug": "speech-1200462",
   "speaker": "Julian Leeser",
   "party": "Liberal",
   "state": "federal",
   "date": "2026-03-03",
   "stage_hint": null,
   "brief": "Argued that the Commonwealth Entities Legislation Amendment Bill 2026 would increase ministerial control over four statutory entities through performance standards, suspension and termination powers, and directions to the Office of Parliamentary Counsel. Supported accountability but sought Senate committee scrutiny of transparency, independence and procedural safeguards."
  },
  {
   "slug": "speech-1200841",
   "speaker": "Nita Green",
   "party": "Labor",
   "state": "federal",
   "date": "2026-03-04",
   "stage_hint": null,
   "brief": "Moved the Commonwealth Entities Legislation Amendment Bill 2026 for a second reading, arguing that it would strengthen appointment safeguards, accountability and integrity for statutory office holders while preserving relevant institutional independence."
  },
  {
   "slug": "speech-1201628",
   "speaker": "Michaelia Cash",
   "party": "Liberal",
   "state": "federal",
   "date": "2026-03-23",
   "stage_hint": null,
   "brief": "Opposed the Commonwealth Entities Legislation Amendment Bill 2026, arguing that it expands ministerial influence through performance standards, suspension and termination powers, and directions to the Office of Parliamentary Counsel. Said the bill affects four bodies, weakens parliamentary visibility and was not properly scrutinised after a committee referral was refused."
  },
  {
   "slug": "speech-1201692",
   "speaker": "Malcolm Roberts",
   "party": "One Nation",
   "state": "federal",
   "date": "2026-03-24",
   "stage_hint": null,
   "brief": "Argued that the Commonwealth Entities Legislation Amendment Bill 2026 could let ministers suspend or terminate senior public officials using discretionary, non-transparent standards. The government said the bill would strengthen accountability for misconduct and unsatisfactory performance among statutory office holders, and the question was put that the bill be read a second time."
  }
 ],
