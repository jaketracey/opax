   "date": "2009-08-20",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-794972",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-08-20",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-794973",
   "speaker": "Mark Bishop",
   "party": "Labor",
   "state": "federal",
   "date": "2009-08-20",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-794974",
   "speaker": "Penny Wong",
   "party": "Labor",
   "state": "federal",
   "date": "2009-08-20",
   "stage_hint": null,
   "brief": "The Greens did not oppose the bill but argued it falls short, lacking a 30% renewable target that would create over 10,000 extra jobs, and criticised it for rewarding big polluters and allowing native forests to be logged for \"green power.\""
  }
