  {
   "slug": "speech-329305",
   "speaker": "George Christensen",
   "party": "Nationals",
   "state": "federal",
   "date": "2016-02-29",
   "stage_hint": null,
   "brief": "The speaker argued that the Flags Amendment (Protecting Australian Flags) Bill 2016 should criminalise the wilful destruction or mutilation of the Australian flag, the Australian red ensign, the Aboriginal flag, and the Torres Strait Islander flag, citing a 2015 flag-burning incident where protesters chanted \"No pride in genocide\" and \"Always was, always will be, Aboriginal land.\" The speaker claimed the Australian Human Rights Commission had failed to apply section 18C of the Racial Discrimination Act equally, and warned that suppressing free speech through political correctness could lead to the rise of figures like Pauline Hanson and Donald Trump."
  }
 ],
