 "speeches": [
  {
   "slug": "speech-278155",
   "speaker": "Greg Hunt",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": "Moved that the bill be read a second time, proposing an exemption from the equivalent carbon price for bulk synthetic greenhouse gas imports between 1 April and 30 June 2014, subject to conditions."
  },
  {
   "slug": "speech-825380",
   "speaker": "Greg Hunt",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-278597",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-18",
   "stage_hint": null,
   "brief": "Moved a debate management motion to conclude debate on the Clean Energy Legislation (Carbon Tax Repeal) Bill 2013 and related bills by Thursday this week, arguing the election gave the coalition a mandate with 90 seats to Labor's 55, Labor's worst result since 1903."
  },
  {
   "slug": "speech-278606",
   "speaker": "Bill Shorten",
   "party": "Labor",
   "state": "federal",
   "date": "2013-11-18",
   "stage_hint": null,
   "brief": "Argued against the government's carbon tax repeal bills, saying the decade from 2001 to 2010 was the warmest on record, that Direct Action would cost households an estimated $1,200 a year without a legislated cap on emissions, and noted that under Labor wind power generation trebled and 24,000 renewable energy jobs were created."
  },
  {
   "slug": "speech-825612",
   "speaker": "Christopher Pyne",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-18",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-825613",
   "speaker": "Bill Shorten",
   "party": "Labor",
   "state": "federal",
   "date": "2013-11-18",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-279379",
   "speaker": "Greg Hunt",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-11-21",
   "stage_hint": null,
   "brief": "Presented a replacement explanatory memorandum and argued that repealing the carbon tax honoured election commitments, would reduce household electricity bills by approximately $200 and gas bills by approximately $70, and would improve competitiveness and living standards."
  }
 ],
