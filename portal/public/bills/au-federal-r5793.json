 "speeches": [
  {
   "slug": "speech-339830",
   "speaker": "Scott Morrison",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-12-01",
   "stage_hint": null,
   "brief": "The bill reduces the tax rate on superannuation payments for departing working holiday-makers from 95% to 65%, effective 1 July 2017, costing $55 million in revenue. This change is part of a government package negotiated with Senate crossbenchers and the Greens to lower the income tax rate for working holiday-makers to 15%."
  },
  {
   "slug": "speech-339848",
   "speaker": "Anthony Albanese",
   "party": "Labor",
   "state": "federal",
   "date": "2016-12-01",
   "stage_hint": null,
   "brief": "The speaker argued the backpacker tax has devolved into a chaotic farce, citing a joint statement from Treasurer Scott Morrison and Senator Di Natale, and criticised the government for a $155 million backtrack on the policy, which they said contradicts its claims of fiscal responsibility."
  }
