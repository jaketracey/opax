 "speeches": [
  {
   "slug": "speech-381990",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2019-09-19",
   "stage_hint": null,
   "brief": "Labor supports the bill but will move amendments to require firms accessing the fintech regulatory sandbox to demonstrate genuine innovation and customer benefit; the speaker also argued the bill does not address key industry barriers such as skills shortages and capital access."
  },
  {
   "slug": "speech-381992",
   "speaker": "Matt Thistlethwaite",
   "party": "Labor",
   "state": "federal",
   "date": "2019-09-19",
   "stage_hint": null,
   "brief": "Labor supported the bill creating a fintech regulatory sandbox and minor venture capital tax changes, but argued the government is not doing enough to boost start-ups and productivity, citing Australia's falling global rankings and declining business investment. Labor planned to introduce amendments addressing consumer advocate concerns about the sandbox."
  },
  {
   "slug": "speech-382751",
   "speaker": "Ben Morton",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-10-15",
   "stage_hint": null,
   "brief": "The government argued that the Treasury Laws Amendment (2018 Measures No. 2) Bill 2019 would support fintech innovation by extending the regulatory sandbox in the Corporations Act to allow testing without an ASIC licence and by making technical amendments to clarify tax incentives for venture capital and early-stage investors."
  }
 ],
