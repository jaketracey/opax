 "speeches": [
  {
   "slug": "speech-309576",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2015-05-12",
   "stage_hint": null,
   "brief": "The Appropriation Bill (No. 2) 2015-2016 seeks approval for over $15 billion in spending, including $7.4 billion for the National Broadband Network, $3 billion for infrastructure (including a $2 billion loan for WestConnex stage 2 and $250 million for ACT asbestos remediation), and $2.9 billion for defence capital funding. The bill also sets debit limits for nation-building funds, with no new projects to commence as the funds are being wound up."
  },
  {
   "slug": "speech-309577",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2015-05-12",
   "stage_hint": null,
   "brief": "The Appropriation (Parliamentary Departments) Bill (No. 1) 2015-2016 seeks over $233 million for the Department of the Senate, Department of the House of Representatives, Department of Parliamentary Services, and the Parliamentary Budget Office, including just over $28 million for cybersecurity enhancements."
  },
  {
   "slug": "speech-310281",
   "speaker": "Scott Buchholz",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-05-25",
   "stage_hint": null,
   "brief": "The speaker referred five appropriation bills to the Federation Chamber for further consideration at the adjournment of the House."
  },
  {
   "slug": "speech-310783",
   "speaker": "Nick Champion",
   "party": "Labor",
   "state": "federal",
   "date": "2015-05-26",
   "stage_hint": null,
   "brief": "The speaker argued the 2015-2016 budget is fundamentally unfair, citing NATSEM modelling that nine out of ten lowest-income families lose while nine out of ten wealthiest families benefit, and criticised cuts to family tax benefits, paid parental leave, and the impact on South Australian jobs at Holden and in shipbuilding."
  }
 ],
