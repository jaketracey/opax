 "speeches": [
  {
   "slug": "speech-409929",
   "speaker": "Alan Tudge",
   "party": "Liberal",
   "state": "federal",
   "date": "2021-06-24",
   "stage_hint": null,
   "brief": "The bill amends the Education Services for Overseas Students (Registration Charges) Act 1997 to implement an updated cost-recovery model for CRICOS registration charges, reducing provider payments by approximately $7 million per year. From 1 January 2022, only the Department of Education, Skills and Employment's regulatory costs will be recovered under this Act, with ASQA and TEQSA charging separately under their own frameworks."
  },
  {
   "slug": "speech-409932",
   "speaker": "Alan Tudge",
   "party": "Liberal",
   "state": "federal",
   "date": "2021-06-24",
   "stage_hint": null,
   "brief": "The bill amends the Tertiary Education Quality and Standards Agency (Charges) Act 2021 to correctly reference charges under proposed amendments to the Education Services for Overseas Students (Registration Charges) Act 1997."
  },
  {
   "slug": "speech-410649",
   "speaker": "Graham Perrett",
   "party": "Labor",
   "state": "federal",
   "date": "2021-08-05",
   "stage_hint": null,
   "brief": "The speaker supported the bills as they reduce charges on international education providers by $7 million a year, but criticised the Morrison government for damaging higher education, jeopardising jobs and research, and using ministerial discretion to avoid parliamentary scrutiny."
  }
 ],
