 "speeches": [
  {
   "slug": "speech-351782",
   "speaker": "Shayne Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2017-08-16",
   "stage_hint": null,
   "brief": "Labor announced support for the Migration Amendment (Validation of Decisions) Bill 2017, which preserves existing visa refusal or cancellation decisions on character grounds that relied on protected information from intelligence agencies, and referred the bill to a Senate inquiry reporting on 4 September 2017."
  },
  {
   "slug": "speech-351783",
   "speaker": "Graham Perrett",
   "party": "Labor",
   "state": "federal",
   "date": "2017-08-16",
   "stage_hint": null,
   "brief": "Labor supported the Migration Amendment (Validation of Decisions) Bill 2017, arguing it was crucial for national security and visa integrity, while criticising Minister Dutton for using the issue as a \"cheap political tool\" and for incompetence. The speaker noted concerns raised by the Parliamentary Joint Committee on Human Rights, including due process, non-refoulement, and family separation risks, and called for a Senate inquiry to address them."
  },
  {
   "slug": "speech-351784",
   "speaker": "Peter Dutton",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-08-16",
   "stage_hint": null,
   "brief": "The minister argued that the Migration Amendment (Validation of Decisions) Bill 2017 is needed to uphold visa cancellations and refusals on character grounds for non‑citizens who have committed serious crimes, and to protect intelligence‑sharing with law enforcement agencies; he also criticised the Labor Party’s record on border protection, claiming 1,200 people drowned at sea under their government and that Labor would return to that policy."
  }
