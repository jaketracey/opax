 "speeches": [
  {
   "slug": "speech-376598",
   "speaker": "Matt Thistlethwaite",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": "Labor supported the Treasury Laws Amendment (2019 Petroleum Resource Rent Tax Reforms No. 1) Bill 2019, which lowers uplift rates on carry-forward expenditure and removes onshore petroleum projects from the PRRT, but moved an amendment calling on the government to also act on multinational tax loopholes and tax havens."
  },
  {
   "slug": "speech-376600",
   "speaker": "Stuart Robert",
   "party": "LNP",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (2019 Petroleum Resource Rent Tax Reforms No. 1) Bill 2019 lowers the uplift rate on exploration expenditure to prevent excessive deduction compounding and removes onshore projects from the PRRT to stop transfer of deductions to offshore projects, strengthening tax integrity and ensuring a fairer return for Australia's oil and gas resources."
  }
 ],
