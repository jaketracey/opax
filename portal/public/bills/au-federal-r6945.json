 "speeches": [
  {
   "slug": "speech-826891",
   "speaker": "Angus Taylor",
   "party": "Liberal",
   "state": "federal",
   "date": "2023-02-06",
   "stage_hint": null,
   "brief": "The opposition supported the Treasury Laws Amendment (Modernising Business Communications and Other Measures) Bill, arguing it reduces red tape—estimated to cost the economy $176 billion annually—and modernises business communications by implementing ALRC recommendations and making electronic signatures and virtual meetings permanent. The speaker also criticised the government’s spending, the dropping of budget balance as an objective, and the absence of a digital economy minister, claiming these policies fuel inflation and interest rate rises."
