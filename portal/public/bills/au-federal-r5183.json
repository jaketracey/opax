 "speeches": [
  {
   "slug": "speech-284779",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-03-06",
   "stage_hint": null,
   "brief": "Introduced the Quarantine Charges (Imposition-Customs) Bill, the second of four companion bills, which imposes biosecurity charges only when they constitute a duty of customs and mirrors the general imposition bill's provisions without itself setting charge amounts."
  },
  {
   "slug": "speech-284781",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-03-06",
   "stage_hint": null,
   "brief": "Introduced the Quarantine Charges (Collection) Bill, the last of four companion bills, giving the Commonwealth power to collect biosecurity charges and late payment fees, including suspending import permits, seizing or selling goods and vessels, and pursuing unpaid debts through the courts."
  },
  {
   "slug": "speech-285629",
   "speaker": "Joel Fitzgibbon",
   "party": "Labor",
   "state": "federal",
   "date": "2014-03-18",
   "stage_hint": null,
   "brief": "Moved a second reading amendment condemning the government for quarantine funding cuts, noting the National Farmers' Federation shares this concern, while confirming Labor's support for the Quarantine Charges (Collection) Bill 2014 and related bills as a cost recovery package originating in the Beale report."
  },
  {
   "slug": "speech-285980",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-03-19",
   "stage_hint": null,
   "brief": "Supported the Quarantine Charges bills, criticising Labor's decision to lift a 90-year ban on New Zealand apple imports, which risked introducing fire blight to Batlow's 120-year-old apple industry, employing about 2,500 people, and noted three of the first 13 New Zealand consignments were denied entry over biosecurity concerns."
  }
 ],
