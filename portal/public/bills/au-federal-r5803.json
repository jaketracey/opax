 "speeches": [
  {
   "slug": "speech-341528",
   "speaker": "Tony Zappia",
   "party": "Labor",
   "state": "federal",
   "date": "2017-02-15",
   "stage_hint": null,
   "brief": "The speaker argued that the bills to establish the Independent Parliamentary Expenses Authority (IPEA) will improve transparency and public trust, while noting that 87% of current MPs—those elected after 2004—no longer receive a pension or generous travel allowances. He welcomed the authority for clarifying expense rules and providing a reference point for MPs, though he cautioned that oversight costs may exceed savings."
  },
  {
   "slug": "speech-341530",
   "speaker": "Darren Chester",
   "party": "Nationals",
   "state": "federal",
   "date": "2017-02-15",
   "stage_hint": null,
   "brief": "The Independent Parliamentary Expenses Authority (Consequential Amendments) Bill 2017 is the first step in the biggest reforms to managing parliamentarians' expenses in more than a generation, establishing a new authority to provide clear guidance and ensure accountability. The government will continue implementing recommendations from an independent entitlements review, and a consequential amendment to the Freedom of Information Act will allow the authority to give confidential advice on travel expenses."
  }
 ],
