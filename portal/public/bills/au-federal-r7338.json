 "speeches": [
  {
   "slug": "speech-1195134",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2025-07-23",
   "stage_hint": null,
   "brief": "Moved the Australian Security Intelligence Organisation Amendment Bill (No. 1) 2025 to extend ASIO's compulsory questioning powers by 18 months until 7 March 2027, allowing reforms and Parliamentary Joint Committee on Intelligence and Security consideration to proceed; debate was adjourned."
  },
  {
   "slug": "speech-1195697",
   "speaker": "Joanne Ryan",
   "party": "Labor",
   "state": "federal",
   "date": "2025-07-30",
   "stage_hint": null,
   "brief": "Declared that, unless otherwise ordered, six bills stood referred to the Federation Chamber after debate on their second-reading motions was adjourned."
  },
  {
   "slug": "speech-1195698",
   "speaker": "Andrew Hastie",
   "party": "Liberal",
   "state": "federal",
   "date": "2025-07-30",
   "stage_hint": null,
   "brief": "Supported the bill extending ASIO compulsory questioning warrants for 18 months to 7 March 2027. Reported that the extension would prevent disruption while substantive reforms are considered, and supported the bill without amendment while emphasising oversight, accountability and transparency."
  },
  {
   "slug": "speech-1195792",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2025-07-30",
   "stage_hint": null,
   "brief": "Supported Australian Security Intelligence Organisation amendment bills to maintain compulsory questioning powers, require post-charge questioning before a retired judge, make the framework permanent and provide Parliamentary Joint Committee on Intelligence and Security review."
  },
  {
   "slug": "speech-1196026",
   "speaker": "Tim Ayres",
   "party": "Labor",
   "state": "federal",
   "date": "2025-07-31",
   "stage_hint": null,
   "brief": "Moved that four bills be read a second time and had their second reading speeches incorporated. The bills would extend ASIO compulsory questioning powers by 18 months, expand Defence Housing Australia's functions, repeal pathology application fees, and establish a Pacific banking guarantee; further consideration was adjourned to the first sitting day of the next period."
  }
 ],
