 "speeches": [
  {
   "slug": "speech-309579",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2015-05-12",
   "stage_hint": null,
   "brief": "The Appropriation Bill (No. 6) 2014-2015 seeks approval for $423 million in supplementary appropriations, with $412 million for the Department of Defence to cover foreign exchange movements and fund reallocations, and $10 million for the Department of Social Services to continue developing the My Aged Care gateway."
  },
  {
   "slug": "speech-310281",
   "speaker": "Scott Buchholz",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-05-25",
   "stage_hint": null,
   "brief": "The speaker referred five appropriation bills to the Federation Chamber for further consideration at the adjournment of the House."
  },
  {
   "slug": "speech-310783",
   "speaker": "Nick Champion",
   "party": "Labor",
   "state": "federal",
   "date": "2015-05-26",
   "stage_hint": null,
   "brief": "The speaker argued the 2015-2016 budget is fundamentally unfair, citing NATSEM modelling that nine out of ten lowest-income families lose while nine out of ten wealthiest families benefit, and criticised cuts to family tax benefits, paid parental leave, and the impact on South Australian jobs at Holden and in shipbuilding."
  }
 ],
