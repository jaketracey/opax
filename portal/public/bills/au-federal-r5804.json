 "divisions": [],
 "speeches": [
  {
   "slug": "speech-340611",
   "speaker": "Scott Morrison",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-02-09",
   "stage_hint": null,
   "brief": "The Diverted Profits Tax Bill 2017 imposes a 40% penalty tax on multinationals diverting Australian profits to low-tax offshore related parties lacking economic substance, aiming to reduce tax avoidance and speed up ATO dispute resolution."
  },
  {
   "slug": "speech-343524",
   "speaker": "Andrew Leigh",
   "party": "Labor",
   "state": "federal",
   "date": "2017-03-21",
   "stage_hint": null,
   "brief": "The government's bill hides a $50 billion tax cut for big banks and multinationals behind a weak approach to multinational tax avoidance, raising only $200 million. Labor supports the bill but calls for an explanation, and notes its own proposals would raise $1.6 billion over the forward estimates."
  },
  {
   "slug": "speech-343529",
   "speaker": "Kevin Hogan",
   "party": "Nationals",
   "state": "federal",
   "date": "2017-03-21",
   "stage_hint": null,
   "brief": "The speaker argued for the Treasury Laws Amendment (Combating Multinational Tax Avoidance) Bill 2017 and the Diverted Profits Tax Bill 2017, which impose a 40% penalty rate on diverted profits and increase penalties for large multinationals (e.g., up to $525,000 for late lodgement). The laws are expected to claw back $2 billion in tax this financial year, raise $200 million over forward estimates, and have already prompted Facebook and Google to restructure their Australian tax arrangements."
  }
 ],
