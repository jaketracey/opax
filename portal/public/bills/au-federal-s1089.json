 "speeches": [
  {
   "slug": "speech-376913",
   "speaker": "Clare O'Neil",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-04",
   "stage_hint": null,
   "brief": "Labor’s amendments to the bill expanded the member outcomes test to cover choice superannuation products, which were originally exempted, and increased penalties for misconduct to over $500,000. The speaker also criticised the government for failing to implement royal commission recommendations and outlined plans to address unpaid superannuation and the gender gap, including paying super on Commonwealth paid parental leave."
  },
  {
   "slug": "speech-376914",
   "speaker": "Matt Thistlethwaite",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-04",
   "stage_hint": null,
   "brief": "Labor supported the bill but argued the government's original version exempted 83% of bank-owned retail super assets by only covering MySuper products, not choice products. Labor successfully amended the bill to extend portfolio holdings disclosure, APRA powers and outcomes assessments to choice products, and argued penalties for directors should exceed $500,000 and be retrospective to October 2015."
  },
  {
   "slug": "speech-376915",
   "speaker": "Matt Keogh",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-04",
   "stage_hint": null,
   "brief": "The Labor MP supported the Treasury Laws Amendment (Improving Accountability and Member Outcomes in Superannuation Measures No. 1) Bill 2019 after Senate amendments expanded its accountability requirements to all superannuation funds, not just MySuper accounts. He criticised the government for originally exempting retail funds and for opposing penalty rate restoration, and stated Labor would legislate to restore penalty rates and make superannuation guarantee payments part of the National Employment Standards."
  }
 ],
