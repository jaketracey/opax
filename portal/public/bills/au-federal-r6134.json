 "speeches": [
  {
   "slug": "speech-364862",
   "speaker": "Peter Dutton",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-06-20",
   "stage_hint": null,
   "brief": "The Migration (Validation of Port Appointment) Bill 2018 confirms the validity of a 2002 port appointment at Ashmore and Cartier Islands, ensuring that illegal maritime arrivals who entered via that port between 23 January 2002 and 1 June 2013 remain classified as unauthorised maritime arrivals and, where applicable, fast-track applicants under the Migration Act 1958. The bill maintains the status quo and does not apply to cases where a court has already set aside or declared the appointment invalid."
  },
  {
   "slug": "speech-367294",
   "speaker": "Shayne Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2018-08-16",
   "stage_hint": null,
   "brief": "The motion substituted words to note poor drafting of immigration legislation by successive Coalition governments, citing a 2002 gazette error by minister Ruddock that omitted coordinates for a port. Labor supported the bill while reiterating its asylum seeker policy of strong borders and regional resettlement, including accepting New Zealand's offer."
  },
  {
   "slug": "speech-367298",
   "speaker": "Kelly O'Dwyer",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-08-16",
   "stage_hint": null,
   "brief": "The Migration (Validation of Port Appointment) Bill 2018 confirms the validity of a 2002 port appointment at Ashmore and Cartier Islands, ensuring that unauthorised boat arrivals entering through that port between 23 January 2002 and 1 June 2013 remain classified as unauthorised maritime arrivals and, where applicable, fast-track applicants. The bill prevents legal challenges to the appointment that could undermine border protection policies."
  }
 ],
