 "speeches": [
  {
   "slug": "speech-398502",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-11-11",
   "stage_hint": null,
   "brief": "The bill makes eligible state and territory coronavirus business grants tax-free, including Victorian grants announced 13 September 2020, allows direct transfer of unclaimed super from New Zealand residents to KiwiSaver funds, and adds Neighbourhood Watch Australasia Limited to the list of deductible gift recipients."
  },
  {
   "slug": "speech-400489",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2020-12-08",
   "stage_hint": null,
   "brief": "The speaker moved a second reading amendment to the Treasury Laws Amendment Bill, arguing the government's pandemic economic support has been insufficient and that state and territory governments—including those led by Dan Andrews, Mark McGowan, Annastacia Palaszczuk, Andrew Barr, and Michael Gunner—have borne the costs. The amendment also calls on the government to commit to legislated superannuation increases, noting the Prime Minister receives 15.4% superannuation while proposing 9.5% for others."
  }
 ],
