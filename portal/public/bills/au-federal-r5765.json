  {
   "slug": "speech-337652",
   "speaker": "Adam Bandt",
   "party": "Greens",
   "state": "federal",
   "date": "2016-11-21",
   "stage_hint": null,
   "brief": "The Greens introduced the Fair Work Amendment (Protecting Christmas) Bill 2016 to ensure workers receive public holiday penalty rates on Christmas Day (25 December) and New Year's Day (1 January), regardless of state or territory declarations. The bill responds to the Victorian Labor government's decision not to declare Christmas Day a public holiday when it falls on a Sunday, which the Greens argued would deny Victorian workers penalty rates."
  }
 ],
