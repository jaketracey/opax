 "speeches": [
  {
   "slug": "speech-394002",
   "speaker": "Sussan Ley",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-08-27",
   "stage_hint": null,
   "brief": "The Recycling and Waste Reduction Charges (General) Bill 2020 enables cost recovery for administering the waste export ban, which phases out exports of waste glass from 1 January 2021, mixed plastics from 1 July 2021, whole used tyres from 1 December 2021, single polymer plastics from 1 July 2022, and mixed paper and cardboard from 1 July 2024."
  },
  {
   "slug": "speech-394003",
   "speaker": "Sussan Ley",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-08-27",
   "stage_hint": null,
   "brief": "The Recycling and Waste Reduction Charges (Customs) Bill 2020 imposes customs duties as part of the waste export ban charging package, with charge amounts and liable parties to be set by regulation."
  },
  {
   "slug": "speech-394004",
   "speaker": "Sussan Ley",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-08-27",
   "stage_hint": null,
   "brief": "The Recycling and Waste Reduction Charges (Excise) Bill 2020 was moved for a second reading, forming part of the waste export ban charging legislative package. It imposes charges only when considered a duty of excise, with amounts and exemptions to be set in regulations, and does not itself set charge amounts or impose financial impacts."
  },
  {
   "slug": "speech-397397",
   "speaker": "Dan Tehan",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-10-28",
   "stage_hint": null,
   "brief": "The speaker moved to rescind the third readings of five recycling and waste reduction bills and to immediately call them on again, with a Minister moving each third reading and the question put without debate."
  }
 ],
