 "speeches": [
  {
   "slug": "speech-1195281",
   "speaker": "Daniel Mulino",
   "party": "Labor",
   "state": "federal",
   "date": "2025-07-24",
   "stage_hint": null,
   "brief": "Reintroduced the Pacific Banking Guarantee Bill 2025 to allow the Commonwealth to guarantee eligible Australian banks' Pacific operations against a regional default, with banks paying a fee, to help preserve correspondent banking access and the Pacific's connection to the global financial system."
  },
  {
   "slug": "speech-1195697",
   "speaker": "Joanne Ryan",
   "party": "Labor",
   "state": "federal",
   "date": "2025-07-30",
   "stage_hint": null,
   "brief": "Declared that, unless otherwise ordered, six bills stood referred to the Federation Chamber after debate on their second-reading motions was adjourned."
  },
  {
   "slug": "speech-1195699",
   "speaker": "Pat Conaghan",
   "party": "Nationals",
   "state": "federal",
   "date": "2025-07-30",
   "stage_hint": null,
   "brief": "Supported the principle of the bill and reported that an announced $2 billion, 10-year guarantee for ANZ was its first guarantee. Asked for Senate Economics Legislation Committee scrutiny of the uncapped, open-ended appropriation, citing taxpayer protection and risks to Pacific correspondent banking relationships."
  },
  {
   "slug": "speech-1195967",
   "speaker": "Tony Sheldon",
   "party": "Labor",
   "state": "federal",
   "date": "2025-07-31",
   "stage_hint": null,
   "brief": "Presented the Selection of Bills Committee report and moved its adoption, including referrals of aged care, Fair Work and Pacific banking bills; amendments proposed public inquiries into intelligence and Defence Housing Australia bills, and the amended motion was agreed to."
  },
  {
   "slug": "speech-1196646",
   "speaker": "James Paterson",
   "party": "Liberal",
   "state": "federal",
   "date": "2025-08-28",
   "stage_hint": null,
   "brief": "Supported the Pacific Banking Guarantee Bill 2025 on strategic grounds, arguing that Australian banking services should remain available in the Pacific. Raised concerns about uncapped appropriations, taxpayer liabilities and limited consultation with Bank South Pacific, but said Treasury assessed taxpayer risk as very low."
  },
  {
   "slug": "speech-1196659",
   "speaker": "Sue Lines",
   "party": "Labor",
   "state": "federal",
   "date": "2025-08-28",
   "stage_hint": null,
   "brief": "Debated the Pacific Banking Guarantee Bill 2025, which would allow guarantees for eligible Australian banks to maintain banking services in the Pacific and Timor-Leste. Support was expressed for regional connectivity, while concerns were raised about Australian banks' competitive advantage, potentially unlimited liability and limited transparency; the bill was read a second time."
  }
 ],
