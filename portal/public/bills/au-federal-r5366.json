  "attribution": "Written by a model from the explanatory memorandum; not the record",
  "describes_version": "revised",
  "as_of": "2014-10-22",
  "sentences": [
   "This bill is part of a package that would simplify telecommunications rules while keeping consumer protections.",
   "The package would abolish the Telecommunications Universal Service Management Agency and move its functions to the Department of Communications.",
   "The package would make the registration period for telephone numbers on the Do Not Call Register last forever."
  ],
  "changes": [
   "Abolishes the Telecommunications Universal Service Management Agency.",
   "Transfers industry levy provisions to the Telecommunications (Consumer Protection and Service Standards) Act 1999.",
   "Makes the Do Not Call Register registration period indefinite.",
   "Removes e-marketing industry code registration by the Australian Communications and Media Authority.",
   "Repeals Part 9A of the Consumer Protection Act regulating telephone sex services."
  ],
  "affected": "Telecommunications providers, consumers, and the Department of Communications.",
