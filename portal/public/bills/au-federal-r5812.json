 "speeches": [
  {
   "slug": "speech-344746",
   "speaker": "Jenny Macklin",
   "party": "Labor",
   "state": "federal",
   "date": "2017-03-28",
   "stage_hint": null,
   "brief": "Labor supported the bill amending the Disability Services Act 1986 to align the upper age limit for disability employment services with pension age, costing $4.6 million and affecting around 200 vulnerable people."
  },
  {
   "slug": "speech-344747",
   "speaker": "Christian Porter",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-03-28",
   "stage_hint": null,
   "brief": "The bill aligns the upper age limit for Disability Employment Services with the gradually increasing pension age (from 65 to 67 by 2024), preventing an estimated 200 vulnerable people from losing support this year."
  }
 ],
