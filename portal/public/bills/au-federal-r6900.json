 "speeches": [
  {
   "slug": "speech-422503",
   "speaker": "Madeleine King",
   "party": "Labor",
   "state": "federal",
   "date": "2022-09-08",
   "stage_hint": null,
   "brief": "The government introduced the Atomic Energy Amendment (Mine Rehabilitation and Closure) Bill 2022 to extend Ranger Uranium Mine's regulatory framework beyond January 2026, allowing operator Energy Resources of Australia (ERA) to continue rehabilitation and enabling progressive closure of rehabilitated land parcels, without recommencing mining or altering environmental standards."
  }
