 "speeches": [
  {
   "slug": "speech-422264",
   "speaker": "Clare Ellen O'Neil",
   "party": "Labor",
   "state": "federal",
   "date": "2022-09-07",
   "stage_hint": null,
   "brief": "The bill transforms the former government's $4.8 billion Emergency Response Fund, which spent nothing on mitigation or recovery over three years, into the Disaster Ready Fund providing up to $200 million annually for resilience and risk reduction projects. The government also announced $150 million for recovery in the Northern Rivers region and the establishment of the National Emergency Management Agency to administer disaster-related functions."
