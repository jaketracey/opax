 "speeches": [
  {
   "slug": "speech-1194705",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2025-03-25",
   "stage_hint": null,
   "brief": "Moved procedural arrangements to sequence debate and votes on Supply Bills, the Transport Security Amendment Bill 2024, the Parliamentary Business Resources Legislation Amendment Bill 2025 and the Environment Protection and Biodiversity Conservation Amendment Bill 2025. Said the motion was needed because Senate estimates would prevent later consideration."
  },
  {
   "slug": "speech-1194764",
   "speaker": "Lisa Chesters",
   "party": "Labor",
   "state": "federal",
   "date": "2025-03-25",
   "stage_hint": null,
   "brief": "Reported that debate time had expired under an earlier resolution and put the questions required to complete consideration of the listed bills; the question was agreed to and the bill was read a second time."
  },
  {
   "slug": "speech-1194775",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2025-03-25",
   "stage_hint": null,
   "brief": "Moved that Appropriation (Parliamentary Departments) Bill (No. 1) be read a second time, seeking $195.3 million from the Consolidated Revenue Fund for parliamentary departments in 2025-26, including over $155 million for the Department of Parliamentary Services."
  },
  {
   "slug": "speech-1194835",
   "speaker": "Jenny McAllister",
   "party": "Labor",
   "state": "federal",
   "date": "2025-03-25",
   "stage_hint": null,
   "brief": "Tabled proposed and certain proposed expenditure for the year ending on 30 June 2026, including expenditure for parliamentary departments and the Supply Bill (No. 1) 2025-2026 and Supply Bill (No. 2) 2025-2026, then moved for referral to legislation committees; the motion was agreed to."
  }
 ],
