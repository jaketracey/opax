 "speeches": [
  {
   "slug": "speech-376645",
   "speaker": "Andrew Leigh",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-03",
   "stage_hint": null,
   "brief": "Labor supported the Treasury Laws Amendment (Medicare Levy and Medicare Levy Surcharge) Bill 2019, which raises Medicare levy low-income thresholds in line with CPI for 2018-19. The party also criticised the government for hospital funding cuts, citing $715 million in current cuts and a $3 billion Medicare rebate freeze, and proposed a $2.8 billion Better Hospitals Fund."
  },
  {
   "slug": "speech-376646",
   "speaker": "Stuart Robert",
   "party": "LNP",
   "state": "federal",
   "date": "2019-04-03",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (Medicare Levy and Medicare Levy Surcharge) Bill 2019 increases Medicare levy low-income thresholds for singles, families, seniors and pensioners in line with CPI. For 2018-19, no Medicare levy is payable for singles earning up to $22,398, and for eligible single seniors and pensioners up to $35,418, with further thresholds for couples and families."
  }
 ],
