 "speeches": [
  {
   "slug": "speech-316733",
   "speaker": "Graham Perrett",
   "party": "Labor",
   "state": "federal",
   "date": "2015-08-19",
   "stage_hint": null,
   "brief": "The bill extends the statutory life of in-house software from four to five years, raising $420 million, but the speaker argued the government fails to address major tax issues such as multinational tax avoidance and unfair superannuation concessions, noting that 475 Australians with super balances over $10 million earn $1.5 million tax-free each year."
  },
  {
   "slug": "speech-316734",
   "speaker": "Barnaby Joyce",
   "party": "Nationals",
   "state": "federal",
   "date": "2015-08-19",
   "stage_hint": null,
   "brief": "The government will provide $9.7 billion for innovation, science and research in 2015‑16, including $3 billion for the R&D Tax Incentive and $1.8 billion for CSIRO and other research. The bill extends the effective life of in‑house software to five years, saving $420 million, and clarifies tax rules for exploration expenses, instalment warrants and company loss deductions."
  }
 ],
