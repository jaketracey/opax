 "divisions": [],
 "speeches": [
  {
   "slug": "speech-422262",
   "speaker": "Mark Christopher Butler",
   "party": "Labor",
   "state": "federal",
   "date": "2022-09-07",
   "stage_hint": null,
   "brief": "The bill reduces the maximum PBS general patient co-payment from $42.50 to $30 per script, saving patients nearly one-third per prescription. From 1 January 2023, around 3.6 million Australians will benefit, with total consumer savings of almost $200 million per year."
  }
 ],
