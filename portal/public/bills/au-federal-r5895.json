  {
   "slug": "speech-349647",
   "speaker": "Luke Howarth",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-06-20",
   "stage_hint": null,
   "brief": "The coalition government argued the Foreign Acquisitions and Takeovers Fees Imposition Amendment Bill 2017 streamlines foreign investment fees, reduces red tape, and introduces a standard fee based on acquisition value. The speech defended foreign investment regulation by citing examples like the Kidman cattle station sale and Darwin port lease, and highlighted measures such as a vacancy charge on foreign-owned residential properties to boost rental stock."
  },
  {
   "slug": "speech-349649",
   "speaker": "Keith Pitt",
   "party": "Nationals",
   "state": "federal",
   "date": "2017-06-20",
   "stage_hint": null,
   "brief": "The bill amends the Foreign Acquisitions and Takeovers Fees Imposition Amendment Bill 2017 to streamline foreign investment fees, reduce complexity, and introduce a 10 per cent fee increase for residential property applications to fund the Critical Infrastructure Centre."
  }
 ],
