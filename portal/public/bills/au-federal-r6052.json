  "as_of": "2018-02-28",
  "sentences": [
   "The bill would shut down a federal scheme that registers interstate trucks.",
   "It would amend two 1985 Acts, then repeal them entirely once the scheme ends.",
   "The scheme would close to all operators by 30 June 2019, with a 12-month transition period."
  ],
  "changes": [
   "Close the Federal Interstate Registration Scheme to new entrants and re-registrations.",
   "Keep some provisions running for a 12-month transition.",
   "End all scheme operations by 30 June 2019."
  ],
  "affected": "Operators registered under the Federal Interstate Registration Scheme.",
