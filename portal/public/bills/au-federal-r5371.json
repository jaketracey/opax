 "summary": {
  "version": 1,
  "basis": "em",
  "attribution": "Written by a model from the explanatory memorandum; not the record",
  "describes_version": "original",
  "as_of": "2014-10-29",
  "sentences": [
   "This bill would change customs law so that goods from Japan can enter Australia at lower duty rates under a trade deal.",
   "It would set rules to decide which products count as made in Japan, based on where they were produced.",
   "The new system would start on the later of the day the bill becomes law or the day the trade deal takes effect for Australia."
  ],
  "changes": [
   "Creates rules for determining whether imported goods are Japanese-origin goods.",
   "Allows goods that meet the origin rules to enter Australia at preferential customs duty rates.",
   "Imposes requirements on Australian exporters and producers who claim preferential duty for goods sent to Japan."
  ],
  "affected": "Importers and exporters of goods between Australia and Japan, and producers of such goods.",
