 "speeches": [
  {
   "slug": "speech-371095",
   "speaker": "Christian Porter",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-10-17",
   "stage_hint": null,
   "brief": "The speaker introduced the Civil Law and Justice Legislation Amendment Bill, an omnibus bill making minor and technical amendments to ten acts. Key measures include repealing the combat duties exemption for women in the Australian Defence Force, creating new offences for retaining a child overseas without consent, and adding a defence of fleeing family violence for those offences."
  },
  {
   "slug": "speech-371096",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2018-10-17",
   "stage_hint": null,
   "brief": "The Civil Law and Justice Legislation Amendment Bill 2018 makes minor technical amendments and some more substantial changes to civil justice legislation, including clarifying bankruptcy definitions, adding a defence for fleeing family violence in child abduction offences, limiting arrest powers to trained Australian Border Force employees, and repealing section 43 of the Sex Discrimination Act to remove gender restrictions on combat roles. Labor supported the bill after the government implemented recommendations from the Senate Legal and Constitutional Affairs Legislation Committee."
  },
  {
   "slug": "speech-371097",
   "speaker": "Christian Porter",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-10-17",
   "stage_hint": null,
   "brief": "The Civil Law and Justice Legislation Amendment Bill 2018 makes minor technical amendments to improve the operation and clarity of civil justice legislation, including clarifying the Family Court’s bankruptcy jurisdiction, strengthening responses to international parental child abduction, narrowing arrest powers to law enforcement officers including the Australian Border Force, and repealing the Sex Discrimination Act’s exemption for combat duties in the ADF."
  }
 ],
