 "speeches": [
  {
   "slug": "speech-420197",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2022-07-27",
   "stage_hint": null,
   "brief": "The bill exempts Tropical Cyclone Seroja recovery grants of up to $25,000 from income tax, closes the Superannuation Complaints Tribunal with transfers to ASIC and AFCA, grants FIFA and its subsidiary tax exemptions for the 2022 World Cup, and defers the modernising business registers program transfer to 1 July 2026 due to a cost blowout from $500 million to $1.5 billion."
  },
  {
   "slug": "speech-420932",
   "speaker": "Angus Taylor",
   "party": "Liberal",
   "state": "federal",
   "date": "2022-08-02",
   "stage_hint": null,
   "brief": "The opposition supported the bill as it continues the former coalition government's economic measures, but criticised the government for delaying the Modernising Business Registers program until 2026 and for lacking an overall economic plan."
