 "speeches": [
  {
   "slug": "speech-348671",
   "speaker": "Chris Bowen",
   "party": "Labor",
   "state": "federal",
   "date": "2017-06-14",
   "stage_hint": null,
   "brief": "The opposition supports the International Monetary Agreements Amendment Bill, which enables a standing appropriation and borrowing authority for up to SDR 4.61 billion (about A$8.39 billion) for IMF lending, with no direct budget impact but recorded as a contingent liability. The speaker also criticised government members, especially Deputy Speaker Kelly, for reversing their previous opposition to such lending, and noted that national debt would pass $500 billion that week."
  },
  {
   "slug": "speech-348673",
   "speaker": "Matt Keogh",
   "party": "Labor",
   "state": "federal",
   "date": "2017-06-14",
   "stage_hint": null,
   "brief": "The International Monetary Agreements Amendment Bill 2017 was supported as an important, uncontroversial measure, with the speech highlighting Australia's pivotal role in founding the IMF at Bretton Woods and quoting Doc Evatt on the UN's ambition for peace, justice and decent living standards."
  }
 ],
