   "slug": "speech-822426",
   "speaker": "Mark Furner",
   "party": "Labor",
   "state": "federal",
   "date": "2013-03-13",
   "stage_hint": null,
   "brief": "Three bills—the Australian Capital Territory (Self-Government) Amendment Bill 2013, the Higher Education Support Amendment (Further Streamlining and Other Measures) Bill 2013, and the Royal Commissions Amendment Bill 2013—were introduced together, with a motion to proceed without formalities and be read a first time agreed to."
  },
  {
   "slug": "speech-822766",
   "speaker": "Jacinta Collins",
   "party": "Labor",
   "state": "federal",
   "date": "2013-03-19",
   "stage_hint": null,
   "brief": "A motion was moved and agreed to exempt five bills—including the ACT Self-Government Amendment Bill 2013 and the Higher Education Support Amendment Bill 2013—from certain parliamentary notice periods so they could be considered in the current sitting."
  },
  {
   "slug": "speech-822767",
   "speaker": "Jacinta Collins",
   "party": "Labor",
   "state": "federal",
   "date": "2013-03-19",
   "stage_hint": null,
   "brief": "A motion to postpone intervening business until after consideration of the Royal Commissions Amendment Bill 2013 was moved and agreed to."
  },
