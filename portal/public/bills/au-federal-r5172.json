 "speeches": [
  {
   "slug": "speech-283231",
   "speaker": "Steven Ciobo",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-02-26",
   "stage_hint": null,
   "brief": "Introduced the Excise Tariff Amendment (Tobacco) Bill 2014, outlining four staged 12.5 per cent tobacco excise increases from 1 December 2013 to 1 September 2016 and a shift in indexation from the consumer price index to wages from 1 March 2014, consistent with Australia's 2003 accession to the World Health Organization's Framework Convention on Tobacco Control."
  },
  {
   "slug": "speech-283232",
   "speaker": "Steven Ciobo",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-02-26",
   "stage_hint": null,
   "brief": "Introduced the Customs Tariff Amendment (Tobacco) Bill 2014, applying the same staged 12.5 per cent duty increases on imported tobacco from 1 December 2013 to 1 September 2016 and the same shift in indexation to wages from 1 March 2014 that apply to locally produced tobacco."
  },
