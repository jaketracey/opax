 "speeches": [
  {
   "slug": "speech-362420",
   "speaker": "Matt Thistlethwaite",
   "party": "Labor",
   "state": "federal",
   "date": "2018-05-10",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (Tax Integrity and Other Measures) Bill 2018 was supported on schedules 1 and 4, and an amendment was moved noting the Coalition Government's failure to improve tax haven transparency."
  },
  {
   "slug": "speech-362423",
   "speaker": "Jason Falinski",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-05-10",
   "stage_hint": null,
   "brief": "The speaker argued that the Treasury Laws Amendment (Tax Integrity and Other Measures) Bill 2018 strengthens tax integrity by closing loopholes for multinational tax avoidance, including through the Multinational Anti-Avoidance Law (MAAL), and tightening eligibility for small business capital gains tax (CGT) concessions. The bill also clarifies tax rules to allow venture capital investments in fin-tech businesses, with the ATO estimating over $7 billion in annual sales revenue added to the tax base and 38 multinationals, including Google and Facebook, changing their tax affairs."
  },
  {
   "slug": "speech-362425",
   "speaker": "Matt Keogh",
   "party": "Labor",
   "state": "federal",
   "date": "2018-05-10",
   "stage_hint": null,
   "brief": "The speaker argued that the Turnbull government has failed to act on tax havens and multinational tax avoidance, leaving loopholes open despite public demand for action. Labor proposed a tax haven transparency package including public country-by-country reporting, whistleblower protections, and tax domicile disclosure for government tenders, while criticising the government for prioritising $80 billion in big business tax cuts over closing loopholes that cost billions in lost revenue."
  },
  {
   "slug": "speech-362428",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-05-10",
   "stage_hint": null,
   "brief": "The bill amends tax laws to prevent multinational tax avoidance, target small business capital gains tax concessions to genuine small businesses from 1 July 2017, clarify venture capital rules for fintech investment, and exempt Defence Force Ombudsman reparation payments from income tax."
  }
 ],
