 "speeches": [
  {
   "slug": "speech-830123",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2024-02-06",
   "stage_hint": null,
   "brief": "The speaker announced that five bills—the Customs Tariff Amendment (Incorporation of Proposals) Bill (No. 2) 2023, the COAG Legislation Amendment Bill 2023, the Australian Research Council Amendment (Review Response) Bill 2023, the National Redress Scheme for Institutional Child Sexual Abuse Amendment Bill 2023, and the Modern Slavery Amendment (Australian Anti-Slavery Commissioner) Bill 2023—are referred to the Federation Chamber for further debate."
  },
  {
   "slug": "speech-830127",
   "speaker": "Kevin Hogan",
   "party": "Nationals",
   "state": "federal",
   "date": "2024-02-06",
   "stage_hint": null,
   "brief": "The opposition supported the Customs Tariff Amendment Bill, which expands duty-free entry for European Space Agency equipment in WA, extends duty reductions for Ukrainian goods until July 2024, enables duty-free imports for international sporting events like the 2023 FIFA Women's World Cup from January 2022, and extends additional 35% tariffs on Russian and Belarusian goods until October 2025."
  },
  {
   "slug": "speech-830192",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2024-02-06",
   "stage_hint": null,
   "brief": "The member for Riverina supported the Customs Tariff Amendment (Incorporation of Proposals) Bill (No. 2) 2023, which expands duty-free entry for European Space Agency equipment, extends the temporary duty reduction for Ukrainian goods by one year, allows duty-free imports for international sporting events such as the 2023 FIFA Women’s World Cup, and extends the 35 per cent additional duty on Russian and Belarusian goods for 24 months. He also called for more Australian military support for Ukraine, citing $910 million in aid and 120 Bushmasters."
  }
