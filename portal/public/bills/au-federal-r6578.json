 "speeches": [
  {
   "slug": "speech-393998",
   "speaker": "Paul Fletcher",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-08-27",
   "stage_hint": null,
   "brief": "The Radiocommunications (Transmitter Licence Tax) Amendment Bill 2020 gives ACMA the power to require upfront payment or annual instalments for specified transmitter licence taxes, aligning with spectrum licence rules and supporting longer licence terms of up to 20 years."
  },
  {
   "slug": "speech-398649",
   "speaker": "Michelle Rowland",
   "party": "Labor",
   "state": "federal",
   "date": "2020-11-11",
   "stage_hint": null,
   "brief": "The Labor opposition supported the Radiocommunications Legislation Amendment Bill 2020 to modernise spectrum management, but criticised the government for delivering the legislation over three years late and failing to implement all recommendations from the 2015 Spectrum Review, and for mishandling community television licensing."
  }
 ],
