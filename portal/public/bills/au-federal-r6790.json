 "speeches": [
  {
   "slug": "speech-413784",
   "speaker": "Tim Wilson",
   "party": "Liberal",
   "state": "federal",
   "date": "2021-10-21",
   "stage_hint": null,
   "brief": "The Offshore Electricity Infrastructure (Consequential Amendments) Bill 2021 amends five Commonwealth acts, including the Offshore Petroleum and Greenhouse Gas Storage Act 2006, to clarify their operation alongside the new offshore electricity infrastructure framework, with NOPSEMA and NOPTA assigned regulatory and registrar roles."
  },
  {
   "slug": "speech-414583",
   "speaker": "Tony Pasin",
   "party": "Liberal",
   "state": "federal",
   "date": "2021-10-27",
   "stage_hint": null,
   "brief": "The speaker supported the Offshore Electricity Infrastructure (Consequential Amendments) Bill 2021, which establishes a regulatory framework for offshore wind projects in Commonwealth waters. They noted a proposed 600-megawatt wind project off Kingston, South Australia, in their electorate of Barker, and urged the proponent Australis Energy to engage the local community and ensure the project falls under Commonwealth rather than state jurisdiction."
  },
  {
   "slug": "speech-414814",
   "speaker": "Darren Chester",
   "party": "Nationals",
   "state": "federal",
   "date": "2021-10-28",
   "stage_hint": null,
   "brief": "The member for Bass supported the Offshore Electricity Infrastructure Bill 2021 and related bills, arguing they will create jobs, lower emissions, and attract investment in offshore wind and renewable energy. The member noted the Bass Strait has strong offshore wind potential and that the bills establish a regulatory framework for offshore electricity projects."
  }
 ],
