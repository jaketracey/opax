  {
   "slug": "speech-342958",
   "speaker": "Andrew Leigh",
   "party": "Labor",
   "state": "federal",
   "date": "2017-03-02",
   "stage_hint": null,
   "brief": "Labor supported the Treasury Laws Amendment (2017 Measures No. 1) Bill 2017, which makes technical corrections to allow investors via interposed trusts to access capital gains concessions for start-ups and allows ASIC to share confidential information with the Tax Commissioner more easily."
  },
  {
   "slug": "speech-342959",
   "speaker": "Ed Husic",
   "party": "Labor",
   "state": "federal",
   "date": "2017-03-02",
   "stage_hint": null,
   "brief": "The bill supports innovation by improving access to capital for startups, but the speaker warned that an ATO alert on the R&D tax incentive could restrict software development eligibility and harm digital startups, citing StartupAUS CEO Alex McCauley."
  }
 ],
