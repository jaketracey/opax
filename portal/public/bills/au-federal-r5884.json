 "speeches": [
  {
   "slug": "speech-348095",
   "speaker": "David Gillespie",
   "party": "Nationals",
   "state": "federal",
   "date": "2017-06-01",
   "stage_hint": null,
   "brief": "The Industrial Chemicals Charges (General) Bill 2017 was introduced as part of a package to establish the Australian Industrial Chemicals Introduction Scheme (AICIS), replacing the 1997 registration charge act. It imposes an annual charge on registered chemical introducers, with amounts set in regulations and capped at the likely cost of regulatory activities, alongside two companion charges bills and a consultation process."
  },
  {
   "slug": "speech-348096",
   "speaker": "David Gillespie",
   "party": "Nationals",
   "state": "federal",
   "date": "2017-06-01",
   "stage_hint": null,
   "brief": "The Industrial Chemicals Charges (Customs) Bill 2017 was introduced as part of a package to reform industrial chemicals regulation, imposing charges only when considered a duty of customs. The bill mirrors the Industrial Chemicals Charges (General) Bill 2017, does not set charge amounts, and leaves charges and exemptions to be determined in regulations after further consultation."
  },
  {
   "slug": "speech-348097",
   "speaker": "David Gillespie",
   "party": "Nationals",
   "state": "federal",
   "date": "2017-06-01",
   "stage_hint": null,
   "brief": "The Industrial Chemicals Charges (Excise) Bill 2017 was introduced to impose charges only when they are a duty of excise, mirroring the Industrial Chemicals Charges (General) Bill 2017; the bill does not set charge amounts, which will be determined in regulations after further consultation."
  },
  {
   "slug": "speech-355036",
   "speaker": "David Gillespie",
   "party": "Nationals",
   "state": "federal",
   "date": "2017-10-17",
   "stage_hint": null,
   "brief": "The bills create a new Australian Industrial Chemicals Introduction Scheme, adopting a risk‑based regulatory approach that includes a ban on animal testing for cosmetics consistent with the European Union, while the speaker argued opposition amendments would create loopholes and place Australian industry at a disadvantage by blocking necessary animal test data for multi‑use chemicals."
  },
  {
   "slug": "speech-355066",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-10-17",
   "stage_hint": null,
   "brief": "Presented addenda to the explanatory memoranda for the Industrial Chemicals Bill 2017 and four related bills."
  }
 ],
