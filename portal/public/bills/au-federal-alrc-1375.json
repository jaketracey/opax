  {
   "slug": "speech-780623",
   "speaker": "John Hogg",
   "party": "PRES",
   "state": "federal",
   "date": "2007-06-12",
   "stage_hint": null,
   "brief": "The Senate Economics Committee report on the Tax Laws Amendment (Small Business) Bill 2007 was presented, along with additional information and a submission received on 6 June 2007, and ordered to be printed."
  },
  {
   "slug": "speech-780630",
   "speaker": "Nigel Scullion",
   "party": "Country Liberal Party",
   "state": "federal",
   "date": "2007-06-12",
   "stage_hint": null,
   "brief": "A correction to the explanatory memorandum for the Health Insurance Amendment (Diagnostic Imaging Accreditation) Bill 2007 was tabled. The bill proceeded without formalities and was read a first time."
  },
  {
   "slug": "speech-780631",
   "speaker": "Nigel Scullion",
   "party": "Country Liberal Party",
   "state": "federal",
   "date": "2007-06-12",
   "stage_hint": null,
   "brief": "The speech announced multiple legislative amendments: tax law changes including a simplified small business definition based on under $2 million annual turnover, $26.1 million in additional Indigenous education funding to expand youth mobility and leadership programs and upgrade boarding facilities, a new accreditation scheme for diagnostic imaging practices, and technical amendments to the Native Title Act."
  },
  {
   "slug": "speech-780643",
   "speaker": "Nick Sherry",
   "party": "Labor",
   "state": "federal",
   "date": "2007-06-12",
   "stage_hint": null,
   "brief": "The Labor senator supported most measures in both bills but moved a second reading amendment to reduce the withholding tax on managed fund distributions to foreign residents from 30% to a flat 15%, arguing the higher rate would deter foreign investment and harm Australia’s competitiveness as a financial hub. The senator also criticised the government for inadequate consultation on non-forestry managed investment schemes and endorsed the small business bill’s simplification of tax concessions."
  },
