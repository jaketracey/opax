 "speeches": [
  {
   "slug": "speech-1195567",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2025-07-29",
   "stage_hint": null,
   "brief": "Declared that the Customs Amendment and Customs Tariff Amendment bills implementing the Australia-United Arab Emirates Comprehensive Economic Partnership Agreement would stand referred to the Federation Chamber for further consideration."
  },
  {
   "slug": "speech-1195574",
   "speaker": "Kevin Hogan",
   "party": "Nationals",
   "state": "federal",
   "date": "2025-07-29",
   "stage_hint": null,
   "brief": "Supported bills implementing the Australia-United Arab Emirates Comprehensive Economic Partnership Agreement, outlining new rules of origin, preferential tariff treatment and staged duty reductions, and reported that the Joint Standing Committee on Treaties had supported the agreement; debate was adjourned."
  },
  {
   "slug": "speech-1195671",
   "speaker": "Anthony Chisholm",
   "party": "Labor",
   "state": "federal",
   "date": "2025-07-29",
   "stage_hint": null,
   "brief": "Moved a timetable for consideration of the Universities Accord (Cutting Student Debt by 20 Per Cent) Bill 2025, the Early Childhood Education and Care (Strengthening Regulation of Early Education) Bill 2025 and Australia-United Arab Emirates trade bills from Tuesday, 29 July 2025 to Thursday, 31 July 2025, including limits on debate and scheduled votes."
  }
 ],
