   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-785444",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2008-06-04",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-785655",
   "speaker": "Nick Sherry",
   "party": "Labor",
   "state": "federal",
   "date": "2008-06-16",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-785656",
   "speaker": "Nick Sherry",
   "party": "Labor",
   "state": "federal",
   "date": "2008-06-16",
   "stage_hint": null,
   "brief": "The government argued that the previous single-desk wheat export system failed growers and introduced legislation to replace it with an accreditation scheme for multiple exporters, to be regulated by a new body, Wheat Exports Australia, with the changes taking effect from 1 July 2008."
  },
  {
   "slug": "speech-785694",
   "speaker": "Rachel Siewert",
   "party": "Greens",
   "state": "federal",
   "date": "2008-06-16",
   "stage_hint": null,
   "brief": "The debate centred on the Wheat Export Marketing Bill 2008, which ends the single-desk wheat export monopoly and replaces it with an accreditation system for multiple exporters, overseen by a new regulator, Wheat Exports Australia. The government argued the change increases competition and choice for growers, while opponents, particularly the Nationals, warned it would reduce returns, favour multinational traders, and create regional monopolies, with many growers calling for the single desk to be retained."
  },
  {
   "slug": "speech-785751",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2008-06-17",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-785752",
   "speaker": "Steve Fielding",
   "party": "Family First",
   "state": "federal",
   "date": "2008-06-17",
   "stage_hint": null,
   "brief": "Family First opposed the Wheat Export Marketing Bill 2008 and related bill, arguing that most wheat growers want a grower-owned and controlled marketing system and that the single desk has served farmers well, while criticising both major parties for abandoning small farmers to big grain companies."
  },
  {
   "slug": "speech-786036",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2008-06-19",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-786037",
   "speaker": "Nick Minchin",
   "party": "Liberal",
   "state": "federal",
   "date": "2008-06-19",
   "stage_hint": null,
   "brief": "Liberal senators moved amendments to the Wheat Export Marketing Bill to change its objective from being \"responsive to\" to \"advancing\" wheat growers' needs, allow individual producers to export their own wheat in bulk without full accreditation, prevent state and territory laws from interfering with federal wheat contracts, and require the Productivity Commission review to start by 1 January 2010 and conclude by 1 July 2010."
  },
  {
   "slug": "speech-786038",
   "speaker": "Nick Sherry",
   "party": "Labor",
   "state": "federal",
   "date": "2008-06-19",
   "stage_hint": null,
   "brief": "The bills were read a third time, with the speaker noting Senator Nash's absence due to bereavement and recording that she would have voted against the legislation."
  },
