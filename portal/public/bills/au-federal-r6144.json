 "speeches": [
  {
   "slug": "speech-366278",
   "speaker": "Christian Porter",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-06-28",
   "stage_hint": null,
   "brief": "The speaker moved the Legislation Amendment (Sunsetting Review and Other Measures) Bill 2018 to implement recommendations from a review of sunsetting provisions, including broadening the Attorney-General’s power to defer sunsetting, removing time restrictions on parliamentary rollovers, exempting federal court rules from sunsetting, and clarifying definitions and protections around retrospective commencement and error correction."
  },
  {
   "slug": "speech-367060",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2018-08-15",
   "stage_hint": null,
   "brief": "The Legislation Amendment (Sunsetting Review and Other Measures) Bill 2018 makes technical amendments to harmonise sunsetting provisions, implementing 45 recommendations from a 2017 review by Anderson, Quiggin and Larkins. Labor supports the bill, noting the sunsetting framework has removed or replaced 60% of 2,024 listed legislative instruments since 2003."
  },
  {
   "slug": "speech-367061",
   "speaker": "Dan Tehan",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-08-15",
   "stage_hint": null,
   "brief": "The Legislation Amendment (Sunsetting Review and Other Measures) Bill 2018 was commended to the House as improving Commonwealth legislative frameworks and supporting regulatory reform. It implements recommendations requiring legislative action from the report on sunsetting provisions in the Legislation Act 2003 and makes minor technical amendments to that Act and the Acts Interpretation Act."
  }
 ],
