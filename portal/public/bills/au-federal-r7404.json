 "speeches": [
  {
   "slug": "speech-1198611",
   "speaker": "Joanne Ryan",
   "party": "Labor",
   "state": "federal",
   "date": "2025-11-24",
   "stage_hint": null,
   "brief": "Supported legislation requiring streaming platforms with more than one million Australian subscribers to invest 10 per cent of Australian sourced revenue in local content, arguing that Australian stories sustain national identity and support the screen sector."
  },
  {
   "slug": "speech-1198662",
   "speaker": "Anika Wells",
   "party": "Labor",
   "state": "federal",
   "date": "2025-11-24",
   "stage_hint": null,
   "brief": "Argued that the Communications Legislation Amendment (Australian Content Requirement for Subscription Video On Demand (Streaming) Services) Bill 2025 would require streaming services with one million or more Australian subscribers to invest at least 10 per cent of total expenditure or 7.5 per cent of revenue in new local content."
  },
  {
   "slug": "speech-1198793",
   "speaker": "Julian Leeser",
   "party": "Liberal",
   "state": "federal",
   "date": "2025-11-25",
   "stage_hint": null,
   "brief": "Moved an amendment to the Communications Legislation Amendment (Australian Content Requirement for Subscription Video On Demand (Streaming) Services) Bill 2025, arguing that the Coalition has long supported the screen industry while the government is rushing the bill and risking financial harm to producers; the bill would impose reporting and investment obligations on major streamers, including 10 per cent of Australian program expenditure or 7.5 per cent of Australian revenue."
  },
  {
   "slug": "speech-1198917",
   "speaker": "Jess Walsh",
   "party": "Labor",
   "state": "federal",
   "date": "2025-11-25",
   "stage_hint": null,
   "brief": "Moved to suspend standing order 111 paragraphs (5) to (8) so four named bills could be considered during the period of sittings; the question was agreed to."
  }
 ],
