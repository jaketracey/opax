 "summary": {
  "version": 1,
  "basis": "em",
  "attribution": "Written by a model from the explanatory memorandum; not the record",
  "describes_version": "original",
  "as_of": "2014-03-19",
  "sentences": [
   "The bill would make changes to several intellectual property laws to improve the system.",
   "It would allow Australian drug makers to seek a court order to produce generic versions of patented medicines for export to eligible developing countries.",
   "The patent holder would be paid compensation negotiated to avoid disadvantaging them."
  ],
  "changes": [
   "Amends the Patents Act 1990, Trade Marks Act 1995, Designs Act 2003 and Plant Breeder's Rights Act 1994.",
   "Creates a scheme for compulsory licences to manufacture and export generic pharmaceuticals to developing countries.",
   "Implements Australia's commitment to the TRIPS Protocol."
  ],
  "affected": "Australian pharmaceutical manufacturers, patent holders, and developing countries that meet specified criteria.",
