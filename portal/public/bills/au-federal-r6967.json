  },
  {
   "slug": "speech-827700",
   "speaker": "Joanne Ryan",
   "party": "Labor",
   "state": "federal",
   "date": "2023-02-15",
   "stage_hint": null,
   "brief": "The speaker argued that the Ministers of State Amendment Bill 2022 is necessary to prevent a repeat of former Prime Minister Scott Morrison secretly appointing himself to administer five additional portfolios (Health, Finance, Industry, Science, Energy and Resources, Home Affairs, and Treasury) between March 2020 and May 2021, a breach of democratic conventions condemned by former prime ministers Howard, Abbott, and Turnbull."
  },
  {
   "slug": "speech-828498",
   "speaker": "Sharon Claydon",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-20",
   "stage_hint": null,
   "brief": "The speaker argued that the Ministers of State Amendment Bill 2022 is necessary to prevent a repeat of former Prime Minister Scott Morrison’s secret appointments to five additional portfolios (Health, Finance, Industry, Science, Energy and Resources, Treasury, and Home Affairs) between March 2020 and May 2021, and that the bill will require public notification of all ministerial appointments to restore transparency and accountability."
  },
  {
   "slug": "speech-828964",
   "speaker": "David Smith",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-23",
   "stage_hint": null,
   "brief": "The speaker argued that the Ministers of State Amendment Bill 2022 is needed to prevent a repeat of former Prime Minister Scott Morrison secretly appointing himself to administer five portfolios (Health, Finance, Industry, Science, Energy and Resources, Treasury, and Home Affairs) in 2020–2021, and will require the Official Secretary to the Governor-General to publicly publish all ministerial appointments and revocations on the Federal Register of Legislation."
  },
  {
   "slug": "speech-828972",
   "speaker": "Maria Vamvakinou",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-23",
   "stage_hint": null,
   "brief": "The speaker supported the Ministers of State Amendment Bill 2022, arguing it was necessary after the previous government's leader, the member for Cook (Scott Morrison), secretly appointed himself minister for five departments without informing the public or colleagues. The amendment responds to the Virginia Bell inquiry and aims to rebuild trust, which the Edelman Trust survey showed had fallen below 50% in Australia."
  },
  {
   "slug": "speech-829014",
   "speaker": "Maria Vamvakinou",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-23",
   "stage_hint": null,
   "brief": "The member for Calwell and the Minister for Immigration, Citizenship and Multicultural Affairs argued that the Ministers of State Amendment Bill 2022 is essential to restore transparency and accountability in government, implement the first recommendation of the Bell inquiry, and address the former Prime Minister (the member for Cook) secretly appointing ministers."
  }
 ],
