 "divisions": [],
 "speeches": [
  {
   "slug": "speech-332750",
   "speaker": "Darren Chester",
   "party": "Nationals",
   "state": "federal",
   "date": "2016-08-31",
   "stage_hint": null,
   "brief": "The motion was moved to pass Appropriation Bills (No. 1, No. 2, and Parliamentary Departments) for 2016‑2017, providing just over $49 billion in funding, including nearly $18 billion for Defence, $1.3 billion for Education and Training, $781 million for Infrastructure and Regional Development, and $610 million for the ABC and $168 million for SBS."
  },
  {
   "slug": "speech-332751",
   "speaker": "Darren Chester",
   "party": "Nationals",
   "state": "federal",
   "date": "2016-08-31",
   "stage_hint": null,
   "brief": "Appropriation Bill (No. 2) 2016-2017 was moved to provide almost $9 billion in non-ordinary annual services funding, including $4.9 billion for NBN Co., $1.4 billion for Defence, $544 million for Infrastructure and Regional Development, and over $310 million for Agriculture and Water Resources. The bill also covers debit limits for the Nation-building Funds, general purpose financial assistance, and national partnership payments."
  },
  {
   "slug": "speech-334443",
   "speaker": "Nola Marino",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-10-10",
   "stage_hint": null,
   "brief": "The speaker announced that unless otherwise ordered at adjournment, three appropriation bills for 2016-2017 are referred to the Federation Chamber for further consideration."
  },
  {
   "slug": "speech-334460",
   "speaker": "Graham Perrett",
   "party": "Labor",
   "state": "federal",
   "date": "2016-10-10",
   "stage_hint": null,
   "brief": "The speaker announced Labor would not block supply but criticized the Turnbull government's budget repair, citing increased taxes, a tripled deficit, and higher unemployment. They defended Labor's alternative package, including superannuation and negative gearing reforms, and opposed government measures like the $50 billion business tax cut and raising the pension age to 70."
  },
  {
   "slug": "speech-334476",
   "speaker": "Rob Mitchell",
   "party": "Labor",
   "state": "federal",
   "date": "2016-10-10",
   "stage_hint": null,
   "brief": "The speaker argued the government's trickle-down economics has failed, neglecting families and favouring big business. They cited the GP Super Clinics program, specifically a clinic in Wallan that conservative health ministers refused to open rather than admit the program was a success."
  },
  {
   "slug": "speech-335286",
   "speaker": "Jane Prentice",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-10-13",
   "stage_hint": null,
   "brief": "The coalition government's $100 billion budget was endorsed by voters, with the speaker criticising Labor for not delivering a surplus since 1989 and for underfunding the NDIS, while announcing a $29.9 billion increase in defence spending over ten years."
  },
  {
   "slug": "speech-335287",
   "speaker": "Kelly O'Dwyer",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-10-13",
   "stage_hint": null,
   "brief": "The speaker argued for the passage of three appropriation bills for 2016-17, seeking over $58 billion in total: $49 billion for ordinary annual services, $9 billion for non-ordinary services including capital works and payments to states and territories, and $147 million for parliamentary departments."
  }
 ],
