  {
   "slug": "speech-824924",
   "speaker": "Jacinta Collins",
   "party": "Labor",
   "state": "federal",
   "date": "2013-06-24",
   "stage_hint": null,
   "brief": "The government introduced the Public Interest Disclosure Bill 2013 to create the first stand‑alone federal whistleblower protection scheme, enabling Commonwealth public officials to report suspected wrongdoing and receive protections against reprisal. The bill also established oversight roles for the Commonwealth Ombudsman and the Inspector‑General of Intelligence and Security, and a companion bill repealed existing whistleblower provisions in the Public Service Act 1999 and Parliamentary Service Act 1999."
  },
  {
   "slug": "speech-825137",
   "speaker": "Christine Milne",
   "party": "Greens",
   "state": "federal",
   "date": "2013-06-26",
   "stage_hint": null,
   "brief": "The Greens senator argued that the Public Interest Disclosure Bill 2013 is overly complex but supported it, announcing a secured amendment allowing whistleblowers to immediately disclose imminent environmental threats. He called for a national anticorruption commission and criticised the Australian Federal Police's treatment of whistleblowers, citing the cases of Allan Kessing, Ross Fusca and Brendan Thomson."
  }
 ],
