   "brief": null
  },
  {
   "slug": "speech-794639",
   "speaker": "Nick Sherry",
   "party": "Labor",
   "state": "federal",
   "date": "2009-08-17",
   "stage_hint": null,
   "brief": "The National Greenhouse and Energy Reporting Amendment Bill 2009 was introduced to strengthen the audit framework under the Act, including replacing \"external auditor\" with \"audit team leader,\" requiring auditor registration, and permitting public disclosure of audit outcomes while protecting commercially sensitive information. It also removes the obligation to publish corporate energy production data to avoid confusion with economy-wide statistics."
  },
  {
   "slug": "speech-795141",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-09-07",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795142",
   "speaker": "David Johnston",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-09-07",
   "stage_hint": null,
   "brief": "The opposition supported the bill but criticised the government for poor consultation and multiple rewritten explanatory memoranda. The Greens also supported the bill, proposing amendments for facility-level emissions reporting and lowering the reporting threshold from 25,000 to 10,000 tonnes."
  },
  {
   "slug": "speech-795143",
   "speaker": "Christine Milne",
   "party": "Greens",
   "state": "federal",
   "date": "2009-09-07",
   "stage_hint": null,
   "brief": "The Greens moved amendments to require facility-level greenhouse gas emissions and energy data to be published online, arguing for public transparency on individual polluting facilities. The government and opposition opposed the amendments, citing concerns over commercial sensitivity and increased compliance costs, and the amendments were negatived."
  },
  {
   "slug": "speech-795144",
   "speaker": "Penny Wong",
   "party": "Labor",
   "state": "federal",
   "date": "2009-09-07",
   "stage_hint": null,
   "brief": null
  }
