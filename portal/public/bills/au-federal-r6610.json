 },
 "divisions": [],
 "speeches": [
  {
   "slug": "speech-395688",
   "speaker": "Jim Chalmers",
   "party": "Labor",
   "state": "federal",
   "date": "2020-10-08",
   "stage_hint": null,
   "brief": "Labor supported the five tax measures in the omnibus bill, including bringing forward stage 2 tax cuts, increasing the small business threshold to $50 million, and the temporary loss carry-back, but expressed reservations about the research and development tax incentive and temporary full expensing due to limited time to consider them."
  },
  {
   "slug": "speech-395690",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-10-08",
   "stage_hint": null,
   "brief": "The bill accelerates stage 2 personal income tax cuts to 1 July 2020, retains the low- and middle-income tax offset for 2020–21, and provides $17.8 billion in tax relief for 11.6 million individuals, with singles receiving up to $2,745 and dual-income families up to $5,490. It also introduces temporary loss carry back for companies with turnover up to $5 billion, expands small business tax concessions to a $50 million turnover threshold, reforms the R&D tax incentive, and allows full expensing of eligible depreciable assets for businesses with turnover under $5 billion until 30 June 2022."
  }
