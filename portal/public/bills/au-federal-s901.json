 "speeches": [
  {
   "slug": "speech-824692",
   "speaker": "John Madigan",
   "party": "DLP",
   "state": "federal",
   "date": "2013-06-20",
   "stage_hint": null,
   "brief": "The Fair Trade (Workers' Rights) Bill 2013 was introduced to require that minimum standards on workers' rights be included in certain international agreements."
  },
  {
   "slug": "speech-824693",
   "speaker": "John Madigan",
   "party": "DLP",
   "state": "federal",
   "date": "2013-06-20",
   "stage_hint": null,
   "brief": "The speaker introduced the Fair Trade (Workers' Rights) Bill 2013, arguing that Australian industries cannot compete with imported goods produced under poor labour conditions, and that the bill aims to protect workers' rights and improve competitiveness."
  },
  {
   "slug": "speech-825472",
   "speaker": "John Madigan",
   "party": "DLP",
   "state": "federal",
   "date": "2013-11-13",
   "stage_hint": null,
   "brief": "A motion was agreed to suspend standing orders and restore the Health Insurance Amendment (Medicare Funding for Certain Types of Abortion) Bill 2013 and the Fair Trade (Workers' Rights) Bill 2013 to the Notice Paper for resumed consideration at the stage reached in the last session."
  }
 ],
