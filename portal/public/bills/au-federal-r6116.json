 "speeches": [
  {
   "slug": "speech-365479",
   "speaker": "Andrew Leigh",
   "party": "Labor",
   "state": "federal",
   "date": "2018-06-25",
   "stage_hint": null,
   "brief": "Labor will support the bill but move an amendment to change the start date of schedule 3 from 1 July 2017 to 1 July 2018, citing lack of consultation and retrospectivity; the speaker also criticised the government for missing the original implementation date on hybrid mismatch rules and for voting against Labor’s earlier multinational tax measures, including the Chevron case that secured $300 million."
  },
  {
   "slug": "speech-365480",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-06-25",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (Tax Integrity and Other Measures No. 2) Bill 2018 was argued to improve tax system sustainability and integrity, implementing OECD hybrid mismatch rules to prevent multinational tax avoidance, clarifying the producer offset for overseas filming, providing a five-year income tax exemption for an International Cricket Council subsidiary to host the 2020 ICC World Twenty20, and listing the Melbourne Korean War Memorial Committee as a deductible gift recipient until 31 December 2019."
  }
 ],
