 "speeches": [
  {
   "slug": "speech-1203992",
   "speaker": "Mark Butler",
   "party": "Labor",
   "state": "federal",
   "date": "2026-06-25",
   "stage_hint": null,
   "brief": "Moved the second reading of a bill removing higher private health insurance rebates for people aged 65 and over from 1 April 2027 while retaining means testing and other supports. Argued the change would restore intergenerational equity and redirect an estimated $3 billion in savings to additional aged-care beds, packages, shorter waits and improved care."
  },
  {
   "slug": "speech-1204092",
   "speaker": "Tony Sheldon",
   "party": "Labor",
   "state": "federal",
   "date": "2026-06-25",
   "stage_hint": null,
   "brief": "Presented the Selection of Bills Committee's seventh report and moved its adoption; the report recommended immediate referral of four bills concerning defence, health insurance and tax reform to Senate committees with reporting dates from 13 August to 7 October 2026, while an amendment proposed referring a workplace relations bill by 10 August."
  }
 ],
