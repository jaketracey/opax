 "divisions": [],
 "speeches": [
  {
   "slug": "speech-289534",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-05-29",
   "stage_hint": null,
   "brief": "Introduced a bill clarifying the Public Governance, Performance and Accountability Act, confirming beyond doubt the Auditor-General's ongoing power to conduct a performance audit of any Commonwealth entity at any time, following a Joint Committee of Public Accounts and Audit inquiry begun on 13 February 2014."
  },
  {
   "slug": "speech-290632",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2014-06-04",
   "stage_hint": null,
   "brief": "Confirmed Labor's support for the Public Governance, Performance and Accountability Amendment Bill, noting the reforms build on work begun under the previous government and detailing technical clarifications such as aligning annual report deadlines with the Senate estimates timetable."
  },
  {
   "slug": "speech-290687",
   "speaker": "Angus Taylor",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-06-05",
   "stage_hint": null,
   "brief": "Supported the Public Governance, Performance and Accountability Amendment Bill, citing the fibre NBN rollout reaching only 208,000 of a targeted 1.27 million homes passed by 2013, and said Canberra's private-sector share of economic activity fell from 60 to 50 per cent under the previous government."
  },
  {
   "slug": "speech-290688",
   "speaker": "Andrew Southcott",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-06-05",
   "stage_hint": null,
   "brief": "Detailed the Joint Committee of Public Accounts and Audit's inquiry into the new PGPA Act rules, which made 10 recommendations including that officials be explicitly required to consider 'proper use' before approving spending, a safeguard the Auditor-General warned was missing from the draft rule."
  },
  {
   "slug": "speech-290689",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-06-05",
   "stage_hint": null,
   "brief": "Summed up the Public Governance, Performance and Accountability Amendment Bill, confirming the government would adopt a fifth guiding principle recommended by the Joint Committee of Public Accounts and Audit, that the financial framework support the legitimate requirements of government and parliament."
  }
 ],
