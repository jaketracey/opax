  {
   "slug": "speech-312540",
   "speaker": "Tanya Plibersek",
   "party": "Labor",
   "state": "federal",
   "date": "2015-06-15",
   "stage_hint": null,
   "brief": "The speaker argued for the Marriage Amendment (Marriage Equality) Bill 2015, stating that denying same-sex couples the legal protections of marriage is a form of discrimination comparable to past racial marriage bans, and urged Parliament to remove this \"last great inequality\" by passing the bill."
  },
  {
   "slug": "speech-312541",
   "speaker": "Philip Ruddock",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-06-15",
   "stage_hint": null,
   "brief": "The speaker opposed the Marriage Amendment (Marriage Equality) Bill 2015, arguing it was pushed by the opposition leader without cross-party collaboration, and advocated for a French-style approach where the state regulates civil unions while leaving marriage to religious institutions."
  },
  {
   "slug": "speech-315838",
   "speaker": "Tim Watts",
   "party": "Labor",
   "state": "federal",
   "date": "2015-08-12",
   "stage_hint": null,
   "brief": "The MP argued for marriage equality, rejecting Senator Abetz’s claim that gay men do not want to marry, and shared the personal story of their uncle Derek to illustrate the harm of denying same-sex couples the legal recognition available to heterosexual couples."
  }
 ],
