 "speeches": [
  {
   "slug": "speech-378491",
   "speaker": "Jim Chalmers",
   "party": "Labor",
   "state": "federal",
   "date": "2019-07-25",
   "stage_hint": null,
   "brief": "Labor supported three bills implementing the Timor Sea Maritime Boundaries Treaty, which resolves a 40‑year maritime dispute and establishes new petroleum revenue arrangements—royalties from the Timor Sea funded over 95% of Timor‑Leste’s budget in 2016."
  },
  {
   "slug": "speech-378492",
   "speaker": "Sharon Claydon",
   "party": "Labor",
   "state": "federal",
   "date": "2019-07-25",
   "stage_hint": null,
   "brief": "The speaker supported the three Timor Sea Maritime Boundaries Treaty bills, stressing the need for passage before East Timor's 30 August independence celebrations and acknowledging Labor's role in shifting Australia toward a rules-based settlement of the long-standing maritime boundary dispute."
  },
  {
   "slug": "speech-378645",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-07-25",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (Timor Sea Maritime Boundaries Treaty) Bill 2019 fulfils Australia’s tax obligations under the treaty by applying transitional arrangements for petroleum activities as set out in annex D."
  }
 ],
