 "speeches": [
  {
   "slug": "speech-334850",
   "speaker": "Scott Morrison",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-10-12",
   "stage_hint": null,
   "brief": "The Passenger Movement Charge will increase from $55 to $60 from 1 July 2017, the first rise since 2012, to help fund the government’s working holiday maker reform package and raise $365 million."
  },
  {
   "slug": "speech-335459",
   "speaker": "George Christensen",
   "party": "Nationals",
   "state": "federal",
   "date": "2016-10-17",
   "stage_hint": null,
   "brief": "The speaker argued for the passage of the Working Holiday Maker Reform bills, which reduce the backpacker tax from 32.5% to 15%, and increase the tax on departing backpackers' superannuation to 95%. He cited concerns from Bowen farmer Carl Walker and Tourism Whitsundays chair Allen Grundy about damage to agriculture and tourism, and criticised Labor's attempt to delay the reforms."
  }
