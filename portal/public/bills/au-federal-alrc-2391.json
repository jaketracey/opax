  {
   "slug": "speech-823446",
   "speaker": "Anne McEwen",
   "party": "Labor",
   "state": "federal",
   "date": "2013-05-16",
   "stage_hint": null,
   "brief": "The Selection of Bills Committee report recommended referring the Australian Jobs Bill 2013, Export Market Development Grants Amendment Bill 2013, Private Health Insurance Legislation Amendment (Base Premium) Bill 2013, and Public Governance, Performance and Accountability Bill 2013 to specific committees for inquiry by June 2013, and recommended not referring several other bills including the DisabilityCare Australia Fund Bill 2013 and related tax bills; the report was adopted."
  },
  {
   "slug": "speech-823452",
   "speaker": "Jacinta Collins",
   "party": "Labor",
   "state": "federal",
   "date": "2013-05-16",
   "stage_hint": null,
   "brief": "Moved to suspend standing orders so that 14 bills related to DisabilityCare Australia (the National Disability Insurance Scheme) could be considered during the current sitting period; the motion was agreed to."
  }
