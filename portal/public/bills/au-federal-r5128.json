 "summary": {
  "version": 1,
  "basis": "em",
  "attribution": "Written by a model from the explanatory memorandum; not the record",
  "describes_version": "revised",
  "as_of": "2013-11-14",
  "sentences": [
   "The bill would respond to a Federal Court decision and increase penalties for harming turtles and dugong.",
   "It would amend the Environment Protection and Biodiversity Conservation Act 1999 to raise financial penalties for offences against listed turtles and dugong.",
   "The bill would also amend the Great Barrier Reef Marine Park Act 1975 to give extra protection to dugong, marine turtles and leatherback turtles."
  ],
  "changes": [
   "Addresses implications from the Tarkine case.",
   "Increases financial penalties for offences against listed turtles and dugong under the EPBC Act.",
   "Provides additional protection for dugong, marine turtles and leatherback turtles under the GBRMP Act."
  ],
  "affected": "People and organisations subject to the EPBC Act and GBRMP Act, particularly those involved in activities affecting turtles and dugong.",
