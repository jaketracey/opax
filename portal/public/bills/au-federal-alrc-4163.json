  {
   "slug": "speech-824880",
   "speaker": "Christopher Back",
   "party": "Liberal",
   "state": "federal",
   "date": "2013-06-24",
   "stage_hint": null,
   "brief": "The speaker argued against the Constitution Alteration (Local Government) 2013 Bill, claiming it would concentrate power in Canberra at the expense of state governments and local councils. They criticised the government’s decision to allocate $10 million to the ‘yes’ campaign and only $500,000 to the ‘no’ campaign, and noted that several states oppose the amendment."
  },
  {
   "slug": "speech-824908",
   "speaker": "Don Farrell",
   "party": "Labor",
   "state": "federal",
   "date": "2013-06-24",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-824928",
   "speaker": "Nigel Scullion",
   "party": "Country Liberal Party",
   "state": "federal",
   "date": "2013-06-24",
   "stage_hint": null,
   "brief": "The speaker argued that the government’s proposed constitutional amendment on local government is likely to fail due to inadequate state support, a rushed timeline, and skewed public funding ($10 million for the Yes case versus $500,000 for the No case). He also accused Labor of using the referendum as a political distraction and noted that the Australian Electoral Commission had warned of insufficient preparation time."
  }
