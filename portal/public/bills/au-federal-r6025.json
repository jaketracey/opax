 "speeches": [
  {
   "slug": "speech-360911",
   "speaker": "Matt Thistlethwaite",
   "party": "Labor",
   "state": "federal",
   "date": "2018-03-01",
   "stage_hint": null,
   "brief": "The speaker argued that the government's housing affordability bills do not address the core problems of negative gearing and the 50% capital gains tax discount, which primarily benefit high-income earners and inflate house prices. Labor's alternative policies would restrict negative gearing to new properties only and reduce the capital gains tax discount to 25%, aiming to reduce competition for first home buyers and increase housing supply."
