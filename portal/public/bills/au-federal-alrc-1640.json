  {
   "slug": "speech-791522",
   "speaker": "Joe Ludwig",
   "party": "Labor",
   "state": "federal",
   "date": "2009-03-10",
   "stage_hint": null,
   "brief": "The speaker moved that the bills proceed without formalities, be taken together, and be read a first time; the motion was agreed to and the bills were read a first time."
  },
  {
   "slug": "speech-791523",
   "speaker": "Joe Ludwig",
   "party": "Labor",
   "state": "federal",
   "date": "2009-03-10",
   "stage_hint": null,
   "brief": "The speaker tabled a revised explanatory memorandum for the Tax Laws Amendment (2008 Measures No. 6) Bill 2009 and introduced two appropriation bills seeking $3.1 billion in total additional funding, including $2.05 billion in Bill No. 3 for areas such as defence, climate change advertising, health programs, and drought assistance, and $1.04 billion in Bill No. 4 mainly for payments to states and local governments. The speaker also introduced the Customs Amendment (Enhanced Border Controls and Other Measures) Bill 2008 and the Law and Justice Legislation Amendment (Identity Crimes and Other Measures) Bill 2008, which creates new identity crime offences."
  },
  {
   "slug": "speech-792331",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-03-19",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-792332",
   "speaker": "Helen Coonan",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-03-19",
   "stage_hint": null,
   "brief": "The coalition supported the appropriation bills despite criticising specific spending, including $13.95 million for a climate change advertising campaign, $101 million extra for a mismanaged solar panel rebate scheme, and $17.9 million for Pink Batts advertising, arguing the Rudd Labor government’s spending was reckless and increased the budget deficit."
  },
  {
   "slug": "speech-792341",
   "speaker": "Scott Ludlam",
   "party": "Greens",
   "state": "federal",
   "date": "2009-03-19",
   "stage_hint": null,
   "brief": "Tabled a letter from the Deputy Prime Minister to Senator Bob Brown; amendments and motions were agreed to, and bills were read a second time."
  },
  {
