 "divisions": [],
 "speeches": [
  {
   "slug": "speech-828801",
   "speaker": "Andrew Leigh",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-22",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (Refining and Improving our Tax System) Bill 2023 gives legal force to a new tax treaty with Iceland (signed 12 October 2022), exempts wholly owned subsidiaries of the Future Fund Board from corporate income tax, transfers administration of four deductible gift recipient categories to the Australian Taxation Office, allows small and medium businesses (turnover under $50 million) to report and pay fuel and alcohol excise quarterly from 1 July 2023, and exempts the first 10,000 litres of beer repackaged into growlers from alcohol excise licensing requirements."
  },
  {
   "slug": "speech-829307",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-28",
   "stage_hint": null,
   "brief": "The Health Insurance Amendment (Prescribed Dental Patients and Other Measures) Bill 2023, Customs Tariff Amendment (Incorporation of Proposals) Bill 2023, Special Recreational Vessels Amendment Bill 2023, Veterans' Affairs Legislation Amendment (Miscellaneous Measures) Bill 2023, and Treasury Laws Amendment (Refining and Improving Our Tax System) Bill 2023 were referred to the Federation Chamber for further consideration at the adjournment of the second reading debate."
  },
  {
   "slug": "speech-829314",
   "speaker": "Angus Taylor",
   "party": "Liberal",
   "state": "federal",
   "date": "2023-03-28",
   "stage_hint": null,
   "brief": "The coalition supported the Treasury Laws Amendment (Refining and Improving Our Tax System) Bill 2023 but argued Labor broke promises on franking credits, superannuation taxes and unrealised capital gains, noting $550 billion in tax receipts for 2021–22 and claiming independent research shows 500,000 Australians would be hit by the super tax by retirement."
  },
  {
   "slug": "speech-829539",
   "speaker": "Graham Perrett",
   "party": "Labor",
   "state": "federal",
   "date": "2023-03-29",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (Refining and Improving Our Tax System) Bill 2023 was passed with support from both sides, introducing five measures: a tax treaty with Iceland, income tax exemption for Future Fund subsidiaries, streamlined deductible gift recipient approvals, quarterly excise reporting for small and medium businesses, and a beer repackaging excise exemption; coalition speakers supported the bill but criticised Labor's broken promises on franking credits and superannuation taxes."
  }
 ],
