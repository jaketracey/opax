 "speeches": [
  {
   "slug": "speech-325402",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-12-03",
   "stage_hint": null,
   "brief": "The Medicare Levy Amendment (Attribution Managed Investment Trusts) Bill 2015 amends the Medicare Levy Act 1986 to impose the two per cent Medicare levy on trustees of attribution managed investment trusts when they do not attribute all income to members, ensuring that income does not escape taxation."
  },
  {
   "slug": "speech-327602",
   "speaker": "Kelly O'Dwyer",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-02-10",
   "stage_hint": null,
   "brief": "The bills create a new tax system for eligible managed investment trusts, reducing compliance costs by $30 million per year and taxing investors directly, modernising rules for Australia’s $2.6 trillion funds management industry."
  },
  {
   "slug": "speech-331526",
   "speaker": "Angus Taylor",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-05-02",
   "stage_hint": null,
   "brief": "A motion was moved requesting the Senate to resume consideration of 14 specified bills from the previous session, with each request to be conveyed in a separate message. The bills covered water amendment, managed investment trusts, social services, crime commission, deaths registration, tax and superannuation, crowd-sourced funding, firearms trafficking, and parliamentary entitlements."
  }
 ],
