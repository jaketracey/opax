  {
   "slug": "speech-798600",
   "speaker": "Kim Carr",
   "party": "Labor",
   "state": "federal",
   "date": "2010-02-22",
   "stage_hint": null,
   "brief": "A minister moved that the carbon pollution reduction scheme amendment bills be taken together and read a first time, accusing the opposition of using procedural tactics rather than openly opposing the bills. He noted the Liberal Party had agreed to the amendments under former leader Malcolm Turnbull but now, under Tony Abbott, opposed climate action; the motion was agreed and the bills read a first time."
  },
  {
   "slug": "speech-798781",
   "speaker": "Joe Ludwig",
   "party": "Labor",
   "state": "federal",
   "date": "2010-02-24",
   "stage_hint": null,
   "brief": "The speaker moved several bills to establish the Carbon Pollution Reduction Scheme, including amendments to cut fuel taxes on a cent-for-cent basis from 1 July 2011 and provide $660 average household assistance to 8.1 million households, with full compensation for pensioners and low-income households."
  }
