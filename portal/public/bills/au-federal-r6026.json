 "speeches": [
  {
   "slug": "speech-362274",
   "speaker": "Karen Andrews",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-05-10",
   "stage_hint": null,
   "brief": "The Australian Research Council Amendment Bill 2018 was introduced to update funding caps for the ARC through to 30 June 2022, ensuring continued support for research. The government highlighted recent funding allocations including $333.5 million for 859 projects and $170.6 million for 120 projects."
  },
  {
   "slug": "speech-365229",
   "speaker": "Nick Champion",
   "party": "Labor",
   "state": "federal",
   "date": "2018-06-21",
   "stage_hint": null,
   "brief": "The Australian Research Council Amendment Bill 2018 updates annual indexation for grant programs, with funding rising from $758 million in 2018‑19 to $771.93 million in 2019‑20. The speech urged stable, predictable research funding, contrasting Labor's past higher investment with current cuts that risk losing talent."
  },
  {
   "slug": "speech-365354",
   "speaker": "Madeleine King",
   "party": "Labor",
   "state": "federal",
   "date": "2018-06-21",
   "stage_hint": null,
   "brief": "Labor supported the Australian Research Council Amendment Bill 2018, noting that the government had cut nearly $900 million from science and research in its first budget, resulting in a $94.1 million real-term fall in ARC funding and a halving of Future Fellowships from 200 to 100, with Western Australia receiving only 7.5% of Discovery Projects funding."
  },
  {
   "slug": "speech-365473",
   "speaker": "Karen Andrews",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-06-25",
   "stage_hint": null,
   "brief": "The Australian Research Council Amendment Bill 2018 increases funding caps to support fundamental and applied research, expanding Australia's research capabilities and providing thousands of direct and indirect jobs."
  }
 ],
