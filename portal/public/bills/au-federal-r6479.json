 "speeches": [
  {
   "slug": "speech-386167",
   "speaker": "David Littleproud",
   "party": "LNP",
   "state": "federal",
   "date": "2019-12-04",
   "stage_hint": null,
   "brief": "The Export Charges (Imposition-Excise) Amendment Bill 2019 was moved for a second reading as part of the Export Control Bill 2019 package, amending the 2015 Act to ensure export charges are set by regulation and reflect the Commonwealth's regulatory costs."
  },
  {
   "slug": "speech-388039",
   "speaker": "Andrew Gee",
   "party": "Nationals",
   "state": "federal",
   "date": "2020-02-12",
   "stage_hint": null,
   "brief": "The Export Control Bill 2019 and associated bills consolidate and replace existing agricultural export legislation, streamlining rules, improving certification, and enabling faster government responses to market changes. The package also transitions arrangements smoothly and continues cost-recovery charges for administering the export control system."
  }
 ],
