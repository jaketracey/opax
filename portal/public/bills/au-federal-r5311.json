 "summary": {
  "version": 1,
  "basis": "em",
  "attribution": "Written by a model from the explanatory memorandum; not the record",
  "describes_version": "revised",
  "as_of": "2014-07-14",
  "sentences": [
   "This bill is part of a package that repeals the carbon tax and includes new rules to stop suppliers from exploiting customers after the repeal.",
   "The amendments would ban price exploitation on key goods like electricity and gas, and require affected businesses to explain how they have passed on cost savings from the repeal.",
   "Maximum penalties for corporations would be 6,471 penalty units ($1,100,070), and for individuals 1,295 penalty units ($220,150), with an additional penalty of 250 per cent of any cost savings not passed through."
  ],
  "changes": [
   "Introduces a new prohibition on carbon-specific price exploitation for key goods.",
   "Requires electricity and natural gas retailers and bulk synthetic greenhouse gas importers to provide substantiation statements to the ACCC and customers.",
   "Gives the ACCC new monitoring powers over prices during the carbon tax repeal transition period.",
   "Creates a new penalty for failing to pass through all cost savings, equal to 250 per cent of the amount not passed on.",
   "Bans false or misleading representations about the effect of the carbon tax repeal on prices.",
   "Requires electricity and natural gas retailers to prepare customer statements within 30 days after Royal Assent."
  ],
  "affected": "Electricity and natural gas retailers, bulk synthetic greenhouse gas importers, and their customers, as well as the ACCC.",
