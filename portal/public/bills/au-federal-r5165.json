 "speeches": [
  {
   "slug": "speech-282481",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-02-13",
   "stage_hint": null,
   "brief": "Moved the second reading of Appropriation Bill (No. 3) 2013-2014, seeking just under $11.6 billion in additional funding including an $8.8 billion one-off grant to the Reserve Bank and almost $750 million for the Department of Immigration and Border Protection."
  },
  {
   "slug": "speech-282482",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-02-13",
   "stage_hint": null,
   "brief": "Moved the second reading of Appropriation Bill (No. 4) 2013-2014, seeking just over $3.2 billion including almost $2.2 billion for the Department of Foreign Affairs and Trade and almost $400 million for offshore asylum seeker management."
  },
  {
   "slug": "speech-283255",
   "speaker": "Andrew Leigh",
   "party": "Labor",
   "state": "federal",
   "date": "2014-02-26",
   "stage_hint": null,
   "brief": "Moved a second reading amendment noting the government's own Mid-Year Economic and Fiscal Outlook revealed a $17 billion budget blow-out, 60 per cent of which was due to its own decisions. Said Australia's economy rose from the 15th to the 12th largest in the world under Labor, and questioned the Treasurer's $9 billion grant to the Reserve Bank, for which no evidence of a formal request had been produced."
  },
  {
   "slug": "speech-283261",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2014-02-26",
   "stage_hint": null,
   "brief": "Contrasted the government's $17.7 billion deficit with Labor's independently audited projection of a $4.2 billion surplus by 2016-17, and said 63,000 full-time jobs had been lost under the government, or about 350 a day. Highlighted youth unemployment of 16.5 per cent in the Illawarra, well above the state average of 11.8 per cent, and criticised cuts to trade training centres and Better Futures employment programs."
  },
  {
   "slug": "speech-283262",
   "speaker": "Bob Baldwin",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-02-26",
   "stage_hint": null,
   "brief": "Criticised Labor's handling of the Tourle Street Bridge, which will now cost more than $100 million to add two lanes that would have cost $15 million if built originally. Highlighted RAAF Base Williamtown, which directly employs over 3,500 people and injects more than $280 million in salaries into the Hunter region, and said boat arrivals had fallen by more than 80 per cent since the election."
  },
  {
   "slug": "speech-283263",
   "speaker": "Michael Danby",
   "party": "Labor",
   "state": "federal",
   "date": "2014-02-26",
   "stage_hint": null,
