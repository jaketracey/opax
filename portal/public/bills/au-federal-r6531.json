 "speeches": [
  {
   "slug": "speech-391037",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-05-13",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (2020 Measures No. 2) Bill 2020 was moved, including measures to amend hybrid mismatch rules, streamline employer child support reporting via Single Touch Payroll, establish a deductible gift recipient category for men's sheds and women's sheds, provide $154 million for World Bank capital raising, allow the ATO to share JobKeeper information with the Fair Work Commission and Ombudsman, and add eight organisations (C.E.W. Bean Foundation, Governor Phillip International Scholarship Trust, High Resolves, Australian Academy of Law, Foundation Broken Hill, Motherless Daughters, Superannuation Consumers' Centre, and The Headstone Project (Tasmania)) to the DGR list."
  },
  {
   "slug": "speech-392972",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2020-06-17",
   "stage_hint": null,
   "brief": "The speaker argued that the House should agree to Senate amendments removing a corporate law discrimination that lets some large companies avoid transparency, noting the measure was meant to be temporary 25 years ago and that ASIC recommended its removal five years ago, while criticising the government for inaction as national debt reached $673 billion."
  }
