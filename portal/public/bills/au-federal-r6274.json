 "speeches": [
  {
   "slug": "speech-375096",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-02-14",
   "stage_hint": null,
   "brief": "The government introduced additional estimates appropriation bills totalling over $2.5 billion, including $626 million for Health (aged care royal commission and drought assistance), nearly $600 million for Home Affairs (national security, refugee aid, disaster preparedness), $100.5 million for Infrastructure, $89.8 million for Agriculture (both drought assistance), $60 million for the Attorney-General’s Department (aged care royal commission), $60 million for the Australian Sports Commission (community sport and Tokyo Olympics), and $14 million for the National Gallery."
  },
  {
   "slug": "speech-375097",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-02-14",
   "stage_hint": null,
   "brief": "The speaker moved the second reading of Appropriation Bill (No. 4) 2018‑2019, seeking approval for $752.9 million in additional appropriations. Key allocations include $82 million for security upgrades to Australia's overseas diplomatic network, $40.6 million for the Welfare Payment Infrastructure Transformation program, and $28 million for next generation visa processing systems."
  },
  {
   "slug": "speech-375670",
   "speaker": "Jim Chalmers",
   "party": "Labor",
   "state": "federal",
   "date": "2019-02-19",
   "stage_hint": null,
   "brief": "Labor will not block the appropriation bills but argues the government has mismanaged finances, citing net debt more than doubled to $360 billion, gross debt at $543.3 billion, and an $11 billion increase under Prime Minister Morrison."
  },
  {
   "slug": "speech-376484",
   "speaker": "Rob Mitchell",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-376568",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": "The appropriation bills provide funding for the Royal Commission into Aged Care Quality and Safety, drought assistance for farmers and farm communities, and security infrastructure enhancements for Australia's overseas diplomatic network."
  }
 ],
