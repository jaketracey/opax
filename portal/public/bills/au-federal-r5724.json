 "speeches": [
  {
   "slug": "speech-333868",
   "speaker": "Sussan Ley",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-09-14",
   "stage_hint": null,
   "brief": "The speaker moved the Narcotic Drugs (Licence Charges) Bill to recover regulatory costs from the new medicinal cannabis industry through direct fees and annual levies, with the scheme commencing on 30 October 2016."
  },
  {
   "slug": "speech-336797",
   "speaker": "Tony Zappia",
   "party": "Labor",
   "state": "federal",
   "date": "2016-11-07",
   "stage_hint": null,
   "brief": "Labor will not oppose the bills but criticises the government for needing to fix errors in the February medicinal cannabis legislation, including protecting law enforcement information, preventing licence transfers, and recovering regulatory costs, and notes that the government's shambolic processes have delayed the scheme."
  },
  {
   "slug": "speech-336798",
   "speaker": "David Gillespie",
   "party": "Nationals",
   "state": "federal",
   "date": "2016-11-07",
   "stage_hint": null,
   "brief": "The Narcotic Drugs Legislation Amendment Bill enhances the Medicinal Cannabis Scheme’s security by enabling sharing of law enforcement information to prevent criminal infiltration, while the Narcotic Drugs (Licence Charges) Bill introduces annual charges to fund risk-based inspections and ensure a level playing field."
  }
 ],
