 "divisions": [],
 "speeches": [
  {
   "slug": "speech-353899",
   "speaker": "Michael Keenan",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-09-13",
   "stage_hint": null,
   "brief": "The Investigation and Prosecution Measures Bill 2017 amends the Telecommunications (Interception and Access) Act 1979 and the Surveillance Devices Act 2004 to reflect the restructure of the New South Wales Independent Commission Against Corruption, replacing a single commissioner with a full-time chief commissioner and two part-time commissioners, and extends the functions of the Commonwealth Director of Public Prosecutions to the laws of Norfolk Island."
  },
  {
   "slug": "speech-359033",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2018-02-12",
   "stage_hint": null,
   "brief": "Labor supported the Investigation and Prosecution Measures Bill 2017, which updates Commonwealth references to the restructured New South Wales ICAC and extends the Commonwealth Director of Public Prosecutions' powers to Norfolk Island. The speaker also argued for a national integrity commission, pledging a Shorten Labor government would establish one to combat corruption in federal institutions."
  },
