 "speeches": [
  {
   "slug": "speech-361489",
   "speaker": "Ross Hart",
   "party": "Labor",
   "state": "federal",
   "date": "2018-03-27",
   "stage_hint": null,
   "brief": "The speaker argued that the Migration Agents Registration Application Charge Amendment Bill 2017 removes dual regulation for lawyers providing immigration advice, reduces red tape, and implements recommendations from the 2014 Kendall Review. The bill removes the requirement for practising lawyers to register as migration agents, extends the registration application timeframe, and makes the higher commercial registration charge the default, with a lower non-commercial charge available only for charitable organisations."
  },
  {
   "slug": "speech-361495",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-03-27",
   "stage_hint": null,
   "brief": "The government announced amendments to the Migration Agents Registration Application Charge Amendment Bill 2017, removing dual regulation of legal practitioners by the Migration Agents Registration Authority (MARA) and state law societies. A two-year transitional period, extendable to four years, will allow restricted legal practitioners to remain registered with MARA while obtaining unrestricted practising certificates."
  }
 ],
