 "speeches": [
  {
   "slug": "speech-827611",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2023-02-14",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (Consumer Data Right) Bill 2022 and the Public Interest Disclosure Amendment (Review) Bill 2022 were referred to the Federation Chamber for further consideration at the adjournment of the second reading debate on each bill, unless otherwise ordered."
  },
  {
   "slug": "speech-827612",
   "speaker": "Angus Taylor",
   "party": "Liberal",
   "state": "federal",
   "date": "2023-02-14",
   "stage_hint": null,
   "brief": "The speaker supported the Treasury Laws Amendment (Consumer Data Right) Bill 2022, which expands the consumer data right to include action-initiation reforms, but raised concerns about the pace of implementation and potential burdens on small businesses, urging the government to consult with businesses and consumers to avoid a botched rollout."
  },
  {
   "slug": "speech-827685",
   "speaker": "Zali Steggall",
   "party": "Independent",
   "state": "federal",
   "date": "2023-02-14",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (Consumer Data Right) Bill 2022 was supported across the chamber, expanding consumers’ ability to direct accredited parties to take actions such as switching providers or updating personal details. Coalition speakers called for a Senate committee inquiry and a dedicated minister for the digital economy, while Labor criticised the previous government’s record on digital infrastructure and noted the scheme had been left unfunded."
  }
 ],
