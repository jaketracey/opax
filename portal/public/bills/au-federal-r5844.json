 "speeches": [
  {
   "slug": "speech-345193",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2017-03-30",
   "stage_hint": null,
   "brief": "The ASIC Supervisory Cost Recovery Levy (Collection) Bill 2017 was introduced to implement an industry funding model requiring all ASIC-regulated entities to pay levies offsetting regulatory costs. Unpaid levies attract 20 per cent annual penalty interest, mandatory activity reporting is required with failure to report an offence, and dishonest reporting incurs a shortfall penalty of twice the levy avoided."
  }
 ],
