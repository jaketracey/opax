 "speeches": [
  {
   "slug": "speech-363297",
   "speaker": "Scott Morrison",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-05-24",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (APRA Governance) Bill 2018 permits the appointment of a second deputy chair to the Australian Prudential Regulation Authority to provide greater flexibility in governance and oversight of the financial sector. The government argued this change will enhance APRA’s ability to manage emerging issues and support ongoing reforms, including the banking executive accountability regime and stronger penalties for misconduct."
  },
  {
   "slug": "speech-365592",
   "speaker": "Matt Thistlethwaite",
   "party": "Labor",
   "state": "federal",
   "date": "2018-06-25",
   "stage_hint": null,
   "brief": "Labor will support the Treasury Laws Amendment (APRA Governance) Bill 2018, which allows the Governor-General to appoint a second deputy chair to the Australian Prudential Regulation Authority. The Turnbull government was criticised for opposing the banking royal commission and weakening financial regulation, and the need for a stronger, properly resourced regulator was emphasised."
  },
  {
   "slug": "speech-365593",
   "speaker": "Michael Sukkar",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-06-25",
   "stage_hint": null,
   "brief": "The Treasury Laws Amendment (APRA Governance) Bill 2018 was welcomed, allowing up to two deputy chairs at APRA to improve its effectiveness, flexibility, and oversight of the financial sector."
  }
 ],
