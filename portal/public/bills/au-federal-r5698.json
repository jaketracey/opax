 "speeches": [
  {
   "slug": "speech-333551",
   "speaker": "Catherine King",
   "party": "Labor",
   "state": "federal",
   "date": "2016-09-13",
   "stage_hint": null,
   "brief": "The speaker supported the Excise Tariff Amendment (Tobacco) Bill 2016, noting it was originally a Labor policy adopted by the government after initial opposition, and argued that tobacco excise increases reduce smoking rates—citing 15,000 deaths and $31.5 billion in health and economic costs annually, with projections of 320,000 smokers quitting and 40,000 teenagers deterred from starting. The speaker also criticised the government for previously dismissing the policy and for cutting the Indigenous smoking cessation program."
  }
