 "speeches": [
  {
   "slug": "speech-365598",
   "speaker": "Anne Aly",
   "party": "Labor",
   "state": "federal",
   "date": "2018-06-25",
   "stage_hint": null,
   "brief": "The bill extends the sunset date for control order, preventative detention order and declared area regimes to 7 September 2021. The government did not implement PJCIS and INSLM recommendations to repeal questioning and detention warrants and to exempt control order subjects from paying costs for variation applications."
  },
  {
   "slug": "speech-365599",
   "speaker": "Jason Wood",
   "party": "Liberal",
   "state": "federal",
   "date": "2018-06-25",
   "stage_hint": null,
   "brief": "The speaker argued for extending the control order sunset clause, raised concerns that police cannot question people under preventative detention orders (PDOs), and advocated for a national criminal intelligence database and community protection intervention orders to compel deradicalisation, citing around 500 persons of interest in Australia and examples such as Numan Haider and Abdul Nacer Benbrika."
  },
  {
   "slug": "speech-365600",
   "speaker": "Mark Coulton",
   "party": "Nationals",
   "state": "federal",
   "date": "2018-06-25",
   "stage_hint": null,
   "brief": "The bill extends the control order, preventive detention order, declared areas, and terrorism stop/search/seizure powers for three years until 7 September 2021, and continues ASIO’s questioning and detention powers for 12 months, while also increasing independent oversight of these counter-terrorism provisions."
  }
