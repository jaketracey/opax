 "speeches": [
  {
   "slug": "speech-393995",
   "speaker": "Christian Porter",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-08-27",
   "stage_hint": null,
   "brief": "The bill moves to amend Commonwealth legislation to enable the establishment of an independent National Commissioner for Defence and Veteran Suicide Prevention."
  },
  {
   "slug": "speech-396454",
   "speaker": "Shayne Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2020-10-21",
   "stage_hint": null,
   "brief": "The Labor MP moved an amendment criticising the government for failing to address high rates of suicide and mental health conditions among current and former ADF personnel, and for not establishing a full independent royal commission into veteran suicide, arguing the proposed National Commissioner lacks the independence, resources, and powers of a royal commission."
  },
  {
   "slug": "speech-396585",
   "speaker": "Trevor Evans",
   "party": "LNP",
   "state": "federal",
   "date": "2020-10-21",
   "stage_hint": null,
   "brief": "The government argued for establishing a National Commissioner for Defence and Veteran Suicide Prevention with powers equivalent to a royal commission, including the ability to compel evidence, hold public hearings, and monitor recommendations, and noted that over 90 submissions were received during public consultation."
  }
 ],
