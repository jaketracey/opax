 "speeches": [
  {
   "slug": "speech-822408",
   "speaker": "Jacinta Collins",
   "party": "Labor",
   "state": "federal",
   "date": "2013-03-13",
   "stage_hint": null,
   "brief": "The International Organisations (Privileges and Immunities) Amendment Bill 2013 was moved to bring the International Committee of the Red Cross and the International Criminal Court within the scope of the act, enabling regulations to confer privileges and immunities. The Not-for-profit Sector Freedom to Advocate Bill 2013 was proposed to prohibit and invalidate clauses in Commonwealth agreements that restrict not-for-profit entities from advocating on Commonwealth policy issues."
  },
