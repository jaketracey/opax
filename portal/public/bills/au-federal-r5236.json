  "attribution": "Written by a model from the explanatory memorandum; not the record",
  "describes_version": "original",
  "as_of": "2014-05-13",
  "sentences": [
   "This bill would authorise extra spending from the Consolidated Revenue Fund for the government's ongoing services.",
   "It provides additional money on top of what was already approved through earlier appropriation laws for the 2013-2014 financial year.",
   "The bill covers only ordinary annual services, as required by sections 53 and 54 of the Australian Constitution, with a separate bill for other appropriations."
  ],
  "changes": [
   "The bill would draw extra funds from the Consolidated Revenue Fund for ordinary annual services.",
   "It would supplement the appropriations already made in earlier acts for the 2013-2014 budget year.",
   "The bill separates ordinary annual service appropriations from other spending, as the Constitution requires."
  ],
  "affected": "The government and its portfolio agencies that receive the additional appropriations.",
