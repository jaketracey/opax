 "summary": {
  "version": 1,
  "basis": "em",
  "attribution": "Written by a model from the explanatory memorandum; not the record",
  "describes_version": "original",
  "as_of": "2024-11-20",
  "sentences": [
   "This bill would require large employers to set and report on measurable targets to improve gender equality in their workplaces.",
   "Employers with 500 or more employees would have to commit to, achieve or improve on targets against six gender equality indicators over three-year cycles.",
   "The Minister would set the categories and number of targets, which could be numeric or action-based, through a new instrument to the Act."
  ],
  "changes": [
   "Introduces a gender equality targets scheme for designated relevant employers.",
   "Requires employers with 500 or more employees to select and report on targets against the six gender equality indicators.",
   "Gives the Minister power to set target categories and rules via an instrument."
  ],
  "affected": "Employers with 500 or more employees, called designated relevant employers, in the private and Commonwealth sectors, including higher education institutions.",
