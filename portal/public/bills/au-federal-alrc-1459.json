   "brief": null
  },
  {
   "slug": "speech-784305",
   "speaker": "John Faulkner",
   "party": "Labor",
   "state": "federal",
   "date": "2008-03-17",
   "stage_hint": null,
   "brief": "The government introduced the Workplace Relations Amendment (Transition to Forward with Fairness) Bill 2008 to abolish Australian Workplace Agreements (AWAs) and replace them with Individual Transitional Employment Agreements (ITEAs) until 31 December 2009, while introducing a new no-disadvantage test and commencing award modernisation. The bill delivers on election commitments to create a fairer, simpler workplace relations system, with the government arguing the Australian people voted for this change."
  },
  {
   "slug": "speech-784366",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2008-03-18",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-784367",
   "speaker": "Alan Ferguson",
   "party": "Liberal",
   "state": "federal",
   "date": "2008-03-18",
   "stage_hint": null,
   "brief": "The Senate negatived Senator Fielding's amendment and agreed to the original question, passing the bill for a second reading."
  },
  {
   "slug": "speech-784368",
   "speaker": "John Hogg",
   "party": "PRES",
   "state": "federal",
   "date": "2008-03-18",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-784401",
   "speaker": "Steve Hutchins",
   "party": "Labor",
   "state": "federal",
   "date": "2008-03-18",
   "stage_hint": null,
   "brief": "The committee agreed to government amendments to the workplace relations bill, including technical corrections and protections for outworkers and long service leave, while rejecting amendments from the Australian Greens and Australian Democrats on pay equity, award coverage, and unfair dismissal."
  },
  {
