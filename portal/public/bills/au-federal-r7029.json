  {
   "slug": "speech-829850",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2023-05-09",
   "stage_hint": null,
   "brief": "The government introduced the 2022–23 additional estimates appropriation bills, seeking $5.5 billion in total, with allocations including $1.8 billion for Defence, over $1 billion for Social Services (mostly NDIS), nearly $1 billion for Employment and Workplace Relations (apprenticeship wage subsidy), close to $900 million for Health and Aged Care (vaccines, aged‑care reimbursements, COVID‑19 management), and over $235 million for Foreign Affairs and Trade (passport surge and Osaka World Expo pavilion)."
  },
  {
   "slug": "speech-829852",
   "speaker": "Stephen Jones",
   "party": "Labor",
   "state": "federal",
   "date": "2023-05-09",
   "stage_hint": null,
   "brief": "The bill seeks $560,000 from the Consolidated Revenue Fund for the Department of the House of Representatives to transition its IT systems to cloud-based solutions."
  }
 ],
