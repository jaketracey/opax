 "speeches": [
  {
   "slug": "speech-391029",
   "speaker": "Peter Dutton",
   "party": "LNP",
   "state": "federal",
   "date": "2020-05-13",
   "stage_hint": null,
   "brief": "The Australian Security Intelligence Organisation Amendment Bill 2020 was moved, which repeals ASIO’s existing questioning and detention warrant framework—removing detention powers while retaining and reforming compulsory questioning, extending it to espionage and foreign interference, lowering the minimum age for questioning minors to 14 with safeguards, and allowing the Attorney-General to issue warrants orally in emergencies. The bill also aligns ASIO’s approval process for non-intrusive tracking devices with law enforcement, allowing internal authorisation by a senior ASIO officer instead of requiring an Attorney-General warrant."
  },
  {
   "slug": "speech-400883",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2020-12-10",
   "stage_hint": null,
   "brief": "Labor supported the ASIO Amendment Bill 2020, arguing for the repeal of the never-used questioning and detention warrant power and the introduction of a revised compulsory questioning framework. The party moved an amendment to reinstate the \"Howard safeguard\" requiring an independent issuing authority for questioning warrants, which the government had removed."
  }
 ],
