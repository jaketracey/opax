 "speeches": [
  {
   "slug": "speech-302666",
   "speaker": "Michael Keenan",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-11-27",
   "stage_hint": null,
   "brief": "Introduced the Federal Courts Legislation Amendment Bill 2014 to bar appeals against minor procedural court decisions, clarify that police and court sheriffs may use reasonable force to execute arrest warrants for contempt or summary offences, and give the Federal Circuit Court jurisdiction to hear Commonwealth tenancy disputes as a more cost-effective forum."
  },
  {
   "slug": "speech-303573",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2014-12-02",
   "stage_hint": null,
   "brief": "Supported the Federal Courts Legislation Amendment Bill 2014, citing proposed jurisdiction over certain Commonwealth tenancy disputes, clarification of reasonable force when executing arrest warrants, limits on interlocutory appeals and other technical amendments, while seeking clarity on future court funding."
  },
  {
   "slug": "speech-303574",
   "speaker": "Michael Keenan",
   "party": "Liberal",
   "state": "federal",
   "date": "2014-12-02",
   "stage_hint": null,
   "brief": "Announced that the Federal Courts Legislation Amendment Bill 2014 would clarify federal court procedures, limit appeals from minor procedural decisions, permit reasonable force to execute certain arrest warrants, and give the Federal Circuit Court jurisdiction over certain Commonwealth tenancy disputes."
  }
 ],
