 "speeches": [
  {
   "slug": "speech-298666",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-10-01",
   "stage_hint": null,
   "brief": "Introduced the Albury-Wodonga Development Corporation (Abolition) Bill 2014, which winds up the corporation that ceased development activities in 2004, transferring its remaining assets to the Department of Finance no later than 1 July 2015."
  },
  {
   "slug": "speech-299994",
   "speaker": "Cathy McGowan",
   "party": "Independent",
   "state": "federal",
   "date": "2014-10-23",
   "stage_hint": null,
   "brief": "Reflected on the history of the Albury-Wodonga Development Corporation ahead of its abolition, noting it was instigated in 1973 through a tripartite agreement between the Commonwealth, New South Wales and Victoria, and recalled she was 21 years old when it was established, now speaking 40 years later as its remaining land passes back to the Commonwealth."
  },
  {
   "slug": "speech-299995",
   "speaker": "Michael McCormack",
   "party": "Nationals",
   "state": "federal",
   "date": "2014-10-23",
   "stage_hint": null,
   "brief": "Summed up debate on the Albury-Wodonga Development Corporation (Abolition) Bill, noting the wind-up timeline was set by the Howard government in 2005, that this bill forms part of a second reform phase abolishing a further 36 government bodies after an earlier reduction of 40, and that the corporation will be abolished by proclamation or, failing that, by 30 June 2015."
  }
 ],
