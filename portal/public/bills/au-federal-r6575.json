 "speeches": [
  {
   "slug": "speech-394004",
   "speaker": "Sussan Ley",
   "party": "Liberal",
   "state": "federal",
   "date": "2020-08-27",
   "stage_hint": null,
   "brief": "The Recycling and Waste Reduction Charges (Excise) Bill 2020 was moved for a second reading, forming part of the waste export ban charging legislative package. It imposes charges only when considered a duty of excise, with amounts and exemptions to be set in regulations, and does not itself set charge amounts or impose financial impacts."
  },
