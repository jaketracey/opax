 "speeches": [
  {
   "slug": "speech-338121",
   "speaker": "Michael Keenan",
   "party": "Liberal",
   "state": "federal",
   "date": "2016-11-22",
   "stage_hint": null,
   "brief": "The Counter-Terrorism Legislation Amendment Bill (No. 1) was introduced to strengthen Australia's national security laws, including allowing control orders for persons aged 14 and over, new monitoring powers, an offence of advocating genocide, and amendments to ASIO Act section 35P. The speech cited that around 110 Australians are fighting with terrorist groups in Syria and Iraq, at least 62 have been killed, 40 have returned, and 55 people have been charged in counter-terrorism operations since September 2014."
  },
  {
   "slug": "speech-338122",
   "speaker": "Mark Dreyfus",
   "party": "Labor",
   "state": "federal",
   "date": "2016-11-22",
   "stage_hint": null,
   "brief": "Labor supported the Counter-Terrorism Legislation Amendment Bill (No. 1) 2016 with amendments, including mandatory legal representation for minors subject to control orders and a special advocate scheme, while stressing that bipartisanship does not mean a blank cheque for the government."
  },
  {
   "slug": "speech-338123",
   "speaker": "Michael Danby",
   "party": "Labor",
   "state": "federal",
   "date": "2016-11-22",
   "stage_hint": null,
   "brief": "The speaker argued that the Counter-Terrorism Legislation Amendment Bill (No. 1) 2016 is appropriate and commended the bipartisan process of the Parliamentary Joint Committee on Intelligence and Security, including public hearings. He highlighted 20 amendments recommended by the committee to balance security with civil liberties, referenced Australian Daesh fighters and radicalised youth in Parramatta and Endeavour Hills, and criticised the Minister for Foreign Affairs for dismissing the committee's role."
  },
  {
   "slug": "speech-338124",
   "speaker": "Graham Perrett",
   "party": "Labor",
   "state": "federal",
   "date": "2016-11-22",
   "stage_hint": null,
   "brief": "The speaker supported the Counter-Terrorism Legislation Amendment Bill (No. 1) 2016, which extends control orders to minors as young as 14 and introduces a new offence of advocating genocide. The speaker noted that only six control orders have been issued since 2005 and that the bill includes 20 amendments recommended by the Parliamentary Joint Committee on Intelligence and Security, such as requiring a lawyer for young people and making their best interests a primary consideration."
  },
  {
   "slug": "speech-338125",
   "speaker": "Terri Butler",
   "party": "Labor",
   "state": "federal",
   "date": "2016-11-22",
   "stage_hint": null,
   "brief": "The member supported the Counter-Terrorism Legislation Amendment Bill (No. 1) 2016, arguing for the use of control orders to avoid detaining children and urging Australia to ratify the Optional Protocol to the Convention against Torture."
  }
 ],
