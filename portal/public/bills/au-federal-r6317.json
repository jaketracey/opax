 "speeches": [
  {
   "slug": "speech-376571",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": "This bill seeks approval for $4.8 billion in interim appropriations for non‑ordinary annual services, covering five‑twelfths of the estimated 2019‑20 spending, and must be passed before 1 July 2019 to ensure continued program and service delivery."
  },
  {
   "slug": "speech-376573",
   "speaker": "Matt Thistlethwaite",
   "party": "Labor",
   "state": "federal",
   "date": "2019-04-02",
   "stage_hint": null,
   "brief": "The coalition proposed supply bills for 2019-20, which Labor will not block. The speaker argued the government cut $715 million from Medicare, $5 billion from education, and gave $80 billion in tax cuts to high-income earners, while debt reached $534.2 billion, and Labor's Fair Go Action Plan includes making multinationals pay fair tax and restoring penalty rates."
  }
 ],
