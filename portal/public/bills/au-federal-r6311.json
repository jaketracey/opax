 "speeches": [
  {
   "slug": "speech-376235",
   "speaker": "Peter Dutton",
   "party": "LNP",
   "state": "federal",
   "date": "2019-02-21",
   "stage_hint": null,
   "brief": "The government introduced the Counter-Terrorism (Temporary Exclusion Orders) Bill 2019 to create a scheme allowing the minister to issue Temporary Exclusion Orders (TEOs) preventing Australians of counterterrorism interest from returning to Australia for up to two years, and to require a return permit with conditions for any return. Since 2014, 93 people have been charged with terrorism offences, 15 major counterterrorism disruptions have occurred, and around 100 Australians remain active in the Syria-Iraq conflict zone."
  }
 ],
