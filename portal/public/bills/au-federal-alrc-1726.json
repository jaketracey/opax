   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795134",
   "speaker": "Penny Wong",
   "party": "Labor",
   "state": "federal",
   "date": "2009-09-07",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795135",
   "speaker": "Penny Wong",
   "party": "Labor",
   "state": "federal",
   "date": "2009-09-07",
   "stage_hint": null,
   "brief": "The government introduced the Automotive Transformation Scheme Bill to replace the ACIS, providing $3.4 billion in capped and uncapped assistance from 2011 to 2020 with higher R&D support and environmental requirements, and the National Consumer Credit Protection Bill to create a single national licensing regime for credit providers and brokers, requiring responsible lending assessments and a three-tier dispute resolution system."
  },
  {
   "slug": "speech-795624",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-09-14",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795625",
   "speaker": "Eric Abetz",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-09-14",
   "stage_hint": null,
   "brief": "The speaker argued that the Automotive Transformation Scheme Bill 2009 and ACIS Administration Amendment Bill 2009 provide almost $3.5 billion in additional assistance to the Australian automotive industry from 2010 to 2020, criticising the government's luxury car tax increase and calling for greater transparency and accountability through amendments. The speaker noted that Ford and Holden recorded losses of $274 million and $70 million respectively, while Toyota posted a $124 million profit, and that Australian-made cars' market share had fallen to 16 per cent."
  },
  {
   "slug": "speech-795626",
   "speaker": "Eric Abetz",
   "party": "Liberal",
   "state": "federal",
   "date": "2009-09-14",
   "stage_hint": null,
   "brief": "Senator Abetz moved an amendment to the Automotive Transformation Scheme Bill requiring annual public reports on capped and uncapped assistance paid to each participant and industry progress, with the report tabled by 31 July. Arguing for transparency in public grants, citing $35 million to Toyota and $149 million to GM Holden, the amendment was agreed to."
  },
  {
   "slug": "speech-795627",
   "speaker": "Kim Carr",
   "party": "Labor",
   "state": "federal",
   "date": "2009-09-14",
   "stage_hint": null,
   "brief": "The speaker urged the government to accept the Senate's transparency amendment to avoid delay and not \"play politics\" with the industry, while the government indicated it would send the bill back to the House of Representatives."
  },
  {
   "slug": "speech-795659",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-09-15",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795660",
   "speaker": "Craig Emerson",
   "party": "Labor",
   "state": "federal",
   "date": "2009-09-15",
   "stage_hint": null,
   "brief": null
  },
  {
   "slug": "speech-795811",
   "speaker": null,
   "party": null,
   "state": "federal",
   "date": "2009-09-16",
   "stage_hint": null,
   "brief": "The House of Representatives disagreed to the Senate’s amendment to a bill and requested reconsideration. The Senate then ordered the message be considered in Committee of the Whole immediately."
  },
  {
   "slug": "speech-795812",
   "speaker": "Kim Carr",
   "party": "Labor",
   "state": "federal",
   "date": "2009-09-16",
   "stage_hint": null,
   "brief": "The government argued the Automotive Transformation Scheme provides sufficient transparency by disclosing total capped and uncapped assistance amounts and sector-level breakdowns, rejecting opposition demands to identify individual companies. Opposition Senator Abetz pushed for full public disclosure of all grants, arguing this is necessary for accountability and to sustain taxpayer support for the $6.2 billion, 10-year scheme."
  }
