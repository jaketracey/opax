 "speeches": [
  {
   "slug": "speech-338130",
   "speaker": "Tony Zappia",
   "party": "Labor",
   "state": "federal",
   "date": "2016-11-22",
   "stage_hint": null,
   "brief": "The bill establishes an eight‑member board to govern the Australian Organ and Tissue Donation and Transplantation Authority, abolishes the existing advisory council, and transfers responsibilities from the CEO to the board. The speaker noted the donation rate rose from 11.4 to 18.3 per million people between 2009 and 2015 but remains short of the 25 per million target, and that family consent increases from 52% to 91% when the deceased had registered their donation decision."
  },
  {
   "slug": "speech-338131",
   "speaker": "Rebekha Sharkie",
   "party": "Centre Alliance",
   "state": "federal",
   "date": "2016-11-22",
   "stage_hint": null,
   "brief": "The speaker supported the bill to establish a skills-based board for the Organ and Tissue Authority, and argued that the new board should prioritise introducing a nationwide opt-out organ donation system, citing Australia’s low rate of 16 deceased donors per million population and over 1,000 preventable deaths annually."
  }
 ],
