 "divisions": [],
 "speeches": [
  {
   "slug": "speech-305211",
   "speaker": "Kelly O'Dwyer",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-02-12",
   "stage_hint": null,
   "brief": "Moved the Appropriation Bill (No. 4) 2014-2015 seeking just under $241 million, including $90 million for drought recovery concessional loans in Queensland and New South Wales, just over $40 million for a temporary embassy in Ukraine, and just under $35 million for additional counter-terrorism activities."
  },
  {
   "slug": "speech-305212",
   "speaker": "Kelly O'Dwyer",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-02-12",
   "stage_hint": null,
   "brief": "Moved the Appropriation (Parliamentary Departments) Bill (No. 2) 2014-2015 seeking just under $114 million, primarily to fund upgrades to Parliament House's closed circuit television and access systems and additional parliamentary protective service staff."
  },
  {
   "slug": "speech-306174",
   "speaker": "Tony Burke",
   "party": "Labor",
   "state": "federal",
   "date": "2015-02-25",
   "stage_hint": null,
   "brief": "Reported that additional appropriation bills worth $1.7 billion reflect a mid-year budget update showing a $44 billion blow-out in the deficit, equivalent to $202 million a day, noted unemployment had risen to 6.4 per cent from 5.7 per cent at the last election, and said the bills incorporate a total $11.3 billion cut to foreign aid."
  },
  {
   "slug": "speech-306250",
   "speaker": "Scott Buchholz",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-02-26",
   "stage_hint": null,
   "brief": "Defended the government's economic record, citing 213,900 new jobs created last year, equivalent to 585 a day, and a Dun and Bradstreet survey finding the employment outlook the most positive in 10 years, and announced $90 million in additional drought concessional loans on top of the $280 million already committed under the 2014-15 drought package."
  },
  {
   "slug": "speech-306251",
   "speaker": "Nick Champion",
   "party": "Labor",
   "state": "federal",
   "date": "2015-02-26",
   "stage_hint": null,
   "brief": "Argued a return to a Labor government would restore fairness, describing the debate on the appropriation bills as ultimately a debate on a budget of broken promises, and pointed to the Liberal Party's election manifesto full of commitments it broke."
  },
  {
   "slug": "speech-306954",
   "speaker": "Pat Conroy",
   "party": "Labor",
   "state": "federal",
   "date": "2015-03-03",
   "stage_hint": null,
   "brief": "Criticised the government's $30 billion cut to school education funding and its plan to deregulate university fees, warning the University of Newcastle could lose almost $160 million over four years, and said youth unemployment in the Hunter region stands at 18 per cent, more than double the eight per cent regional rate."
  },
  {
   "slug": "speech-307478",
   "speaker": "Jenny Macklin",
   "party": "Labor",
   "state": "federal",
   "date": "2015-03-16",
   "stage_hint": null,
   "brief": "The speaker opposed the government's budget measures, including the GP tax, higher education deregulation, six-month Newstart waiting periods for young job seekers, $5.5 billion in family payment cuts, $270 million in community grants cuts, and pension indexation changes that would cut pensions by $80 a week by 2023-24, citing broken promises by the Prime Minister."
  }
 ],
