 "speeches": [
  {
   "slug": "speech-324684",
   "speaker": "Shayne Neumann",
   "party": "Labor",
   "state": "federal",
   "date": "2015-11-30",
   "stage_hint": null,
   "brief": "The Australian Institute of Aboriginal and Torres Strait Islander Studies Amendment Bill 2015 streamlines AIATSIS functions and amends council appointments to ensure a majority Indigenous membership. Labor supported the bill, noting AIATSIS holds the world’s largest collection of Indigenous Australian material, including 250 languages on UNESCO’s Memory of the World Register, and that the new AIATSIS Foundation will raise funds to extend its work."
  },
  {
   "slug": "speech-324685",
   "speaker": "Alex Hawke",
   "party": "Liberal",
   "state": "federal",
   "date": "2015-11-30",
   "stage_hint": null,
   "brief": "The Australian Institute of Aboriginal and Torres Strait Islander Studies Amendment Bill 2015 updates council appointment processes to prioritise skills and diversity while retaining an Indigenous majority, and reduces AIATSIS's functions from eight to five to focus on research, education, collection and preservation of its over one million items of cultural heritage. The measure continues the government's work with Professor Mick Dodson AM and the AIATSIS Council."
  }
 ],
