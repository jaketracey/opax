{
  "name": "opax-ask-no-answer-local", "main": "ask-no-answer-worker.ts",
  "compatibility_date": "2026-09-01", "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "../../private/ask-no-answer/public", "binding": "ASSETS", "run_worker_first": ["/api/*"]},
  "vars": {"INDEXNOW_ENABLED": "false", "INDEXNOW_DRY_RUN": "true", "COMMUNITY_ENABLED": "false", "VOICE_ENABLED": "false"}
}
