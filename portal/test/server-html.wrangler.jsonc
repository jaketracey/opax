{
  "name": "opax-server-html-fixtures",
  "main": "server-html-worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {"directory": "../public", "binding": "ASSETS", "run_worker_first": ["/*"]},
  "vars": {"CACHE_EPOCH": "server-html-fixtures", "COMMUNITY_ORIGIN": "https://opax.com.au", "REPORTS_ENABLED": "false", "INDEXNOW_ENABLED": "false", "INDEXNOW_DRY_RUN": "true", "DAILY_POST_ENABLED": "false", "VOICE_ENABLED": "false"}
}
