{
  "name": "opax-mobile",
  "private": true,
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --localhost",
    "ios": "bash scripts/run-ios.sh",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "bash scripts/jest-retry.sh --maxWorkers=2",
    "format": "prettier --write src scripts tests plugins app.config.ts *.js *.json .maestro README.md",
    "qa-advisories": "tsx scripts/qa-advisories.ts",
    "qa-static": "tsx scripts/qa-static.ts",
    "fixture": "tsx scripts/fixture-server.ts",
    "qa": "bash scripts/qa.sh"
  },
  "dependencies": {
    "expo": "57.0.26",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.20",
    "expo-file-system": "57.0.7",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.11",
    "expo-router": "57.0.24",
    "expo-status-bar": "57.0.1",
    "expo-symbols": "57.0.3",
    "expo-web-browser": "57.0.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "26.6.3",
    "@types/react": "19.2.4",
    "@types/react-test-renderer": "19.1.0",
    "@types/ws": "8.18.2",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "prettier": "3.8.5",
    "react-test-renderer": "19.2.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "ws": "8.22.0"
  },
  "engines": {
    "node": ">=24 <25",
    "npm": ">=11 <12"
  },
  "packageManager": "yarn@1.22.22+sha512.a6b2f7906b721bba3d67d4aff083df04dad64c399707841b7acf00f6b133b7ac24255f2652fa22ae3534329dc6180534e98d17432037ff6fd140556e2bb3137e"
