+// (?U): Unicode \s and \p classes, as in JavaScript's `u` flag.
+private fun opaxRegex(
+  pattern: String,
+  ignoreCase: Boolean = false,
+): Regex = Regex("(?U)$pattern", if (ignoreCase) setOf(RegexOption.IGNORE_CASE) else emptySet())
+
+private const val OPAX_NOT_AFTER_WORD = "(?<![\\p{L}\\p{N}_])"
+private const val OPAX_NOT_BEFORE_WORD = "(?![\\p{L}\\p{N}_])"
+private val opaxMessageRules: List<Pair<Regex, String>> =
+  listOf(
+    opaxRegex("([a-z][a-z0-9+.-]*://[^\\s?#\"'`<>]*)[?#][^\\s\"'`<>]*", ignoreCase = true) to "\$1",
+    opaxRegex("\\?[^\\s\"'`<>]*=[^\\s\"'`<>]*") to "",
+    opaxRegex("[\\p{L}\\p{N}._%+-]+@[\\p{L}\\p{N}-]+(?:\\.[\\p{L}\\p{N}-]+)+") to "[email]",
+    opaxRegex(
+      OPAX_NOT_AFTER_WORD +
+        "(?:\"[^\"\\n]*\"|“[^”\\n]*”|«[^»\\n]*»|`[^`\\n]*`" +
+        "|'(?:[^'\\n]|'(?=[\\p{L}\\p{N}_]))*'" + OPAX_NOT_BEFORE_WORD +
+        "|‘(?:[^’\\n]|’(?=[\\p{L}\\p{N}_]))*’" + OPAX_NOT_BEFORE_WORD + ")",
+    ) to "[redacted]",
+    opaxRegex(OPAX_NOT_AFTER_WORD + "[\"“«`'‘][^\\n]*") to "[redacted]",
+    opaxRegex("\\p{N}{4,}") to "#",
+    opaxRegex("\\s+") to " ",
+  )
+
+internal fun opaxScrubMessage(value: Any?): String? {
+  if (value !is String) return null
+  var text = value.take(opaxMessageInputMaxLength)
+  for ((rule, replacement) in opaxMessageRules) {
+    text = rule.replace(text, replacement)
+  }
+  val trimmed = text.trim()
+  val capped = StringBuilder()
+  var index = 0
+  var count = 0
+  while (index < trimmed.length && count < opaxMessageMaxLength) {
+    val codePoint = trimmed.codePointAt(index)
+    capped.appendCodePoint(codePoint)
+    index += Character.charCount(codePoint)
+    count++
+  }
+  return capped.toString().trim().ifEmpty { null }
+}
