+// `set` is the deprecated legacy `$set` field; it is cleared, never read.
+@Suppress("DEPRECATION")
+internal fun opaxScrubNativeEvent(event: PostHogEvent): PostHogEvent? {
+  if (event.event != "\$exception") return null
+  val raw = event.properties ?: return null
+  val exceptions = ((raw["\$exception_list"] as? List<*>) ?: emptyList<Any?>()).take(10).mapNotNull { opaxScrubException(it) }
+  if (exceptions.isEmpty()) return null
+  val clean = LinkedHashMap<String, Any>(opaxPick(opaxContextFields, raw))
+  clean["\$exception_list"] = exceptions
+  (raw["\$exception_level"] as? String)?.takeIf { it in opaxExceptionLevels }?.let { clean["\$exception_level"] = it }
+  opaxKeep(opaxExceptionSource, raw["\$exception_source"])?.let { clean["\$exception_source"] = it }
+  opaxKeep(opaxFingerprint, raw["\$exception_fingerprint"])?.let { clean["\$exception_fingerprint"] = it }
+  val images =
+    ((raw["\$debug_images"] as? List<*>) ?: emptyList<Any?>())
+      .take(500)
+      .map { opaxPick(opaxImageFields, it) }
+      .filter { it.isNotEmpty() }
+  if (images.isNotEmpty()) clean["\$debug_images"] = images
+  // A native crash report has no JS context: tag it as the app's own events are.
+  clean["platform"] = "android"
+  clean["app"] = "opax"
+  clean["environment"] = "production"
+  if (!clean.containsKey("app_version")) clean["\$app_version"]?.let { clean["app_version"] = it }
+  if (!clean.containsKey("app_build")) clean["\$app_build"]?.let { clean["app_build"] = it }
+  clean["\$process_person_profile"] = false
+  clean["\$is_identified"] = false
+  clean["\$geoip_disable"] = true
+  return event.copy(properties = clean, set = null)
