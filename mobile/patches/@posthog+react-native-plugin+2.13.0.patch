+private fun opaxScrubException(value: Any?): Map<String, Any>? {
+  val exception = value as? Map<*, *> ?: return null
+  val type = exception["type"] as? String ?: ""
+  val clean = LinkedHashMap<String, Any>()
+  clean["type"] = if (opaxExceptionType.matches(type) || type in opaxSwiftFatalTypes) type else "Error"
+  opaxScrubMessage(exception["value"])?.let { clean["value"] = it }
+  opaxKeep(OpaxField.Text(256), exception["module"])?.let { clean["module"] = it }
+  opaxKeep(OpaxField.Whole, exception["thread_id"])?.let { clean["thread_id"] = it }
+  val mechanism = opaxPick(opaxMechanismFields, exception["mechanism"])
+  if (mechanism.isNotEmpty()) clean["mechanism"] = mechanism
+  (exception["stacktrace"] as? Map<*, *>)?.let { stack ->
+    val frames =
+      ((stack["frames"] as? List<*>) ?: emptyList<Any?>())
+        .take(250)
+        .map { opaxPick(opaxFrameFields, it) }
+        .filter { it.isNotEmpty() }
+    clean["stacktrace"] = mapOf("type" to if (stack["type"] == "resolved") "resolved" else "raw", "frames" to frames)
+  }
+  return clean
+}
