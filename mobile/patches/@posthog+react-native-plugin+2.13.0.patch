+private sealed class OpaxField {
+  data class Text(val max: Int) : OpaxField()
+
+  data class Path(val max: Int) : OpaxField()
+
+  object Whole : OpaxField()
+
+  object Flag : OpaxField()
+
+  data class Token(val regex: Regex) : OpaxField()
+}
+
+private fun opaxKeep(
+  field: OpaxField,
+  value: Any?,
+): Any? =
+  when (field) {
+    is OpaxField.Text -> (value as? String)?.takeIf { it.isNotEmpty() && it.length <= field.max }
+    is OpaxField.Path ->
+      (value as? String)?.let { opaxKeep(OpaxField.Text(field.max), it.substringBefore('?').substringBefore('#')) }
+    OpaxField.Whole ->
+      when (value) {
+        is Int, is Long, is Short, is Byte -> (value as Number).toLong()
+        // Numbers from the JS bridge arrive as doubles.
+        is Double -> value.takeIf { it.isFinite() && it == Math.floor(it) && Math.abs(it) <= 9007199254740991.0 }?.toLong()
+        else -> null
+      }
+    OpaxField.Flag -> value as? Boolean
+    is OpaxField.Token -> (value as? String)?.takeIf { field.regex.matches(it) }
+  }
+
+private fun opaxPick(
+  fields: Map<String, OpaxField>,
+  value: Any?,
+): Map<String, Any> {
+  val source = value as? Map<*, *> ?: return emptyMap()
+  val clean = LinkedHashMap<String, Any>()
+  for ((key, field) in fields) {
+    clean[key] = opaxKeep(field, source[key]) ?: continue
+  }
+  return clean
+}
