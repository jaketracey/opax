+        let end = text.firstIndex { $0 == "?" || $0 == "#" } ?? text.endIndex
+        return opaxKeep(.text(max), String(text[..<end]))
+    case .integer:
+        return opaxWholeNumber(value).map { NSNumber(value: $0) }
+    case .flag:
+        guard let number = value as? NSNumber, CFGetTypeID(number) == CFBooleanGetTypeID() else { return nil }
+        return number.boolValue
+    case let .token(regex):
+        guard let text = value as? String, opaxMatches(regex, text) else { return nil }
+        return text
+    case let .oneOf(allowed):
+        guard let text = value as? String, allowed.contains(text) else { return nil }
+        return text
+    case .build:
+        let digits = opaxWholeNumber(value).map { String($0) } ?? value as? String
+        guard let digits, opaxMatches(opaxBuildDigits, digits) else { return nil }
+        return digits
+    }
