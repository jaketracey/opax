+// OPAX menu accessibility: UIKit exposes _UIButtonBarButton, not the UIMenu.
+// Match the public accessibility label after layout, without private selectors.
+#if RNS_IPHONE_OS_VERSION_AVAILABLE(26_0) && !TARGET_OS_TV
+static void RNSApplyMenuButtonAccessibilityIdentifier(UIView *view, UIBarButtonItem *item)
+{
+  if (view.isAccessibilityElement && [view.accessibilityLabel isEqualToString:item.accessibilityLabel]) {
+    view.accessibilityIdentifier = item.accessibilityIdentifier;
+    return;
+  }
+  for (UIView *subview in view.subviews) {
+    RNSApplyMenuButtonAccessibilityIdentifier(subview, item);
+  }
+}
