# Optional local QA hooks. Leave blank for direct portable commands.
OPAX_BUILD_GATE=
OPAX_SIM_GATE=
OPAX_PASTE_LOCK=
# Two-slot hosts only: the other slot's simulator UDIDs (whitespace-separated).
OPAX_SIM_ADMIT_IGNORE=
OPAX_CAPACITY_CMD=
OPAX_ALLOWED_UDIDS=
# Seconds to wait for capacity and the pasteboard lock together (default 7200).
OPAX_PASTE_WAIT_SECONDS=
