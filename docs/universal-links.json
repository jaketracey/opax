      }
    },
    {
      "/": "/connections",
      "opens": [
        "/connections",
        "/connection"
      ],
      "examples": {
        "/connections": "/(tabs)/(today)/connections",
        "/connections?entity=0123456789abcdef01234567": "/(tabs)/(today)/connection?id=0123456789abcdef01234567"
      }
    },
    {
      "/": "/explore",
      "opens": [
        "/explore",
        "/explore/[tool]"
      ],
      "examples": {
        "/explore": "/(tabs)/(today)/explore",
        "/explore?game=quiz": "/(tabs)/(today)/explore/quiz"
      }
    },
    {
      "/": "/declared",
      "opens": [
        "/declarations"
      ],
      "examples": {
        "/declared": "/(tabs)/(today)/declarations"
      }
    },
    {
      "/": "/expenses",
      "opens": [
        "/expense-glossary"
      ],
      "examples": {
        "/expenses": "/(tabs)/(today)/expense-glossary"
      }
    },
    {
      "/": "/about",
      "opens": [
        "/account/about"
      ],
      "examples": {
        "/about": "/account/about"
      }
    },
    {
      "/": "/methods",
      "opens": [
        "/account/methods"
      ],
      "examples": {
        "/methods": "/account/methods"
      }
    },
    {
      "/": "/stats",
      "opens": [
        "/account/coverage"
      ],
      "examples": {
        "/stats": "/account/coverage"
      }
    },
    {
      "/": "/vic-election-2026",
      "opens": [
        "/vic-election"
      ],
      "examples": {
        "/vic-election-2026": "/(tabs)/(today)/vic-election",
        "/vic-election-2026?place=Kew": "/(tabs)/(today)/vic-election?q=Kew"
      }
    },
    {
      "/": "/vic-election-2026/*",
      "opens": [
        "/vic-election/[district]"
      ],
      "examples": {
        "/vic-election-2026/albert-park": "/(tabs)/(today)/vic-election/albert-park"
      }
    }
  ]
}
