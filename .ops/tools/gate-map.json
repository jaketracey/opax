{
  "smoke": [
    "portal/test/donor-privacy.test.mjs",
    "portal/test/donor-publication.test.mjs",
    "portal/test/donor-deploy-build.test.mjs",
    "portal/test/donor-entity.test.mjs",
    "portal/test/donor-stored-response.test.mjs",
    "portal/test/privacy-placeholders.test.mjs",
    "portal/test/directory-render.test.mjs",
    "portal/test/community.test.mjs",
    "portal/test/analytics.test.mjs",
    "portal/test/posthog-proxy.test.mjs"
  ],
  "optionalSmoke": ["portal/test/donor-confidence.test.mjs", "portal/test/donor-provenance.test.mjs"],
  "smokePatterns": {
    "portal/test/donor-privacy.test.mjs": "^(?:the fixture individuals are withheld and the fixture organisation is not|anonymising keeps every donor group and its totals: duplicated source ids never merge|publication conserves graph money while folding uncertain identities|a campaigner route never repeats a requested name it cannot show|a question or search is never echoed into page metadata or a share card)$"
  },
  "smokeMinimum": {"portal/test/donor-privacy.test.mjs": 4},
  "fullBuildPatterns": ["^scripts/", "^portal/(?:src|public)/.*(?:donor|privacy|table-)", "^portal/public/.*\\.json$"],
  "builders": [
    {"pattern":"^docs/design/design-tokens\\.json$", "script":"build:tokens"},
    {"pattern":"^portal/analytics/", "script":"build:analytics"},
    {"pattern":"^portal/voice/", "script":"build:voice"},
    {"pattern":"^portal/grants-map/", "script":"build:grants-map"}
  ],
  "map": [
    {"pattern":"^portal/public/(?:style|tokens|ui-.*|nav|loader)\\.css$", "tests":["(?:design-tokens|ui-components|loader|header-search|directory-render|page-entry)\\.test"]},
    {"pattern":"^portal/public/(?:index|home|community)\\.html$", "tests":["(?:home-|page-entry|header-search|directory-render|seo-render|crawl-seo|privacy-placeholders)"]},
    {"pattern":"^portal/(?:package.*\\.json|tsconfig\\.json|wrangler\\.jsonc)$|^\\.ops/tools/|^\\.github/", "tests":["\\.test\\.mjs$"]},
    {"pattern":"^portal/(?:public|src)/.*(?:donor|privacy)|^scripts/(?:withhold_donor|build_donor|donor_|check_privacy)", "tests":["(?:donor|privacy|table-|money-|social-|indexnow)"]},
    {"pattern":"^portal/(?:public/.*\\.json|public/(?:search-catalog|crawl|hubs|growth)/)", "tests":["\\.test\\.mjs$"]},
    {"pattern":"^portal/(?:graph|grants-map|voice|analytics)/", "tests":["(?:map|graph|journey|voice|analytics|donor|grants)"]},
    {"pattern":"^scripts/.*(?:build_|stamp_|load_tables|photo_identity)", "tests":["(?:deploy|donor|publication|directory|photo|graph|growth|table|seo|grants|home|map|tokens)"]}
  ]
}
