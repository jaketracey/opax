# =============================================================================
# OPAX environment variables (data pipeline and knowledge-box tooling)
#
#   cp .env.example .env
#
# NEVER commit .env. The Worker's own secrets live in portal/.dev.vars (also
# ignored) and in Cloudflare; see portal/wrangler.toml for their names.
# =============================================================================

# --- Progress Agentic RAG knowledge box (parli/arag.py) ---------------------
# Used by parli/ingest/arag_sync.py, scripts/generate_reports.py,
# scripts/arag_enrich.py and the ask harness.
ARAG_ZONE=
ARAG_ACCOUNT=
ARAG_NUA_KEY=
ARAG_KB_ID=
ARAG_KB_TOKEN=

# --- Data source APIs -------------------------------------------------------

# TheyVoteForYou: federal divisions and per-member votes
# (parli/ingest/tvfy_refresh.py, parli/ingest/fetch_division_votes.py)
TVFY_API_KEY=

# OpenAustralia: Hansard downloads
OPENAUSTRALIA_API_KEY=

# Guardian: news articles (optional; falls back to the 'test' key)
GUARDIAN_API_KEY=

# --- Model keys --------------------------------------------------------------

# OpenRouter: bring-your-own-key generation and enrichment on the knowledge box
# (scripts/arag_byok_openrouter.py, scripts/arag_enrich.py). Use a spend-capped key.
OPENROUTER_API_KEY=

# Anthropic: donation and interests classification helpers
# (parli/ingest/classify_donations.py, parli/ingest/mp_interests.py)
ANTHROPIC_API_KEY=
